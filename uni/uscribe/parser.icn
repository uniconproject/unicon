#<p>
# Line-oriented parser: raw chapter text to a <tt>Document</tt> doctree
# (<tt>node.icn</tt>). Deliberately a restricted subset of RST-like syntax
# -- underline-style headings, blank-line-separated paragraphs,
# <tt>"- "</tt>/<tt>"* "</tt> bullet lists, and <tt>".. name:: arg"</tt>
# directives with an indented body -- rather than a full docutils
# reimplementation. Covers what Brian's book and the FRR docs actually
# use.
#</p>
#<p>
# <b>Author:</b> Jafar Al-Gharaibeh
#</p>
#<p>
# This file is in the <i>public domain</i>.
#</p>

package uscribe

import lang

# <p>
# Parse one chapter of RST-like source into a <tt>Document</tt> tree.
# Holds a <tt>DirectiveRegistry</tt> used when expanding
# <tt>".. name::"</tt> directives during <tt>parseBlocks()</tt>.
# </p>
class Parser : Object (registry)

    # <p>
    # Install the directive registry used by <tt>parseDirective()</tt>.
    # <[param r a <tt>DirectiveRegistry</tt> instance]>
    # </p>
    method setRegistry(r)
        registry := r
        return
    end

    # <p>
    # Parse one chapter file into a <tt>Document</tt>.
    # <[param path filesystem path to the chapter source]>
    # <[returns a <tt>Document</tt> instance]>
    # <[fails if <tt>path</tt> cannot be opened for reading]>
    # </p>
    method parseFile(path)
        local f, lines, ln, doc
        f := open(path, "r") | fail
        lines := []
        while ln := read(f) do put(lines, ln)
        close(f)

        doc := Document()
        doc.setSrcName(path)
        parseBlocks(self, lines, 1, *lines, doc, 0)
        return doc
    end

    initially
        /registry := DirectiveRegistry()
end

# <p>
# Core recursive-descent block parser. Consumes
# <tt>lines[i..limit]</tt> at nesting depth <tt>level</tt>
# (0 = document top level, matching <tt>Section</tt> level numbering
# in <tt>node.icn</tt>), attaching parsed <tt>Block</tt> nodes as
# children of <tt>container</tt>.
# <[param parser the owning <tt>Parser</tt> (for directive expansion)]>
# <[param lines list of source lines]>
# <[param i 1-based start index into <tt>lines</tt>]>
# <[param limit last index (inclusive) to consider]>
# <[param container parent <tt>Block</tt> to attach children to]>
# <[param level current section-nesting depth, used for heading level
#         bookkeeping and to decide when an underlined heading closes
#         the current section rather than opening a nested one -- see
#         <tt>headingLevelFor()</tt>]>
# <[returns the index just past the last line consumed]>
# </p>
procedure parseBlocks(parser, lines, i, limit, container, level)
    local blankRun, para, curSection, hLevel

    curSection := container
    while i <= limit do {
        # Skip blank lines between blocks.
        if isBlank(lines[i]) then {
            i +:= 1
            next
            }

        # Underline-style heading: a non-blank line followed by a line
        # of repeated punctuation at least as long as the title.
        if isHeadingAt(lines, i, limit) then {
            hLevel := headingLevelFor(lines[i+1][1])
            curSection := Section()
            curSection.setTitle(trim(lines[i], ' ', 0))
            curSection.setLevel(hLevel)
            container.addChild(curSection)
            i +:= 2
            next
            }

        # Directive: ".. name:: arg", body is every following line
        # indented at least as deep as the first non-blank body line.
        if isDirectiveLine(lines[i]) then {
            i := parseDirective(parser, lines, i, limit, curSection)
            next
            }

        # Bullet list: a run of consecutive "- "/"* " lines.
        if isBulletLine(lines[i]) then {
            i := parseBulletList(lines, i, limit, curSection)
            next
            }

        # Numbered list: "1. "/"1) "/"#. " items.
        if isEnumLine(lines[i]) then {
            i := parseEnumList(lines, i, limit, curSection)
            next
            }

        # Simple RST table (==== column separators).
        if isTableSepLine(lines[i]) then {
            i := parseSimpleTable(lines, i, limit, curSection)
            next
            }

        # Definition list: term line + immediately indented body.
        if isDefListAt(lines, i, limit) then {
            i := parseDefinitionList(lines, i, limit, curSection)
            next
            }

        # RST literal block: a line ending in "::" followed by an
        # indented block (optionally after a blank line).
        if isLiteralIntro(lines[i]) then {
            i := parseLiteralBlock(lines, i, limit, curSection)
            next
            }

        # Otherwise: an ordinary paragraph -- consume until the next
        # blank line, heading, directive, or list line.
        i := parseParagraph(lines, i, limit, curSection)
        }

    return i
end

# <p>
# Consume consecutive non-blank lines as one paragraph, stopping at a
# blank line, heading, directive, bullet, or literal introducer.
# Always advances at least one line so a too-short underline cannot
# leave <tt>i</tt> unchanged (that used to infinite-loop in
# <tt>parseBlocks</tt>).
# <[param lines list of source lines]>
# <[param i 1-based start index]>
# <[param limit last index (inclusive)]>
# <[param container parent to receive the new <tt>Paragraph</tt>]>
# <[returns the index just past the last line consumed]>
# </p>
procedure parseParagraph(lines, i, limit, container)
    local buf, para
    buf := []
    while i <= limit & not isBlank(lines[i]) &
          not isDirectiveLine(lines[i]) & not isBulletLine(lines[i]) &
          not isEnumLine(lines[i]) & not isTableSepLine(lines[i]) &
          not isLiteralIntro(lines[i]) &
          not isHeadingAt(lines, i, limit) do {
        put(buf, trim(lines[i]))
        i +:= 1
        }
    # Always make progress: a too-short underline must not leave i
    # unchanged (that used to infinite-loop in parseBlocks).
    if *buf = 0 & i <= limit then {
        put(buf, trim(lines[i]))
        i +:= 1
        }
    para := Paragraph()
    every put(para.getChildren(), !parseInline(joinLines(buf)))
    container.addChild(para)
    return i
end

# <p>
# RST <tt>"::"</tt> literal block. The introducer line may be just
# <tt>"::"</tt> or end with <tt>"::"</tt> (e.g. <tt>"Unicon::"</tt>).
# Following indented lines become a <tt>CodeBlock</tt> with common
# leading indent stripped; relative indent inside the block is
# preserved.
# <[param lines list of source lines]>
# <[param i index of the introducer line]>
# <[param limit last index (inclusive)]>
# <[param container parent to receive optional leading
#         <tt>Paragraph</tt> and/or <tt>CodeBlock</tt>]>
# <[returns the index just past the last line consumed]>
# </p>
procedure parseLiteralBlock(lines, i, limit, container)
    local text, body, cb, para, minInd, ln, stripped, j, n

    text := literalIntroText(trim(lines[i]))
    i +:= 1
    while i <= limit & isBlank(lines[i]) do
        i +:= 1

    body := []
    while i <= limit do {
        if isBlank(lines[i]) then {
            # Blank line inside the block only if more indented content follows.
            j := i + 1
            while j <= limit & isBlank(lines[j]) do
                j +:= 1
            if j <= limit & isIndented(lines[j]) then {
                put(body, "")
                i +:= 1
                next
                }
            break
            }
        if not isIndented(lines[i]) then
            break
        put(body, rtrimLiteralLine(lines[i]))
        i +:= 1
        }

    if *text > 0 then {
        para := Paragraph()
        every put(para.getChildren(), !parseInline(text))
        container.addChild(para)
        }

    if *body > 0 then {
        minInd := literalMinIndent(body)
        cb := CodeBlock()
        every ln := !body do {
            if *ln = 0 then
                cb.addLine("")
            else {
                stripped := ln
                n := minInd
                stripped ? {
                    every 1 to n do {
                        if any(' ') then move(1)
                        else break
                        }
                    stripped := "" || tab(0)
                    }
                cb.addLine(stripped)
                }
            }
        container.addChild(cb)
        }

    return i
end

# <p>
# True when <tt>s</tt> is an RST literal-block introducer: a non-empty
# line ending in <tt>"::"</tt> that is not a <tt>".. name::"</tt>
# directive.
# <[param s a source line]>
# <[fails if <tt>s</tt> is not a literal introducer]>
# </p>
procedure isLiteralIntro(s)
    local t
    t := trim(\s | "")
    if *t < 2 then fail
    # Do not treat ".. name::" directives as literal introducers.
    if isDirectiveLine(t) then fail
    return t[*t-1:0] == "::"
end

# <p>
# Text shown before the literal block. RST keeps one colon when
# <tt>"::"</tt> is glued to a word (<tt>"Unicon::"</tt> ->
# <tt>"Unicon:"</tt>); both colons are dropped when preceded by
# whitespace (<tt>"Unicon ::"</tt> -> <tt>"Unicon"</tt>). A lone
# <tt>"::"</tt> yields empty text.
# <[param s the introducer line (already right-trimmed)]>
# <[returns the paragraph text before the code block, or <tt>""</tt>]>
# </p>
procedure literalIntroText(s)
    local t
    t := trim(s)
    if t == "::" then
        return ""
    if *t >= 3 & t[*t-2] == " " & t[*t-1:0] == "::" then
        return trim(t[1:*t-1])   # drop " ::"
    # glued "::" -> keep one colon ("Unicon::" -> "Unicon:")
    return t[1:*t]
end

# <p>
# Right-trim a line inside a literal block (trailing spaces only).
# <[param s a literal-block body line]>
# <[returns <tt>s</tt> with trailing spaces removed]>
# </p>
procedure rtrimLiteralLine(s)
    return trim(s)
end

# <p>
# Smallest leading-space indent among non-empty lines in a literal
# body; used to strip the common indent from a <tt>CodeBlock</tt>.
# <[param body list of literal-block body lines]>
# <[returns the minimum indent count, or 0 if all lines are empty]>
# </p>
procedure literalMinIndent(body)
    local ln, n, minInd
    minInd := &null
    every ln := !body do {
        if *ln = 0 then next
        n := 0
        ln ? {
            while any(' ') do {
                move(1)
                n +:= 1
                }
            }
        if /minInd | n < minInd then
            minInd := n
        }
    return \minInd | 0
end

# <p>
# Parse a run of consecutive bullet lines (<tt>"- "</tt> /
# <tt>"* "</tt>), including indented continuation lines, into a
# <tt>BulletList</tt> of <tt>ListItem</tt>s.
# <[param lines list of source lines]>
# <[param i index of the first bullet line]>
# <[param limit last index (inclusive)]>
# <[param container parent to receive the new <tt>BulletList</tt>]>
# <[returns the index just past the last line consumed]>
# </p>
procedure parseBulletList(lines, i, limit, container)
    local blist, item, buf
    blist := BulletList()
    container.addChild(blist)
    while i <= limit & isBulletLine(lines[i]) do {
        buf := [stripBulletMarker(lines[i])]
        i +:= 1
        # Continuation lines: indented, non-blank, not a new bullet.
        while i <= limit & not isBlank(lines[i]) & not isBulletLine(lines[i]) &
              not isEnumLine(lines[i]) & isIndented(lines[i]) do {
            put(buf, trim(lines[i], ' ', 1))
            i +:= 1
            }
        item := ListItem()
        every put(item.getChildren(), !parseInline(joinLines(buf)))
        blist.addChild(item)
        }
    return i
end

# <p>
# Parse a run of consecutive numbered-list lines into an
# <tt>EnumList</tt> of <tt>ListItem</tt>s. The first item's number
# (when not <tt>"#"</tt>) becomes <tt>startAt</tt>.
# <[param lines list of source lines]>
# <[param i index of the first enum line]>
# <[param limit last index (inclusive)]>
# <[param container parent to receive the new <tt>EnumList</tt>]>
# <[returns the index just past the last line consumed]>
# </p>
procedure parseEnumList(lines, i, limit, container)
    local elist, item, buf, startAt
    elist := EnumList()
    startAt := enumStartNumber(lines[i])
    elist.setStartAt(startAt)
    container.addChild(elist)
    while i <= limit & isEnumLine(lines[i]) do {
        buf := [stripEnumMarker(lines[i])]
        i +:= 1
        while i <= limit & not isBlank(lines[i]) & not isEnumLine(lines[i]) &
              not isBulletLine(lines[i]) & isIndented(lines[i]) do {
            put(buf, trim(lines[i], ' ', 1))
            i +:= 1
            }
        item := ListItem()
        every put(item.getChildren(), !parseInline(joinLines(buf)))
        elist.addChild(item)
        }
    return i
end

# <p>
# Parse a <tt>".. name:: arg"</tt> directive and its indented body,
# expand it via <tt>parser.registry</tt>, and attach the result to
# <tt>container</tt>. If expansion fails, the raw
# <tt>RawDirective</tt> is attached instead.
# <[param parser the owning <tt>Parser</tt>]>
# <[param lines list of source lines]>
# <[param i index of the directive header line]>
# <[param limit last index (inclusive)]>
# <[param container parent for the expanded node(s)]>
# <[returns the index just past the last body line consumed]>
# </p>
procedure parseDirective(parser, lines, i, limit, container)
    local head, dname, arg, body, raw, expanded, indentCol, nSpaces, j

    head := lines[i]
    head ? {
        tab(match(".. "))
        dname := tab(find("::"))
        move(2)
        tab(many(' '))
        arg := trim(tab(0), ' ', 0)
        }
    i +:= 1
    body := []
    # Body indent comes from the first non-blank indented line (not a
    # fixed width). Later lines must be at least that deep; shallower
    # content ends the directive.
    indentCol := &null
    while i <= limit do {
        if isBlank(lines[i]) then {
            # Keep the blank only when more body content follows at
            # the established (or still-to-be-measured) indent.
            j := i + 1
            while j <= limit & isBlank(lines[j]) do
                j +:= 1
            if j > limit then
                break
            if not isIndented(lines[j]) then
                break
            if \indentCol & leadingSpaceCount(lines[j]) < indentCol then
                break
            put(body, "")
            i +:= 1
            next
            }
        if not isIndented(lines[i]) then
            break
        nSpaces := leadingSpaceCount(lines[i])
        if /indentCol then
            indentCol := nSpaces
        if nSpaces < indentCol then
            break
        put(body, stripIndent(lines[i], indentCol))
        i +:= 1
        }
    # Trim trailing blank lines collected as part of the body. pull()
    # removes from the back of the list; pop() (front-removal) would
    # silently trim the wrong end.
    while *body > 0 & body[-1] == "" do pull(body) | break

    raw := RawDirective()
    raw.setName(dname)
    raw.setArg(arg)
    raw.setBodyLines(body)

    expanded := parser.registry.expand(raw, container) | raw
    if type(expanded) == "list" then
        every container.addChild(!expanded)
    else
        container.addChild(expanded)

    return i
end

# <p>
# Line-classification and small string helpers used by the block
# parsers above.
# </p>

# <p>
# True when <tt>s</tt> is empty or contains only whitespace.
# <[param s a source line]>
# </p>
procedure isBlank(s)
    return trim(s, ' ', 0) == ""
end

# <p>
# True when <tt>lines[i]</tt> is a title and <tt>lines[i+1]</tt> is a
# long-enough underline.
# <[param lines list of source lines]>
# <[param i candidate title-line index]>
# <[param limit last index (inclusive)]>
# <[fails if there is no heading at <tt>i</tt>]>
# </p>
procedure isHeadingAt(lines, i, limit)
    return i < limit & isUnderline(lines[i+1]) &
           *lines[i+1] >= *trim(lines[i])
end

# <p>
# True when <tt>s</tt> is a non-empty line of repeated heading
# underline characters (<tt>=</tt>, <tt>-</tt>, <tt>~</tt>,
# <tt>^</tt>, or <tt>"</tt>).
# <[param s a source line]>
# <[fails if <tt>s</tt> is not an underline]>
# </p>
procedure isUnderline(s)
    local t
    /s := ""
    t := trim(s, ' ', 0)
    if *t = 0 then fail
    return t ? (tab(many('=-~^"')), pos(0))
end

# <p>
# Map an underline character to a 1-based section level
# (<tt>=</tt>=1, <tt>-</tt>=2, <tt>~</tt>=3, <tt>^</tt>=4; anything
# else defaults to 4).
# <[param ch the first character of an underline line]>
# <[returns an integer section level]>
# </p>
procedure headingLevelFor(ch)
    static order
    initial order := "=-~^"
    return (find(ch, order) | 4)
end

# <p>
# True when <tt>s</tt> looks like <tt>".. name:: ..."</tt>.
# <[param s a source line]>
# <[fails if <tt>s</tt> is not a directive header]>
# </p>
procedure isDirectiveLine(s)
    return s ? (=".. ", find("::"))
end

# <p>
# True when <tt>s</tt> is a bullet list item
# (<tt>"- "</tt> or <tt>"* "</tt>, optionally indented).
# <[param s a source line]>
# <[fails if <tt>s</tt> is not a bullet line]>
# </p>
procedure isBulletLine(s)
    return s ? ((tab(many(' ')) | &pos), tab(any('-*')), =" ")
end

# <p>
# Strip the leading bullet marker and surrounding spaces from a
# bullet line, returning the item text.
# <[param s a bullet line]>
# <[returns the item text after the marker]>
# </p>
procedure stripBulletMarker(s)
    s ? {
        tab(many(' ')) | &pos
        move(1)
        tab(many(' ')) | &pos
        return "" || tab(0)
        }
end

# <p>
# True when <tt>s</tt> is a numbered list item:
# <tt>"1. "</tt>, <tt>"1) "</tt>, or <tt>"#. "</tt> / <tt>"#) "</tt>
# (optionally indented).
# <[param s a source line]>
# <[fails if <tt>s</tt> is not an enum line]>
# </p>
procedure isEnumLine(s)
    return s ? ((tab(many(' ')) | &pos),
                (tab(many(&digits)) | ="#"),
                tab(any('.)')),
                =" ")
end

# <p>
# Strip the leading enum marker from a numbered-list line.
# <[param s an enum line]>
# <[returns the item text after the marker]>
# </p>
procedure stripEnumMarker(s)
    s ? {
        tab(many(' ')) | &pos
        (tab(many(&digits)) | move(1))
        move(1)
        tab(many(' ')) | &pos
        return "" || tab(0)
        }
end

# <p>
# Starting number for an enum line: the leading digits, or <tt>1</tt>
# when the marker is <tt>"#"</tt>.
# <[param s an enum line]>
# <[returns integer start value]>
# </p>
procedure enumStartNumber(s)
    local n
    s ? {
        tab(many(' ')) | &pos
        if ="#" then
            return 1
        n := integer(tab(many(&digits))) | return 1
        return n
        }
    return 1
end

# <p>
# True when <tt>s</tt> is a simple-table separator: only
# <tt>=</tt> and spaces, with at least one <tt>=</tt>.
# <[param s a source line]>
# <[fails if <tt>s</tt> is not a table separator]>
# </p>
procedure isTableSepLine(s)
    local t
    t := trim(\s | "", ' ', 0)
    if *t = 0 then fail
    if not find("=", t) then fail
    return t ? (tab(many('= ')), pos(0))
end

# <p>
# Column character spans from a separator line. Each run of
# <tt>=</tt> becomes <tt>[start, stop]</tt> (1-based inclusive).
# <[param sep a table separator line]>
# <[returns a list of <tt>[start, stop]</tt> pairs]>
# </p>
procedure tableColumnBounds(sep)
    local cols, start, i, c
    cols := []
    start := &null
    every i := 1 to *sep do {
        c := sep[i]
        if c == "=" then {
            if /start then
                start := i
            }
        else if \start then {
            put(cols, [start, i - 1])
            start := &null
            }
        }
    if \start then
        put(cols, [start, *sep])
    return cols
end

# <p>
# Split a table row line into cell strings using column bounds.
# <[param line a table data line]>
# <[param cols list of <tt>[start, stop]</tt> bounds]>
# <[returns a list of trimmed cell strings]>
# </p>
procedure splitTableRow(line, cols)
    local cells, b, piece, a, z
    cells := []
    /line := ""
    every b := !cols do {
        a := b[1]
        z := b[2]
        if a > *line then
            piece := ""
        else if z > *line then
            piece := line[a:0]
        else
            piece := line[a:z + 1]
        put(cells, trim(\piece | "", ' ', 0))
        }
    return cells
end

# <p>
# Build a <tt>TableRow</tt> from cell strings (inline-parsed).
# <[param cellStrs list of cell text strings]>
# <[param asHeader non-null to mark the row as a header]>
# <[returns a <tt>TableRow</tt>]>
# </p>
procedure mkTableRowFromCells(cellStrs, asHeader)
    local row, cell, text
    row := TableRow()
    if \asHeader then
        row.setHeader()
    every text := !cellStrs do {
        cell := TableCell()
        every put(cell.getChildren(), !parseInline(text))
        row.addChild(cell)
        }
    return row
end

# <p>
# Parse a simple RST table starting at a separator line:
# sep / header / sep / body… / sep.
# <[param lines list of source lines]>
# <[param i index of the opening separator]>
# <[param limit last index (inclusive)]>
# <[param container parent for the new <tt>TableNode</tt>]>
# <[returns the index just past the table]>
# </p>
procedure parseSimpleTable(lines, i, limit, container)
    local cols, tbl, headerCells, rowCells
    cols := tableColumnBounds(lines[i])
    if *cols = 0 then {
        # Not a usable separator; skip the line as a no-op advance.
        return i + 1
        }
    i +:= 1
    if i > limit | isBlank(lines[i]) | isTableSepLine(lines[i]) then
        return i
    headerCells := splitTableRow(lines[i], cols)
    i +:= 1
    if i > limit | not isTableSepLine(lines[i]) then
        return i
    i +:= 1
    tbl := TableNode()
    tbl.setHeaderRow(mkTableRowFromCells(headerCells, 1))
    while i <= limit & not isBlank(lines[i]) & not isTableSepLine(lines[i]) do {
        rowCells := splitTableRow(lines[i], cols)
        tbl.addChild(mkTableRowFromCells(rowCells, &null))
        i +:= 1
        }
    if i <= limit & isTableSepLine(lines[i]) then
        i +:= 1
    container.addChild(tbl)
    return i
end

# <p>
# True when <tt>lines[i]</tt> is a definition-list term: not indented,
# not another block starter, and the next line is indented body text.
# <[param lines list of source lines]>
# <[param i candidate term index]>
# <[param limit last index (inclusive)]>
# <[fails if this is not a definition-list start]>
# </p>
procedure isDefListAt(lines, i, limit)
    if i >= limit then fail
    if isBlank(lines[i]) then fail
    if leadingSpaceCount(lines[i]) > 0 then fail
    if isDirectiveLine(lines[i]) | isBulletLine(lines[i]) |
       isEnumLine(lines[i]) | isTableSepLine(lines[i]) |
       isLiteralIntro(lines[i]) | isHeadingAt(lines, i, limit) then
        fail
    return isIndented(lines[i + 1])
end

# <p>
# Parse one or more consecutive definition-list items into a
# <tt>DefinitionList</tt>.
# <[param lines list of source lines]>
# <[param i index of the first term]>
# <[param limit last index (inclusive)]>
# <[param container parent for the new list]>
# <[returns the index just past the list]>
# </p>
procedure parseDefinitionList(lines, i, limit, container)
    local dlist, item, term, body, para, indentCol
    dlist := DefinitionList()
    container.addChild(dlist)
    while i <= limit & isDefListAt(lines, i, limit) do {
        term := trim(lines[i], ' ', 0)
        i +:= 1
        indentCol := leadingSpaceCount(lines[i])
        body := []
        while i <= limit & not isBlank(lines[i]) &
              leadingSpaceCount(lines[i]) >= indentCol do {
            put(body, stripIndent(lines[i], indentCol))
            i +:= 1
            }
        # Optional blank lines inside a multi-paragraph definition:
        # keep reading while the next non-blank stays indented.
        while i <= limit & isBlank(lines[i]) do {
            if i < limit & leadingSpaceCount(lines[i + 1]) >= indentCol &
               not isBlank(lines[i + 1]) then {
                put(body, "")
                i +:= 1
                while i <= limit & not isBlank(lines[i]) &
                      leadingSpaceCount(lines[i]) >= indentCol do {
                    put(body, stripIndent(lines[i], indentCol))
                    i +:= 1
                    }
                }
            else
                break
            }
        item := DefinitionItem()
        item.setTerm(term)
        para := Paragraph()
        every put(para.getChildren(), !parseInline(joinLines(body)))
        item.addChild(para)
        dlist.addChild(item)
        # Skip a single blank between items.
        if i <= limit & isBlank(lines[i]) & i < limit &
           isDefListAt(lines, i + 1, limit) then
            i +:= 1
        }
    return i
end

# <p>
# True when <tt>s</tt> starts with one or more spaces and has
# non-space content afterward (used for directive bodies, list
# continuations, and literal blocks).
# <[param s a source line]>
# <[fails if <tt>s</tt> is not indented content]>
# </p>
procedure isIndented(s)
    s ? {
        tab(many(' ')) | fail
        if pos(0) then fail
        return
        }
end

# <p>
# Count leading space characters on <tt>s</tt> (tabs are not treated
# as spaces).
# <[param s a source line]>
# <[returns the leading-space count (0 if none)]>
# </p>
procedure leadingSpaceCount(s)
    local n
    n := 0
    /s := ""
    s ? {
        while any(' ') do {
            move(1)
            n +:= 1
            }
        }
    return n
end

# <p>
# Remove up to <tt>n</tt> leading spaces from <tt>s</tt>.
# <[param s a source line]>
# <[param n maximum number of spaces to strip]>
# <[returns the remainder of the line]>
# </p>
procedure stripIndent(s, n)
    local i
    s ? {
        every i := 1 to n do {
            if any(' ') then move(1)
            else break
            }
        return "" || tab(0)
        }
end

# <p>
# Join a list of lines into one string with single spaces between
# non-empty contributions (used when collapsing paragraph and list
# item wraps).
# <[param buf list of line strings]>
# <[returns a single space-joined string]>
# </p>
procedure joinLines(buf)
    local out, ln
    out := ""
    every ln := !buf do
        out ||:= (if *out > 0 then " " else "") || ln
    return out
end
