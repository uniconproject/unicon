procedure main()
   t := table()
   t["foo"] := 1
   t["bar"] := 2
   write(t["foo"], " ", t["bar"])
   write("foo" === "foo")
   write("foo" === "bar")
   s := set()
   insert(s, "x")
   insert(s, "y")
   write(*s)
   write(member(s, "x"))
   write(right("ab",5), "|", left("ab",5), "|", center("ab",5))
   write(reverse("hello"))
   write(map("HELLO"))
end
