procedure main()
   a := "café"
   b := "naïve"
   c := a || b
   write("*a=", *a, " *b=", *b, " *c=", *c)

   d := "café" || "hello"
   write("*d=", *d)

   e := "hello" || "café"
   write("*e=", *e)

   f := "café" || "naïve" || "résumé"
   write("*f=", *f)

   g := "" || "café"
   write("*g=", *g)
end
