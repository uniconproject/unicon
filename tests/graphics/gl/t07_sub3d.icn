link glsnap
procedure main()
   w := open("p","gl","bg=red","size=300,300") | stop("open: ",&errortext)
   Fg(w,"white"); DrawCube(w,0,0,-2,0.6); Refresh(w)
   c := Clone(w,"gl","bg=green","size=120,120","pos=10,10") | stop("clone3d: ",&errortext)
   Fg(c,"yellow"); DrawSphere(c,0,0,-2,0.5)
   snap(c,"t07_sub3d_child")
   snap(w,"t07_sub3d_parent")
end
