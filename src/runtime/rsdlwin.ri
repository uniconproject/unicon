int nativecolor(wbp w, char *s, long *r, long *g, long *b)
   {
   char key[64];
   int i, n = 0, lo, hi;
   unsigned long c;

   for (; *s && n < (int)sizeof(key) - 1; s++)
      if (!isspace(*s))
         key[n++] = tolower((unsigned char)*s);
   key[n] = '\0';

   if ((!strncmp(key, "gray", 4) || !strncmp(key, "grey", 4)) &&
       isdigit(key[4])) {
      int pct = atoi(key + 4);
      if (pct > 100) return 0;
      *r = *g = *b = (long)(pct * 65535L / 100);
      return 1;
      }

   lo = 0; hi = sizeof(xcolors) / sizeof(xcolors[0]) - 1;
   while (lo <= hi) {
      int cmp;
      i = (lo + hi) / 2;
      cmp = strcmp(key, xcolors[i].name);
      if (cmp == 0) {
         c = xcolors[i].rgb;
         if (w)
            sdl_lcolor(w, c, r, g, b);
         else {
            *r = ((c >> 16) & 255) * 257;
            *g = ((c >> 8) & 255) * 257;
            *b = (c & 255) * 257;
            }
         return 1;
         }
      if (cmp < 0) hi = i - 1; else lo = i + 1;
      }
   return 0;
   }

/*
 * ------------------------------------------------------------------
 * Images
 * ------------------------------------------------------------------
 */

/*
 * Draw a bi-level image.  The hex digits fill the rows right to left.
 */
int blimage(wbp w, int x, int y, int width, int height, int ch, unsigned char *s, word len)
   {
   unsigned int m, msk1, c, ix, iy;
   struct ucgc gc;
   STDLOCALS(w);

   gc = *stdgc;
   gc.op = UC_OP_COPY;

   m = width % 4;
   if (m == 0)
      msk1 = 8;
   else
      msk1 = 1 << (m - 1);              /* mask for first byte of row */

   ix = width;
   iy = 0;
   m = msk1;
   while (len--) {
      if (isxdigit(c = *s++)) {         /* if hexadecimal character */
         if (!isdigit(c))               /* fix bottom 4 bits if necessary */
            c += 9;
         while (m > 0) {                /* set (usually) 4 pixel values */
            --ix;
            if (c & m)
               uc_put_pixel(stdpix, &gc, x + ix, y + iy, (unsigned int)wc->fg);
            else if (ch != TCH1)        /* if zeroes aren't transparent */
               uc_put_pixel(stdpix, &gc, x + ix, y + iy, (unsigned int)wc->bg);
            m >>= 1;
            }
         if (ix == 0) {                 /* if end of row */
            ix = width;
            iy++;
            m = msk1;
            }
         else
            m = 8;
         }
      }
   if (ix > 0 && ch != TCH1)            /* pad final row if incomplete */
      while (ix < (unsigned int)width)
         uc_put_pixel(stdpix, &gc, x + ix++, y + iy, (unsigned int)wc->bg);
   return Succeeded;
   }

/*
 * Draw a character-per-pixel image (palette e) or, if e is NULL,
 * an image of 8-bit RGB triples.
 */
int strimage(wbp w, int x, int y, int width, int height,
             struct palentry *e, unsigned char *s, word len, int on_icon)
   {
   int c, v;
   unsigned int ix, iy;
   unsigned long carray[256];
   struct ucgc gc;
   STDLOCALS(w);

   if (on_icon) return 0;               /* no icon windows */
   gc = *stdgc;
   gc.op = UC_OP_COPY;

   if (e) {
      for (c = 0; c < 256; c++)
         if (e[c].used && e[c].valid)
            carray[c] = sdl_rgb(w, e[c].clr.red, e[c].clr.green,
                                e[c].clr.blue);

      /*
       * Read the image string and set the pixel values.
       */
      ix = iy = 0;
      while (len--) {
         c = *s++;
         v = e[c].valid;
         if (v)                         /* put char if valid */
            uc_put_pixel(stdpix, &gc, x + ix, y + iy, (unsigned int)carray[c]);
         if (v || e[c].transpt) {       /* advance if valid or transparent */
            if (++ix >= (unsigned int)width) {
               ix = 0;                  /* reset for new row */
               iy++;
               }
            }
         }
      if (ix > 0) {                     /* pad final row if incomplete */
         while (ix < (unsigned int)width)
            uc_put_pixel(stdpix, &gc, x + ix++, y + iy, (unsigned int)wc->bg);
         }
      }
   else {
      for (iy = 0; iy < (unsigned int)height; iy++)
         for (ix = 0; ix < (unsigned int)width; ix++) {
            unsigned int r = *s++, g = *s++, b = *s++;
            uc_put_pixel(stdpix, &gc, x + ix, y + iy, (r << 16) | (g << 8) | b);
            }
      }
   return 0;
   }

static int rgbcmp(const void *a, const void *b)
   {
   unsigned long x = *(const unsigned long *)a, y = *(const unsigned long *)b;
   return (x < y) ? -1 : (x > y);
   }

/*
 * getimstr(w, x, y, width, height, paltbl, data) -- get image as a string.
 *
 * Stores the specified subimage in data, one pixel per byte, and sets
 * entries in paltbl corresponding to the pixel values that were used.
 * With more than 256 colors, the image is mapped onto a 6x7x6 color cube.
 */
int getimstr(wbp w, int x, int y, int width, int height,
             struct palentry paltbl[DMAXCOLORS], unsigned char *data)
   {
   unsigned long *clist, px;
   int i, j, n = 0, cube = 0;
   struct ucanvas *c = w->window->pix;
   unsigned long bg = w->context->bg;

   if (c == NULL) return 0;
   clist = malloc(DMAXCOLORS * sizeof(unsigned long));
   if (clist == NULL) return 0;

   /* collect the distinct colors, up to 256 */
   for (j = 0; j < height && !cube; j++)
      for (i = 0; i < width; i++) {
         int k;
         px = (x+i < 0 || y+j < 0 || x+i >= c->width || y+j >= c->height) ?
            bg : uc_get_pixel(c, x + i, y + j);
         for (k = 0; k < n; k++)
            if (clist[k] == px) break;
         if (k == n) {
            if (n == DMAXCOLORS) { cube = 1; break; }
            clist[n++] = px;
            }
         }

   if (cube) {
      n = 0;
      for (i = 0; i < 6; i++)
         for (j = 0; j < 7; j++) {
            int k;
            for (k = 0; k < 6; k++)
               clist[n++] = ((unsigned long)(i * 51) << 16) |
                  ((unsigned long)(j * 255 / 6) << 8) | (unsigned long)(k * 51);
            }
      }
   else
      qsort(clist, n, sizeof(unsigned long), rgbcmp);

   for (j = 0; j < height; j++)
      for (i = 0; i < width; i++) {
         int k;
         px = (x+i < 0 || y+j < 0 || x+i >= c->width || y+j >= c->height) ?
            bg : uc_get_pixel(c, x + i, y + j);
         if (cube)
            k = (int)(((px >> 16) & 255) + 25) / 51 * 42 +
                (int)((((px >> 8) & 255) * 6 + 127) / 255) * 6 +
                (int)((px & 255) + 25) / 51;
         else {
            unsigned long *lp = bsearch(&px, clist, n, sizeof(unsigned long),
                                        rgbcmp);
            k = lp ? (int)(lp - clist) : 0;
            }
         *data++ = k;
         paltbl[k].used = 1;
         }

   for (i = 0; i < DMAXCOLORS && i < n; i++)
      if (paltbl[i].used) {
         sdl_lcolor(w, clist[i], &paltbl[i].clr.red, &paltbl[i].clr.green,
                    &paltbl[i].clr.blue);
         paltbl[i].valid = 1;
         }
   free(clist);
   return 1;
   }

/*
 * getimstr24 -- get an image as a string of RGB tuples.
 */
int getimstr24(wbp w, int xx, int yy, int width, int height, unsigned char *data)
   {
   int x, y;
   unsigned long px;
   struct ucanvas *c = w->window->pix;
   if (c == NULL) return 0;
   for (y = 0; y < height; y++)
      for (x = 0; x < width; x++) {
         px = uc_get_pixel(c, xx + x, yy + y);
         *data++ = (px >> 16) & 0xFF;
         *data++ = (px >> 8) & 0xFF;
         *data++ = px & 0xFF;
         }
   return 1;
   }

/*
 * X11 image files: XBM (X BitMap) and XPM (X PixMap).  The X11 backend
 * reads and writes them with Xlib and libXpm; here they are parsed and
 * written directly, with the same results.
 */
#define XIMG_MAXFILE (64L * 1024 * 1024)
#define XIMG_MAXSIDE 32767

/* the characters libXpm uses for pixels, in its order */
static char xpm_chars[] =
   " .XoO+@#$%&*=-;:>,<1234567890qwertyuipasdfghjklzxcvbnm"
   "MNBVCZASDFGHJKLPIUYTREWQ!~^/()_`'][{}|";

/*
 * Read a whole (text) file into a NUL-terminated buffer.
 */
static char *ximg_slurp(char *filename)
   {
   FILE *f = fopen(filename, "rb");
   char *buf;
   long n;

   if (f == NULL) return NULL;
   if (fseek(f, 0L, SEEK_END) != 0 || (n = ftell(f)) < 0 ||
       n > XIMG_MAXFILE || fseek(f, 0L, SEEK_SET) != 0 ||
       (buf = malloc(n + 1)) == NULL) {
      fclose(f);
      return NULL;
      }
   if ((long)fread(buf, 1, n, f) != n) {
      free(buf);
      fclose(f);
      return NULL;
      }
   fclose(f);
   buf[n] = '\0';
   return buf;
   }

static int ximg_hasext(char *s, char *ext)
   {
   int n = strlen(s), m = strlen(ext), i;
   if (n < m) return 0;
   for (i = 0; i < m; i++)
      if (tolower((unsigned char)s[n - m + i]) != ext[i]) return 0;
   return 1;
   }

/*
 * The C name for an image written to filename: its base name, up to the
 * first period for XBM, whole for XPM as libXpm does, made a C name.
 */
static void ximg_name(char *filename, char *name, int len, int whole)
   {
   char *s = filename, *p;
   int n = 0;

   for (p = filename; *p; p++)
      if (*p == '/' || *p == '\\') s = p + 1;
   for (; *s && (whole || *s != '.') && n < len - 1; s++)
      name[n++] = (isalnum((unsigned char)*s) || *s == '_') ? *s : '_';
   if (n == 0) name[n++] = 'x';
   name[n] = '\0';
   }

/*
 * Parse an XBM file: "#define name_width w", "#define name_height h",
 * then the bits, least significant bit first, each row padded to a
 * whole unit: bytes in the X11 format, 16-bit shorts in the X10 one.
 * Returns the bits as bytes, *rowbytes per row.
 */
static unsigned char *xbm_parse(char *s, int *width, int *height,
                                int *rowbytes)
   {
   char *p, *q, *end;
   long w = -1, h = -1, v;
   int x10 = 0, rb, n, i;
   unsigned char *bits;

   for (p = s; (p = strstr(p, "#define")) != NULL; p = q) {
      char *name;
      q = p + 7;
      while (*q == ' ' || *q == '\t') q++;
      name = q;
      while (*q && !isspace((unsigned char)*q)) q++;
      v = strtol(q, &end, 0);
      if (end == q) continue;
      if (q - name >= 6 && !strncmp(q - 6, "_width", 6)) w = v;
      else if (q - name >= 7 && !strncmp(q - 7, "_height", 7)) h = v;
      q = end;
      }
   if (w <= 0 || h <= 0 || w > XIMG_MAXSIDE || h > XIMG_MAXSIDE)
      return NULL;

   if ((p = strstr(s, "_bits")) == NULL) return NULL;
   for (q = p; q > s && q[-1] != '\n'; q--)
      ;
   for (; q < p; q++)
      if (!strncmp(q, "short", 5)) x10 = 1;
   if ((p = strchr(p, '{')) == NULL) return NULL;
   p++;

   rb = x10 ? (int)((w + 15) / 16) * 2 : (int)((w + 7) / 8);
   n = rb * (int)h;
   if ((bits = calloc(n, 1)) == NULL) return NULL;
   for (i = 0; i < n; ) {
      while (*p && (isspace((unsigned char)*p) || *p == ','))
         p++;
      if (*p == '}' || *p == '\0') break;
      v = strtol(p, &end, 0);
      if (end == p) {
         free(bits);
         return NULL;
         }
      p = end;
      bits[i++] = v & 0xFF;
      if (x10 && i < n) bits[i++] = (v >> 8) & 0xFF;
      }
   if (i < n) {                         /* too few bits */
      free(bits);
      return NULL;
      }
   *width = w;
   *height = h;
   *rowbytes = rb;
   return bits;
   }

/*
 * The strings of an XPM file, in order: the quoted strings of an XPM3
 * file (comments skipped), or the lines of an XPM2 one.  The strings are
 * terminated in place.
 */
static char **xpm_strings(char *s, int *count)
   {
   char **v = NULL, **nv;
   int n = 0, max = 0, xpm2;
   char *p = s;

   while (isspace((unsigned char)*p)) p++;
   xpm2 = !strncmp(p, "! XPM2", 6);
   if (xpm2) {
      p = strchr(p, '\n');
      if (p) p++;
      }
   while (p && *p) {
      char *str;
      if (xpm2) {
         str = p;
         p = strchr(p, '\n');
         if (p) *p++ = '\0';
         if (*str && str[strlen(str) - 1] == '\r')
            str[strlen(str) - 1] = '\0';
         }
      else if (p[0] == '/' && p[1] == '*') {
         p = strstr(p + 2, "*/");
         if (p) p += 2;
         continue;
         }
      else if (*p == '"') {
         str = ++p;
         p = strchr(p, '"');
         if (p == NULL) break;
         *p++ = '\0';
         }
      else {
         p++;
         continue;
         }
      if (n == max) {
         max = max ? 2 * max : 64;
         nv = realloc(v, max * sizeof(char *));
         if (nv == NULL) {
            free(v);
            return NULL;
            }
         v = nv;
         }
      v[n++] = str;
      }
   *count = n;
   return v;
   }

/*
 * An XPM color value: #rgb (1 to 4 hex digits per channel), an X11
 * color name, or None (transparent, returned as -1).  Fails on anything
 * else, as libXpm does for colors it cannot find.
 */
static int xpm_color(char *s, long *rgb)
   {
   char key[64];
   int n = 0, i, lo, hi;

   if (*s == '#') {
      int len = strlen(++s), k = len / 3;
      unsigned long c[3];
      if (len == 0 || len % 3 || k > 4) return 0;
      for (i = 0; i < len; i++)
         if (!isxdigit((unsigned char)s[i])) return 0;
      for (i = 0; i < 3; i++) {
         char d[5];
         strncpy(d, s + i * k, k);
         d[k] = '\0';
         /* as XParseColor: k digits are the top 4k bits of 16 */
         c[i] = (strtoul(d, NULL, 16) << (16 - 4 * k)) >> 8;
         }
      *rgb = (long)((c[0] << 16) | (c[1] << 8) | c[2]);
      return 1;
      }

   for (; *s && n < (int)sizeof(key) - 1; s++)
      if (!isspace((unsigned char)*s))
         key[n++] = tolower((unsigned char)*s);
   key[n] = '\0';
   if (!strcmp(key, "none")) {
      *rgb = -1;
      return 1;
      }
   if ((!strncmp(key, "gray", 4) || !strncmp(key, "grey", 4)) &&
       isdigit((unsigned char)key[4])) {
      int pct = atoi(key + 4);
      long g;
      if (pct > 100) return 0;
      g = (long)(pct * 2.55 + 0.49);    /* the values in X11's rgb.txt */
      *rgb = (g << 16) | (g << 8) | g;
      return 1;
      }
   lo = 0;
   hi = sizeof(xcolors) / sizeof(xcolors[0]) - 1;
   while (lo <= hi) {
      int cmp;
      i = (lo + hi) / 2;
      cmp = strcmp(key, xcolors[i].name);
      if (cmp == 0) {
         *rgb = (long)xcolors[i].rgb;
         return 1;
         }
      if (cmp < 0) hi = i - 1;
      else lo = i + 1;
      }
   return 0;
   }

/*
 * Pick the color of an XPM color line, after its pixel characters:
 * the "c" (color) value, else "g", "g4" or "m", as libXpm does for a
 * color display.
 */
static int xpm_colorline(char *s, long *rgb)
   {
   static char *keys[] = { "c", "g", "g4", "m" };
   char *val[4], buf[256], *p, *tok[64];
   int ntok = 0, i, k, j;

   strncpy(buf, s, sizeof(buf) - 1);
   buf[sizeof(buf) - 1] = '\0';
   for (p = buf; *p && ntok < 64; ) {
      while (*p == ' ' || *p == '\t') p++;
      if (*p == '\0') break;
      tok[ntok++] = p;
      while (*p && *p != ' ' && *p != '\t') p++;
      if (*p) *p++ = '\0';
      }

   for (k = 0; k < 4; k++) val[k] = NULL;
   for (i = 0; i < ntok; i++) {
      int key = -1;
      if (!strcmp(tok[i], "s")) key = 4;
      for (k = 0; k < 4; k++)
         if (!strcmp(tok[i], keys[k])) key = k;
      if (key < 0) continue;
      /* the value runs to the next key: X11 names may have spaces */
      for (j = i + 1; j < ntok; j++) {
         int iskey = !strcmp(tok[j], "s");
         for (k = 0; k < 4; k++)
            if (!strcmp(tok[j], keys[k])) iskey = 1;
         if (iskey) break;
         if (j > i + 1)                 /* rejoin the words */
            tok[j - 1][strlen(tok[j - 1])] = ' ';
         }
      if (key < 4 && j > i + 1) val[key] = tok[i + 1];
      i = j - 1;
      }
   for (k = 0; k < 4; k++)
      if (val[k]) return xpm_color(val[k], rgb);
   return 0;
   }

static int xpm_cpp;                     /* for xpm_keycmp() */

static int xpm_keycmp(const void *a, const void *b)
   {
   return strncmp(*(char * const *)a, *(char * const *)b, xpm_cpp);
   }

/*
 * Load an XBM or XPM file as width x height pixels (0x00RRGGBB, or
 * XIMG_CLEAR): XBM 1 bits in fg and 0 bits in bg, XPM pixels in their
 * own colors.  The format is guessed from the name, else as X11 does.
 */
static unsigned int *ximg_load(char *filename, unsigned int fg,
                               unsigned int bg, int *width, int *height)
   {
   char *s, **str = NULL, **keys = NULL;
   long *rgb = NULL;
   unsigned int *px = NULL;
   int i, j, w = 0, h = 0, isxbm, ok = 0;

   if ((s = ximg_slurp(filename)) == NULL) return NULL;
   if (ximg_hasext(filename, ".xbm"))
      isxbm = 1;
   else if (ximg_hasext(filename, ".xpm"))
      isxbm = 0;
   else
      isxbm = (strstr(s, "XPM") == NULL);

   if (isxbm) {
      int rb;
      unsigned char *bits = xbm_parse(s, &w, &h, &rb);
      if (bits && (px = malloc((long)w * h * sizeof(unsigned int)))) {
         for (j = 0; j < h; j++)
            for (i = 0; i < w; i++)
               px[(long)j * w + i] =
                  ((bits[j * rb + i / 8] >> (i & 7)) & 1) ? fg : bg;
         ok = 1;
         }
      free(bits);
      }
   else {
      int n, ncolors, cpp, tbl[256];
      if ((str = xpm_strings(s, &n)) == NULL || n < 1 ||
          sscanf(str[0], "%d %d %d %d", &w, &h, &ncolors, &cpp) != 4 ||
          w <= 0 || h <= 0 || w > XIMG_MAXSIDE || h > XIMG_MAXSIDE ||
          ncolors <= 0 || cpp <= 0 || cpp > 8 || n - 1 - h < ncolors)
         goto done;
      if ((rgb = malloc(ncolors * sizeof(long))) == NULL ||
          (keys = malloc(ncolors * sizeof(char *))) == NULL ||
          (px = malloc((long)w * h * sizeof(unsigned int))) == NULL)
         goto done;
      for (i = 0; i < ncolors; i++) {
         keys[i] = str[1 + i];
         if ((int)strlen(keys[i]) < cpp) goto done;
         }
      /* sort the color lines by their pixel characters */
      xpm_cpp = cpp;
      qsort(keys, ncolors, sizeof(char *), xpm_keycmp);
      for (i = 0; i < ncolors; i++)
         if (!xpm_colorline(keys[i] + cpp, &rgb[i])) goto done;
      if (cpp == 1) {
         for (i = 0; i < 256; i++) tbl[i] = -1;
         for (i = ncolors - 1; i >= 0; i--)
            tbl[(unsigned char)keys[i][0]] = i;
         }
      for (j = 0; j < h; j++) {
         char *row = str[1 + ncolors + j];
         if ((long)strlen(row) < (long)w * cpp) goto done;
         for (i = 0; i < w; i++) {
            char *p = row + (long)i * cpp, **k;
            int c;
            if (cpp == 1)
               c = tbl[(unsigned char)*p];
            else {
               k = bsearch(&p, keys, ncolors, sizeof(char *), xpm_keycmp);
               c = k ? (int)(k - keys) : -1;
               }
            if (c < 0) goto done;       /* a pixel with no color */
            px[(long)j * w + i] =
               rgb[c] < 0 ? XIMG_CLEAR : (unsigned int)rgb[c];
            }
         }
      ok = 1;
      }
done:
   free(rgb);
   free(keys);
   free(str);
   free(s);
   if (!ok) {
      free(px);
      return NULL;
      }
   *width = w;
   *height = h;
   return px;
   }

/*
 * Draw an XBM or XPM file at x, y, with drawing op copy; transparent
 * XPM pixels leave the window alone.
 */
int readimage(wbp w, char *filename, int x, int y, int *status)
   {
   int i, j, width, height;
   unsigned int *px;
   struct ucgc gc;
   STDLOCALS(w);

   gc = *stdgc;
   gc.op = UC_OP_COPY;
   px = ximg_load(filename, (unsigned int)wc->fg, (unsigned int)wc->bg,
                  &width, &height);
   if (px == NULL) return Failed;
   for (j = 0; j < height; j++)
      for (i = 0; i < width; i++) {
         unsigned int c = px[(long)j * width + i];
         if (c != XIMG_CLEAR)
            uc_put_pixel(stdpix, &gc, x + i, y + j, c);
         }
   free(px);
   *status = 0;
   return Succeeded;
   }

/*
 * image= with an XBM or XPM file: the window starts out as the image,
 * at its size.
 */
int setimage(wbp w, char *val)
   {
   wsp ws = w->window;
   wcp wc = w->context;
   struct ucgc gc;
   struct ucanvas *c;
   unsigned int *px;
   int i, j, width, height;

   uc_gc_init(&gc);
   gc.fg = (unsigned int)wc->fg;
   gc.bg = (unsigned int)wc->bg;
   px = ximg_load(val, gc.fg, gc.bg, &width, &height);
   if (px == NULL) return Failed;
   if ((c = uc_canvas_new(width, height, gc.bg)) == NULL) {
      free(px);
      return Failed;
      }
   for (j = 0; j < height; j++)
      for (i = 0; i < width; i++)
         if (px[(long)j * width + i] != XIMG_CLEAR)
            uc_put_pixel(c, &gc, i, j, px[(long)j * width + i]);
   free(px);
   if (ws->initialPix) uc_canvas_free(ws->initialPix);
   ws->initialPix = c;
   ws->width = width;
   ws->height = height;
   return Succeeded;
   }

static int rgbcmp32(const void *a, const void *b)
   {
   unsigned int x = *(const unsigned int *)a, y = *(const unsigned int *)b;
   return (x < y) ? -1 : (x > y);
   }

/*
 * The pixel characters for color i of an XPM file with cpp per pixel.
 */
static void xpm_key(unsigned int i, unsigned int cpp, unsigned int base,
                    char *key)
   {
   unsigned int k;
   for (k = 0; k < cpp; k++) {
      key[k] = xpm_chars[i % base];
      i /= base;
      }
   key[cpp] = '\0';
   }

/*
 * Write a window region as XBM (dark pixels as 1 bits, as from a black
 * on white window) or as XPM; other formats are left to the generic code.
 */
int dumpimage(wbp w, char *filename, unsigned int x, unsigned int y,
              unsigned int width, unsigned int height)
   {
   struct ucanvas *c = w->window->pix;
   char name[256];
   unsigned int i, j;
   FILE *f;

   if (ximg_hasext(filename, ".xpm.z"))
      return Failed;                    /* compressed XPM: no */
   if (!ximg_hasext(filename, ".xbm") && !ximg_hasext(filename, ".xpm"))
      return NoCvt;
   if (c == NULL) return Failed;
   ximg_name(filename, name, sizeof(name), ximg_hasext(filename, ".xpm"));
   if ((f = fopen(filename, "w")) == NULL) return Failed;

   if (ximg_hasext(filename, ".xbm")) {
      unsigned int rb = (width + 7) / 8, n = 0;
      fprintf(f, "#define %s_width %u\n#define %s_height %u\n",
              name, width, name, height);
      fprintf(f, "static unsigned char %s_bits[] = {", name);
      for (j = 0; j < height; j++)
         for (i = 0; i < rb; i++) {
            unsigned int k, byte = 0;
            for (k = 0; k < 8 && i * 8 + k < width; k++) {
               unsigned int px = uc_get_pixel(c, x + i * 8 + k, y + j);
               long lum = 299L * ((px >> 16) & 0xFF) + 587L * ((px >> 8) & 0xFF)
                          + 114L * (px & 0xFF);
               if (lum < 128000L) byte |= 1 << k;
               }
            fprintf(f, "%s%s0x%02x", n ? "," : "", (n % 12) ? " " : "\n   ",
                    byte);
            n++;
            }
      fprintf(f, "};\n");
      }
   else {
      unsigned int *px, *pal, npix = width * height, ncolors = 0, cpp = 1;
      unsigned int base = strlen(xpm_chars), lim = base;
      char key[8];

      px = malloc((npix ? npix : 1) * sizeof(unsigned int));
      pal = malloc((npix ? npix : 1) * sizeof(unsigned int));
      if (px == NULL || pal == NULL) {
         free(px);
         free(pal);
         fclose(f);
         return Failed;
         }
      for (j = 0; j < height; j++)
         for (i = 0; i < width; i++)
            px[j * width + i] = pal[j * width + i] = uc_get_pixel(c, x + i, y + j);
      qsort(pal, npix, sizeof(unsigned int), rgbcmp32);
      for (i = 0; i < npix; i++)
         if (ncolors == 0 || pal[ncolors - 1] != pal[i])
            pal[ncolors++] = pal[i];
      while (lim < ncolors) {
         lim *= base;
         cpp++;
         }

      fprintf(f, "/* XPM */\nstatic char *%s[] = {\n", name);
      fprintf(f, "\"%u %u %u %u\",\n", width, height, ncolors, cpp);
      for (i = 0; i < ncolors; i++) {
         xpm_key(i, cpp, base, key);
         fprintf(f, "\"%s c #%06X\",\n", key, pal[i] & 0xFFFFFF);
         }
      for (j = 0; j < height; j++) {
         fputc('"', f);
         for (i = 0; i < width; i++) {
            unsigned int *e = bsearch(&px[j * width + i], pal, ncolors,
                                      sizeof(unsigned int), rgbcmp32);
            xpm_key((unsigned int)(e - pal), cpp, base, key);
            fputs(key, f);
            }
         fprintf(f, "\"%s\n", j + 1 < height ? "," : "");
         }
      fprintf(f, "};\n");
      free(px);
      free(pal);
      }
   if (fclose(f) != 0) return Failed;
   return Succeeded;
   }

/*
 * Pixels are read straight from the canvas.
 */
int getpixel_init(wbp w, struct imgmem *imem)
   {
   return Succeeded;
   }

int getpixel_term(wbp w, struct imgmem *imem)
   {
   return Succeeded;
   }

int getpixel(wbp w, int x, int y, long *rv, char *s, struct imgmem *imem)
   {
   unsigned long c;
   long r, g, b;
   struct ucanvas *cv = w->window->pix;

   if (cv == NULL || x < imem->x || x >= imem->x + imem->width ||
       y < imem->y || y >= imem->y + imem->height ||
       x < 0 || y < 0 || x >= cv->width || y >= cv->height)
      c = w->context->bg;
   else
      c = uc_get_pixel(cv, x, y);
   {
   wdp wd = w->context->display;
   struct sdlcolor *e = wd->colors ? &wd->colors[SDLCOLORHASH(c)] : NULL;
   if (e && e->used && e->pixel == c) {
      r = e->r;
      g = e->g;
      b = e->b;
      }
   else
      sdl_lcolor(w, c, &r, &g, &b);
   }
   *rv = 1;
   sprintf(s, "%ld,%ld,%ld", r, g, b);
   return Succeeded;
   }

/*
 * ------------------------------------------------------------------
 * Pointer, stacking, bell
 * ------------------------------------------------------------------
 */

int query_pointer(wbp w, XPoint *pp)
   {
   wsp ws = w->window;
   int x, y;
   if (ws->win == NULL) return Failed;
   usdl_pointer(ws->win, &x, &y);
   pp->x = ws->pointerx = x;
   pp->y = ws->pointery = y;
   return Succeeded;
   }

int query_rootpointer(XPoint *pp)
   {
   int x, y;
   usdl_global_pointer(&x, &y);
   pp->x = x;
   pp->y = y;
   return Succeeded;
   }

int raiseWindow(wbp w)
   {
   if (w->window->win)
      usdl_raise(w->window->win);
   return Succeeded;
   }

int lowerWindow(wbp w)
   {
   return Succeeded;                    /* SDL cannot lower a window */
   }

int walert(wbp w, int volume)
   {
   fputc('\a', stderr);
   fflush(stderr);
   return Succeeded;
   }

/*
 * ------------------------------------------------------------------
 * Patterns
 * ------------------------------------------------------------------
 */

int SetPattern(wbp w, char *name, int len)
   {
   int width, nbits;
   int i;
   int symbol;
   C_integer bits[MAXXOBJS];
   char *neu;
   wcp wc = w->context;
   CURTSTATE();

   /*
    * wmap reapplies the pattern just stored, passing that same pointer.
    * Copy before freeing, or the parse below reads freed memory.
    */
   if (name != wc->patternname) {
      neu = malloc(len + 1);
      if (neu == NULL) ReturnErrNum(305, RunError);
      memcpy(neu, name, len);
      neu[len] = '\0';
      free(wc->patternname);
      wc->patternname = neu;
      name = neu;
      }

   /*
    * If the pattern starts with a number it is a width , bits encoding
    */
   if ((len > 0) && isdigit(name[0])) {
      nbits = MAXXOBJS;
      switch (parsepattern(name, len, &width, &nbits, bits)) {
      case Failed:
         return Failed;
      case RunError:
         ReturnErrNum(145, RunError);
         }
      return SetPatternBits(w, width, bits, nbits);
      }

   /*
    * Otherwise, it is a named pattern.  Find the symbol id.
    */
   if ((symbol = si_s2i(siPatternSyms, wc->patternname)) >= 0) {
      for(i = 0; i < 8; i++)
         bits[i] = patbits[symbol * 8 + i];
      return SetPatternBits(w, 8, bits, 8);
      }
   return Failed;
   }

/*
 * Row values have the leftmost pixel in their low bit.
 */
int SetPatternBits(wbp w, int width, C_integer *bits, int nbits)
   {
   int i;
   wcp wc = w->context;
   if (width > 32 || nbits > UC_MAXPATTERN) return Failed;
   wc->patw = width;
   wc->path = nbits;
   for (i = 0; i < nbits; i++)
      wc->pat[i] = (unsigned int)bits[i] &
                   (width >= 32 ? 0xFFFFFFFFu : ((1u << width) - 1));
   return Succeeded;
   }

/*
 * ------------------------------------------------------------------
 * Resources: displays, contexts and window states
 * ------------------------------------------------------------------
 */

wdp alc_display(char *s)
   {
   wdp wd;
   char tmp[256];
   CURTSTATE();

   if ((s == NULL) && (getenv_r("DISPLAY", tmp, 255) == 0))
      s = tmp;
   if (s == NULL) s = "";
   for(wd = wdsplys; wd; wd = wd->next)
      if (!strcmp(wd->name,s)) {
         wd->refcount++;
         return wd;
         }

   GRFX_ALLOC(wd, _wdisplay);
   if (strlen(s) >= MAXDISPLAYNAME)
      s = "";
   strcpy(wd->name, s);
   wd->gamma = GammaCorrection;
   GRFX_LINK(wd, wdsplys);
   return wd;
   }

void free_display(wdp wd)
   {
   wd->refcount--;
   if (wd->refcount <= 0) {
      free(wd->colors);
      wd->colors = NULL;
      GRFX_UNLINK(wd, wdsplys);
      }
   }

/*
 * allocate a context.  Can't be called until w has a window.
 */
wcp alc_context(wbp w)
   {
   wcp wc;
   char fnt[256], *spec = "fixed";
   CURTSTATE();

   GRFX_ALLOC(wc, _wcontext);
   wc->serial = ++context_serial;
   wc->display = w->window->display;
   wc->display->refcount++;
   wc->fg = 0x000000;
   wc->bg = 0xFFFFFF;
   wc->fgname = salloc("black");
   wc->bgname = salloc("white");
   wc->drawop = DRAWOP_COPY;
   wc->fillstyle = FS_SOLID;
   wc->linestyle = UC_LINE_SOLID;
   wc->linewidth = 1;
   wc->rgbmode = 2;
   wc->gamma = wc->display->gamma;
   wc->clipx = wc->clipy = 0;
   wc->clipw = wc->cliph = -1;
   uc_gc_init(&wc->gc);

   if (getenv_r("ICONFONT", fnt, 255) == 0)
      spec = fnt;
   wc->font = sdl_mkfont(spec);
   if (wc->font == NULL && spec == fnt)
      wc->font = sdl_mkfont("fixed");   /* ICONFONT not found */
   if (wc->font == NULL) {
      if (*uc_font_error())
         fprintf(stderr, "Unicon graphics: %s\n", uc_font_error());
      free(wc->fgname);
      free(wc->bgname);
      free(wc);
      return NULL;
      }
   wc->leading = wc->font->height;

   GRFX_LINK(wc, wcntxts);
   return wc;
   }

/*
 * allocate a context, cloning attributes from an existing context
 */
wcp clone_context(wbp w)
   {
   wcp wc, rv;
   int i;
   CURTSTATE();

   wc = w->context;
   GRFX_ALLOC(rv, _wcontext);
   rv->serial = ++context_serial;
   rv->display = wc->display;
   rv->display->refcount++;
   rv->dx = wc->dx;
   rv->dy = wc->dy;
   rv->clipx = wc->clipx;
   rv->clipy = wc->clipy;
   rv->clipw = wc->clipw;
   rv->cliph = wc->cliph;
   rv->fg = wc->fg;
   rv->bg = wc->bg;
   rv->fgname = salloc(wc->fgname ? wc->fgname : "black");
   rv->bgname = salloc(wc->bgname ? wc->bgname : "white");
   rv->font = wc->font;
   rv->font->refcount++;
   rv->fillstyle = wc->fillstyle;
   rv->linestyle = wc->linestyle;
   rv->linewidth = wc->linewidth;
   rv->leading = wc->leading;
   rv->drawop = wc->drawop;
   rv->rgbmode = wc->rgbmode;
   rv->gamma = wc->gamma;
   rv->bits = wc->bits;
   rv->patw = wc->patw;
   rv->path = wc->path;
   for (i = 0; i < UC_MAXPATTERN; i++)
      rv->pat[i] = wc->pat[i];
   if (wc->patternname)
      rv->patternname = salloc(wc->patternname);
   uc_gc_init(&rv->gc);
#ifdef Graphics3D
   rv->is_3D = wc->is_3D;
   copy_3dcontext(wc, rv);
#endif                                  /* Graphics3D */

   GRFX_LINK(rv, wcntxts);
   return rv;
   }

/*
 * allocate a window state structure
 */
wsp alc_winstate()
   {
   wsp ws;
   CURTSTATE();
   GRFX_ALLOC(ws, _wstate);
   ws->serial = ++canvas_serial;
   ws->bits = 1024;                             /* echo ON; others OFF */
   ws->filep = nulldesc;
   ws->listp = nulldesc;
   ws->cursorname = salloc("left ptr");
   ws->cursor = USDL_CURSOR_ARROW;
   SETTITLEBAR(ws);
   ws->inputmask = 0;
   ws->iconic = NormalState;
   ws->posx = ws->posy = -(MaxInt);
   ws->minwidth = ws->minheight = 0;
   GRFX_LINK(ws, wstates);
   return ws;
   }

/*
 * free a window state
 */
int free_window(wsp ws)
   {
   ws->refcount--;
   if(ws->refcount == 0) {
      if (ws->win) {
         usdl_close(ws->win);
         ws->win = NULL;
         }
      if (ws->pix) {
         uc_canvas_free(ws->pix);
         ws->pix = NULL;
         }
      if (ws->initialPix) {
         uc_canvas_free(ws->initialPix);
         ws->initialPix = NULL;
         }
      if (ws->iconpix) {
         uc_canvas_free(ws->iconpix);
         ws->iconpix = NULL;
         }
      if (ws->comp) {
         uc_canvas_free(ws->comp);
         ws->comp = NULL;
         }
#if defined(Graphics3D) && HAVE_LIBGL
      if (ws->gl) {
         usdl_gl_close(ws->gl);
         ws->gl = NULL;
         }
#endif                                  /* Graphics3D && HAVE_LIBGL */
      if (ws->windowlabel) { free(ws->windowlabel); ws->windowlabel = NULL; }
      if (ws->iconlabel) { free(ws->iconlabel); ws->iconlabel = NULL; }
      if (ws->iconimage) { free(ws->iconimage); ws->iconimage = NULL; }
      if (ws->cursorname) { free(ws->cursorname); ws->cursorname = NULL; }
      if (ws->display) free_display(ws->display);
      GRFX_UNLINK(ws, wstates);
      }
   return 0;
   }

/*
 * free a window context
 */
void free_context(wcp wc)
   {
   wc->refcount--;
   if(wc->refcount == 0) {
      sdl_freefont(wc->font);
      wc->font = NULL;
      if (wc->patternname) free(wc->patternname);
      wc->patternname = NULL;
      if (wc->fgname) free(wc->fgname);
      wc->fgname = NULL;
      if (wc->bgname) free(wc->bgname);
      wc->bgname = NULL;
      if (wc->display) free_display(wc->display);
      GRFX_UNLINK(wc, wcntxts);
      }
   }

#if defined(Graphics3D) && HAVE_LIBGL
/*
 * ------------------------------------------------------------------
 * 3D windows: each has an OpenGL context that renders into a framebuffer
 * the size of the window; each finished frame is copied into the canvas.
 * ------------------------------------------------------------------
 */

int create3Dcontext(wbp w)
   {
   wsp ws = w->window;
   if (ws->gl == NULL && (ws->gl = usdl_gl_open()) == NULL) {
      fprintf(stderr, "cannot open a 3D window: %s\n", usdl_error());
      return Failed;
      }
   if (!usdl_gl_size(ws->gl, ws->width, ws->height)) {
      fprintf(stderr, "cannot open a 3D window: %s\n", usdl_error());
      return Failed;
      }
   /* as for a new window's context: the viewport covers the window */
   glViewport(0, 0, (GLsizei)ws->width, (GLsizei)ws->height);
   glPointSize((GLfloat)uc_get_scale());
   return Succeeded;
   }

void makecurrent(wbp w)
   {
   usdl_gl_current(w->window->gl);
   }

/*
 * The frame is done: show it.
 */
void sdl_gl_swap(wbp w)
   {
   wsp ws = w->window;
   if (ws->gl && ws->pix) {
      usdl_gl_show(ws->gl, ws->pix, 0, 0);
      present(ws, 0);
      }
   }

/*
 * The window's size changed: resize the framebuffer and draw the scene
 * again, with the viewing volume X11 uses.
 */
static void sdl_gl_resize(wbp w)
   {
   wsp ws = w->window;
   if (ws->gl == NULL || ws->width <= 0 || ws->height <= 0)
      return;
   if (usdl_gl_size(ws->gl, ws->width, ws->height) != 2)
      return;                           /* the same size */
   glViewport(0, 0, (GLsizei)ws->width, (GLsizei)ws->height);
   glMatrixMode(GL_PROJECTION);
   glLoadIdentity();
   glFrustum(-0.125, 0.125, -0.125 * ws->height / ws->width,
             0.125 * ws->height / ws->width, 0.25, 50000.0);
   glMatrixMode(GL_MODELVIEW);
   redraw3D(w);
   }
#endif                                  /* Graphics3D && HAVE_LIBGL */

/*
 * Child windows (subwindows of a canvas) have a canvas but no window of
 * their own; wmap() makes the canvas once the attributes are known, and
 * they are shown over their parent.
 */
char child_window_stuff(wbp w, wbp wp, int child_window)
   {
   if (child_window_generic(w, wp, child_window) == 0)
      return 0;
   return 1;
   }

char my_wmap(wbp w)
   {
   return wmap(w) == Succeeded;
   }
