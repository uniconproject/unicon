int nativecolor(wbp w, char *s, long *r, long *g, long *b)
   {
   char key[64];
   int i, n = 0, lo, hi;
   unsigned long c;

   for (; *s && n < (int)sizeof(key) - 1; s++)
      if (!isspace(*s))
         key[n++] = tolower((unsigned char)*s);
   key[n] = '\0';

   if ((!strncmp(key, "gray", 4) || !strncmp(key, "grey", 4)) &&
       isdigit(key[4])) {
      int pct = atoi(key + 4);
      if (pct > 100) return 0;
      *r = *g = *b = (long)(pct * 65535L / 100);
      return 1;
      }

   lo = 0; hi = sizeof(xcolors) / sizeof(xcolors[0]) - 1;
   while (lo <= hi) {
      int cmp;
      i = (lo + hi) / 2;
      cmp = strcmp(key, xcolors[i].name);
      if (cmp == 0) {
         c = xcolors[i].rgb;
         if (w)
            sdl_lcolor(w, c, r, g, b);
         else {
            *r = ((c >> 16) & 255) * 257;
            *g = ((c >> 8) & 255) * 257;
            *b = (c & 255) * 257;
            }
         return 1;
         }
      if (cmp < 0) hi = i - 1; else lo = i + 1;
      }
   return 0;
   }

/*
 * ------------------------------------------------------------------
 * Images
 * ------------------------------------------------------------------
 */

/*
 * Draw a bi-level image.  The hex digits fill the rows right to left.
 */
int blimage(wbp w, int x, int y, int width, int height, int ch, unsigned char *s, word len)
   {
   unsigned int m, msk1, c, ix, iy;
   struct ucgc gc;
   STDLOCALS(w);

   gc = *stdgc;
   gc.op = UC_OP_COPY;

   m = width % 4;
   if (m == 0)
      msk1 = 8;
   else
      msk1 = 1 << (m - 1);              /* mask for first byte of row */

   ix = width;
   iy = 0;
   m = msk1;
   while (len--) {
      if (isxdigit(c = *s++)) {         /* if hexadecimal character */
         if (!isdigit(c))               /* fix bottom 4 bits if necessary */
            c += 9;
         while (m > 0) {                /* set (usually) 4 pixel values */
            --ix;
            if (c & m)
               uc_put_pixel(stdpix, &gc, x + ix, y + iy, (unsigned int)wc->fg);
            else if (ch != TCH1)        /* if zeroes aren't transparent */
               uc_put_pixel(stdpix, &gc, x + ix, y + iy, (unsigned int)wc->bg);
            m >>= 1;
            }
         if (ix == 0) {                 /* if end of row */
            ix = width;
            iy++;
            m = msk1;
            }
         else
            m = 8;
         }
      }
   if (ix > 0 && ch != TCH1)            /* pad final row if incomplete */
      while (ix < (unsigned int)width)
         uc_put_pixel(stdpix, &gc, x + ix++, y + iy, (unsigned int)wc->bg);
   return Succeeded;
   }

/*
 * Draw a character-per-pixel image (palette e) or, if e is NULL,
 * an image of 8-bit RGB triples.
 */
int strimage(wbp w, int x, int y, int width, int height,
             struct palentry *e, unsigned char *s, word len, int on_icon)
   {
   int c, v;
   unsigned int ix, iy;
   unsigned long carray[256];
   struct ucgc gc;
   STDLOCALS(w);

   if (on_icon) return 0;               /* no icon windows */
   gc = *stdgc;
   gc.op = UC_OP_COPY;

   if (e) {
      for (c = 0; c < 256; c++)
         if (e[c].used && e[c].valid)
            carray[c] = sdl_rgb(w, e[c].clr.red, e[c].clr.green,
                                e[c].clr.blue);

      /*
       * Read the image string and set the pixel values.
       */
      ix = iy = 0;
      while (len--) {
         c = *s++;
         v = e[c].valid;
         if (v)                         /* put char if valid */
            uc_put_pixel(stdpix, &gc, x + ix, y + iy, (unsigned int)carray[c]);
         if (v || e[c].transpt) {       /* advance if valid or transparent */
            if (++ix >= (unsigned int)width) {
               ix = 0;                  /* reset for new row */
               iy++;
               }
            }
         }
      if (ix > 0) {                     /* pad final row if incomplete */
         while (ix < (unsigned int)width)
            uc_put_pixel(stdpix, &gc, x + ix++, y + iy, (unsigned int)wc->bg);
         }
      }
   else {
      for (iy = 0; iy < (unsigned int)height; iy++)
         for (ix = 0; ix < (unsigned int)width; ix++) {
            unsigned int r = *s++, g = *s++, b = *s++;
            uc_put_pixel(stdpix, &gc, x + ix, y + iy, (r << 16) | (g << 8) | b);
            }
      }
   return 0;
   }

static int rgbcmp(const void *a, const void *b)
   {
   unsigned long x = *(const unsigned long *)a, y = *(const unsigned long *)b;
   return (x < y) ? -1 : (x > y);
   }

/*
 * getimstr(w, x, y, width, height, paltbl, data) -- get image as a string.
 *
 * Stores the specified subimage in data, one pixel per byte, and sets
 * entries in paltbl corresponding to the pixel values that were used.
 * With more than 256 colors, the image is mapped onto a 6x7x6 color cube.
 */
int getimstr(wbp w, int x, int y, int width, int height,
             struct palentry paltbl[DMAXCOLORS], unsigned char *data)
   {
   unsigned long *clist, px;
   int i, j, n = 0, cube = 0;
   struct ucanvas *c = w->window->pix;
   unsigned long bg = w->context->bg;

   if (c == NULL) return 0;
   clist = malloc(DMAXCOLORS * sizeof(unsigned long));
   if (clist == NULL) return 0;

   /* collect the distinct colors, up to 256 */
   for (j = 0; j < height && !cube; j++)
      for (i = 0; i < width; i++) {
         int k;
         px = (x+i < 0 || y+j < 0 || x+i >= c->width || y+j >= c->height) ?
            bg : uc_get_pixel(c, x + i, y + j);
         for (k = 0; k < n; k++)
            if (clist[k] == px) break;
         if (k == n) {
            if (n == DMAXCOLORS) { cube = 1; break; }
            clist[n++] = px;
            }
         }

   if (cube) {
      n = 0;
      for (i = 0; i < 6; i++)
         for (j = 0; j < 7; j++) {
            int k;
            for (k = 0; k < 6; k++)
               clist[n++] = ((unsigned long)(i * 51) << 16) |
                  ((unsigned long)(j * 255 / 6) << 8) | (unsigned long)(k * 51);
            }
      }
   else
      qsort(clist, n, sizeof(unsigned long), rgbcmp);

   for (j = 0; j < height; j++)
      for (i = 0; i < width; i++) {
         int k;
         px = (x+i < 0 || y+j < 0 || x+i >= c->width || y+j >= c->height) ?
            bg : uc_get_pixel(c, x + i, y + j);
         if (cube)
            k = (int)(((px >> 16) & 255) + 25) / 51 * 42 +
                (int)((((px >> 8) & 255) * 6 + 127) / 255) * 6 +
                (int)((px & 255) + 25) / 51;
         else {
            unsigned long *lp = bsearch(&px, clist, n, sizeof(unsigned long),
                                        rgbcmp);
            k = lp ? (int)(lp - clist) : 0;
            }
         *data++ = k;
         paltbl[k].used = 1;
         }

   for (i = 0; i < DMAXCOLORS && i < n; i++)
      if (paltbl[i].used) {
         sdl_lcolor(w, clist[i], &paltbl[i].clr.red, &paltbl[i].clr.green,
                    &paltbl[i].clr.blue);
         paltbl[i].valid = 1;
         }
   free(clist);
   return 1;
   }

/*
 * getimstr24 -- get an image as a string of RGB tuples.
 */
int getimstr24(wbp w, int xx, int yy, int width, int height, unsigned char *data)
   {
   int x, y;
   unsigned long px;
   struct ucanvas *c = w->window->pix;
   if (c == NULL) return 0;
   for (y = 0; y < height; y++)
      for (x = 0; x < width; x++) {
         px = uc_get_pixel(c, xx + x, yy + y);
         *data++ = (px >> 16) & 0xFF;
         *data++ = (px >> 8) & 0xFF;
         *data++ = px & 0xFF;
         }
   return 1;
   }

/*
 * Image files the generic code cannot read: none.
 */
int readimage(wbp w, char *filename, int x, int y, int *status)
   {
   return Failed;
   }

/*
 * Image files the generic code cannot write: none (GIF, BMP, PNG and
 * JPEG are written by the generic code).
 */
int dumpimage(wbp w, char *filename, unsigned int x, unsigned int y,
              unsigned int width, unsigned int height)
   {
   return NoCvt;
   }

/*
 * Pixels are read straight from the canvas.
 */
int getpixel_init(wbp w, struct imgmem *imem)
   {
   return Succeeded;
   }

int getpixel_term(wbp w, struct imgmem *imem)
   {
   return Succeeded;
   }

int getpixel(wbp w, int x, int y, long *rv, char *s, struct imgmem *imem)
   {
   unsigned long c;
   long r, g, b;
   struct ucanvas *cv = w->window->pix;

   if (cv == NULL || x < imem->x || x >= imem->x + imem->width ||
       y < imem->y || y >= imem->y + imem->height ||
       x < 0 || y < 0 || x >= cv->width || y >= cv->height)
      c = w->context->bg;
   else
      c = uc_get_pixel(cv, x, y);
   sdl_lcolor(w, c, &r, &g, &b);
   *rv = 1;
   sprintf(s, "%ld,%ld,%ld", r, g, b);
   return Succeeded;
   }

/*
 * ------------------------------------------------------------------
 * Pointer, stacking, bell
 * ------------------------------------------------------------------
 */

int query_pointer(wbp w, XPoint *pp)
   {
   wsp ws = w->window;
   int x, y;
   if (ws->win == NULL) return Failed;
   usdl_pointer(ws->win, &x, &y);
   pp->x = ws->pointerx = x;
   pp->y = ws->pointery = y;
   return Succeeded;
   }

int query_rootpointer(XPoint *pp)
   {
   int x, y;
   usdl_global_pointer(&x, &y);
   pp->x = x;
   pp->y = y;
   return Succeeded;
   }

int raiseWindow(wbp w)
   {
   if (w->window->win)
      usdl_raise(w->window->win);
   return Succeeded;
   }

int lowerWindow(wbp w)
   {
   return Succeeded;                    /* SDL cannot lower a window */
   }

int walert(wbp w, int volume)
   {
   fputc('\a', stderr);
   fflush(stderr);
   return Succeeded;
   }

/*
 * ------------------------------------------------------------------
 * Patterns
 * ------------------------------------------------------------------
 */

int SetPattern(wbp w, char *name, int len)
   {
   int width, nbits;
   int i;
   int symbol;
   C_integer bits[MAXXOBJS];
   char *neu;
   wcp wc = w->context;
   CURTSTATE();

   /*
    * wmap reapplies the pattern just stored, passing that same pointer.
    * Copy before freeing, or the parse below reads freed memory.
    */
   if (name != wc->patternname) {
      neu = malloc(len + 1);
      if (neu == NULL) ReturnErrNum(305, RunError);
      memcpy(neu, name, len);
      neu[len] = '\0';
      free(wc->patternname);
      wc->patternname = neu;
      name = neu;
      }

   /*
    * If the pattern starts with a number it is a width , bits encoding
    */
   if ((len > 0) && isdigit(name[0])) {
      nbits = MAXXOBJS;
      switch (parsepattern(name, len, &width, &nbits, bits)) {
      case Failed:
         return Failed;
      case RunError:
         ReturnErrNum(145, RunError);
         }
      return SetPatternBits(w, width, bits, nbits);
      }

   /*
    * Otherwise, it is a named pattern.  Find the symbol id.
    */
   if ((symbol = si_s2i(siPatternSyms, wc->patternname)) >= 0) {
      for(i = 0; i < 8; i++)
         bits[i] = patbits[symbol * 8 + i];
      return SetPatternBits(w, 8, bits, 8);
      }
   return Failed;
   }

/*
 * Row values have the leftmost pixel in their low bit.
 */
int SetPatternBits(wbp w, int width, C_integer *bits, int nbits)
   {
   int i;
   wcp wc = w->context;
   if (width > 32 || nbits > UC_MAXPATTERN) return Failed;
   wc->patw = width;
   wc->path = nbits;
   for (i = 0; i < nbits; i++)
      wc->pat[i] = (unsigned int)bits[i] &
                   (width >= 32 ? 0xFFFFFFFFu : ((1u << width) - 1));
   return Succeeded;
   }

/*
 * ------------------------------------------------------------------
 * Resources: displays, contexts and window states
 * ------------------------------------------------------------------
 */

wdp alc_display(char *s)
   {
   wdp wd;
   char tmp[256];
   CURTSTATE();

   if ((s == NULL) && (getenv_r("DISPLAY", tmp, 255) == 0))
      s = tmp;
   if (s == NULL) s = "";
   for(wd = wdsplys; wd; wd = wd->next)
      if (!strcmp(wd->name,s)) {
         wd->refcount++;
         return wd;
         }

   GRFX_ALLOC(wd, _wdisplay);
   if (strlen(s) >= MAXDISPLAYNAME)
      s = "";
   strcpy(wd->name, s);
   wd->gamma = GammaCorrection;
   GRFX_LINK(wd, wdsplys);
   return wd;
   }

void free_display(wdp wd)
   {
   wd->refcount--;
   if (wd->refcount <= 0) {
      GRFX_UNLINK(wd, wdsplys);
      }
   }

/*
 * allocate a context.  Can't be called until w has a window.
 */
wcp alc_context(wbp w)
   {
   wcp wc;
   char fnt[256], *spec = "fixed";
   CURTSTATE();

   GRFX_ALLOC(wc, _wcontext);
   wc->serial = ++context_serial;
   wc->display = w->window->display;
   wc->display->refcount++;
   wc->fg = 0x000000;
   wc->bg = 0xFFFFFF;
   wc->fgname = salloc("black");
   wc->bgname = salloc("white");
   wc->drawop = DRAWOP_COPY;
   wc->fillstyle = FS_SOLID;
   wc->linestyle = UC_LINE_SOLID;
   wc->linewidth = 1;
   wc->rgbmode = 2;
   wc->gamma = wc->display->gamma;
   wc->clipx = wc->clipy = 0;
   wc->clipw = wc->cliph = -1;
   uc_gc_init(&wc->gc);

   if (getenv_r("ICONFONT", fnt, 255) == 0)
      spec = fnt;
   wc->font = sdl_mkfont(spec);
   if (wc->font == NULL && spec == fnt)
      wc->font = sdl_mkfont("fixed");   /* ICONFONT not found */
   if (wc->font == NULL) {
      if (*uc_font_error())
         fprintf(stderr, "Unicon graphics: %s\n", uc_font_error());
      free(wc->fgname);
      free(wc->bgname);
      free(wc);
      return NULL;
      }
   wc->leading = wc->font->height;

   GRFX_LINK(wc, wcntxts);
   return wc;
   }

/*
 * allocate a context, cloning attributes from an existing context
 */
wcp clone_context(wbp w)
   {
   wcp wc, rv;
   int i;
   CURTSTATE();

   wc = w->context;
   GRFX_ALLOC(rv, _wcontext);
   rv->serial = ++context_serial;
   rv->display = wc->display;
   rv->display->refcount++;
   rv->dx = wc->dx;
   rv->dy = wc->dy;
   rv->clipx = wc->clipx;
   rv->clipy = wc->clipy;
   rv->clipw = wc->clipw;
   rv->cliph = wc->cliph;
   rv->fg = wc->fg;
   rv->bg = wc->bg;
   rv->fgname = salloc(wc->fgname ? wc->fgname : "black");
   rv->bgname = salloc(wc->bgname ? wc->bgname : "white");
   rv->font = wc->font;
   rv->font->refcount++;
   rv->fillstyle = wc->fillstyle;
   rv->linestyle = wc->linestyle;
   rv->linewidth = wc->linewidth;
   rv->leading = wc->leading;
   rv->drawop = wc->drawop;
   rv->rgbmode = wc->rgbmode;
   rv->gamma = wc->gamma;
   rv->bits = wc->bits;
   rv->patw = wc->patw;
   rv->path = wc->path;
   for (i = 0; i < UC_MAXPATTERN; i++)
      rv->pat[i] = wc->pat[i];
   if (wc->patternname)
      rv->patternname = salloc(wc->patternname);
   uc_gc_init(&rv->gc);

   GRFX_LINK(rv, wcntxts);
   return rv;
   }

/*
 * allocate a window state structure
 */
wsp alc_winstate()
   {
   wsp ws;
   CURTSTATE();
   GRFX_ALLOC(ws, _wstate);
   ws->serial = ++canvas_serial;
   ws->bits = 1024;                             /* echo ON; others OFF */
   ws->filep = nulldesc;
   ws->listp = nulldesc;
   ws->cursorname = salloc("left ptr");
   ws->cursor = USDL_CURSOR_ARROW;
   SETTITLEBAR(ws);
   ws->inputmask = 0;
   ws->iconic = NormalState;
   ws->posx = ws->posy = -(MaxInt);
   ws->minwidth = ws->minheight = 0;
   GRFX_LINK(ws, wstates);
   return ws;
   }

/*
 * free a window state
 */
int free_window(wsp ws)
   {
   ws->refcount--;
   if(ws->refcount == 0) {
      if (ws->win) {
         usdl_close(ws->win);
         ws->win = NULL;
         }
      if (ws->pix) {
         uc_canvas_free(ws->pix);
         ws->pix = NULL;
         }
      if (ws->initialPix) {
         uc_canvas_free(ws->initialPix);
         ws->initialPix = NULL;
         }
      if (ws->windowlabel) { free(ws->windowlabel); ws->windowlabel = NULL; }
      if (ws->iconlabel) { free(ws->iconlabel); ws->iconlabel = NULL; }
      if (ws->iconimage) { free(ws->iconimage); ws->iconimage = NULL; }
      if (ws->cursorname) { free(ws->cursorname); ws->cursorname = NULL; }
      if (ws->display) free_display(ws->display);
      GRFX_UNLINK(ws, wstates);
      }
   return 0;
   }

/*
 * free a window context
 */
void free_context(wcp wc)
   {
   wc->refcount--;
   if(wc->refcount == 0) {
      sdl_freefont(wc->font);
      wc->font = NULL;
      if (wc->patternname) free(wc->patternname);
      wc->patternname = NULL;
      if (wc->fgname) free(wc->fgname);
      wc->fgname = NULL;
      if (wc->bgname) free(wc->bgname);
      wc->bgname = NULL;
      if (wc->display) free_display(wc->display);
      GRFX_UNLINK(wc, wcntxts);
      }
   }

/*
 * Child windows (subwindows of a canvas) have a canvas but no window
 * of their own.
 */
char child_window_stuff(wbp w, wbp wp, int child_window)
   {
   wsp ws;
   if (child_window_generic(w, wp, child_window) == 0)
      return 0;
   ws = w->window;
   if (ws->pix == NULL) {
      ws->pix = uc_canvas_new(Max(ws->width, 1), Max(ws->height, 1),
                              (unsigned int)w->context->bg);
      if (ws->pix == NULL) return 0;
      ws->pixwidth = ws->pix->width;
      ws->pixheight = ws->pix->height;
      }
   return 1;
   }

char my_wmap(wbp w)
   {
   return wmap(w) == Succeeded;
   }
