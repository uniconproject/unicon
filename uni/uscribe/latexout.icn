#<p>
# LaTeX doctree outputter: <tt>LatexOutputter</tt> renders a resolved
# <tt>Document</tt> tree as LaTeX, plus helpers <tt>escapeLatex</tt>,
# <tt>escapeLatexTT</tt>, <tt>escapeLatexPath</tt>,
# <tt>escapeVerbatimLine</tt>, and <tt>latexLabelId</tt>. The driver writes
# one <tt>--name</tt>.tex (default <tt>book.tex</tt>; preamble + every
# chapter + <tt>\\end{document}</tt>); <tt>--format=pdf</tt> then runs
# a TeX engine.
#</p>
#<p>
# <b>Author:</b> Jafar Al-Gharaibeh
#</p>
#<p>
# This file is in the <i>public domain</i>.
#</p>

package uscribe

import lang

#<p>
# Concrete <tt>Outputter</tt> for LaTeX / PDF. Unlike
# <tt>HtmlOutputter</tt> (one file per chapter), the driver opens a
# single <tt>.tex</tt> stream and calls <tt>visitDocument</tt> once per
# chapter after <tt>writePreamble</tt> / before <tt>writeEpilogue</tt>.
#</p>
class LatexOutputter : Outputter (outFile, labelTable, bookTitle,
                                  chapterBase, chapterIndex, figureNo,
                                  docClass, reportDoc, citationTable,
                                  footnoteList, logoFile, currentDoc,
                                  wroteByline, tableNcols)

    #<p>
    # Set the open file to which LaTeX is written.
    # <[param f an open file]>
    #</p>
    method setOutFile(f)
        outFile := f
        return
    end

    #<p>
    # Attach the shared label table.
    # <[param lt a LabelTable]>
    #</p>
    method setLabelTable(lt)
        labelTable := lt
        return
    end

    #<p>
    # Set the book title used in the LaTeX <tt>\\title{...}</tt>.
    # <[param t title string]>
    #</p>
    method setBookTitle(t)
        bookTitle := t
        return
    end

    #<p>
    # Set document class: <tt>"book"</tt> (default) or <tt>"report"</tt>.
    # <[param c class name string]>
    #</p>
    method setDocClass(c)
        docClass := c
        return
    end

    #<p>
    # Attach the Document that supplies UTR cover metadata (report mode).
    # <[param d a Document node]>
    #</p>
    method setReportDoc(d)
        reportDoc := d
        return
    end

    #<p>
    # Attach the shared citation table (optional).
    # <[param ct a CitationTable, or null]>
    #</p>
    method setCitationTable(ct)
        citationTable := ct
        return
    end

    #<p>
    # Optional cover / title-page logo (basename already copied into
    # the output directory). Empty/null keeps the plain
    # <tt>\\maketitle</tt> / report cover.
    # <[param file image basename, or null]>
    #</p>
    method setLogo(file)
        logoFile := file
        return
    end

    #<p>
    # True when emitting article/UTR layout.
    # <[fails if book mode]>
    #</p>
    method isReport()
        if (\docClass | "book") == "report" then return
        if \reportDoc then return reportDoc.isReport()
        fail
    end

    #<p>
    # Write the documentclass, packages, title, and
    # <tt>\\begin{document}</tt> / cover / TOC as appropriate.
    #</p>
    method writePreamble()
        write(outFile, "% Generated by uscribe -- do not edit by hand")
        if isReport() then
            writeReportPreamble()
        else
            writeBookPreamble()
        return
    end

    #<p>
    # Book-mode preamble: <tt>book</tt> class, maketitle, TOC.
    #</p>
    method writeBookPreamble()
        write(outFile, "\\documentclass[11pt,openany]{book}")
        writeCommonPackages()
        write(outFile, "\\title{", escapeLatex(\bookTitle) | "Untitled", "}")
        write(outFile, "\\author{}")
        write(outFile, "\\date{}")
        write(outFile, "\\begin{document}")
        if \logoFile & *logoFile > 0 then {
            write(outFile, "\\begin{titlepage}")
            write(outFile, "\\centering")
            write(outFile, "\\vspace*{1.6cm}")
            write(outFile, "\\includegraphics[width=0.55\\textwidth,",
                  "keepaspectratio]{", escapeLatexPath(logoFile), "}\\\\[2em]")
            write(outFile, "{\\Huge\\bfseries ",
                  escapeLatex(\bookTitle) | "Untitled", "\\par}")
            write(outFile, "\\vfill")
            write(outFile, "\\end{titlepage}")
            }
        else
            write(outFile, "\\maketitle")
        return
    end

    #<p>
    # Switch to unnumbered front-matter chapters (preface).
    #</p>
    method writeFrontMatter()
        write(outFile, "\\frontmatter")
        return
    end

    #<p>
    # Book TOC, then numbered main matter. Call after any front-matter
    # chapters so the contents list follows the preface, as in Word.
    #</p>
    method writeContentsAndMain()
        write(outFile, "\\tableofcontents")
        write(outFile, "\\clearpage")
        write(outFile, "\\mainmatter")
        return
    end

    #<p>
    # Report-mode preamble: <tt>article</tt> class and a
    # <tt>utr.sty</tt>-like title page from <tt>reportDoc</tt> metadata.
    #</p>
    method writeReportPreamble()
        local d, a, first, authors
        d := \reportDoc
        write(outFile, "\\documentclass[letterpaper,12pt]{article}")
        writeCommonPackages()
        write(outFile, "\\begin{document}")
        write(outFile, "\\begin{titlepage}")
        write(outFile, "\\null\\vfil\\vskip 40pt")
        write(outFile, "\\begin{center}")
        if \logoFile & *logoFile > 0 then
            write(outFile, "\\includegraphics[width=0.42\\textwidth,",
                  "keepaspectratio]{", escapeLatexPath(logoFile),
                  "}\\\\[1.5em]")
        write(outFile, "{\\LARGE\\bfseries ",
              escapeLatex((\d.getTitle()) | (\bookTitle) | "Untitled"),
              " \\par}")
        write(outFile, "\\vskip 3em")
        authors := ""
        if \d then {
            first := 1
            every a := !d.getAuthors() do {
                if /first then authors ||:= "\\\\"
                authors ||:= escapeLatex(a)
                first := &null
                }
            }
        if *authors > 0 then
            write(outFile, "{\\large\\bfseries ", authors, " \\par}")
        write(outFile, "\\vskip 1.0em")
        if \d & \d.getTrNumber() then
            write(outFile, "{\\bfseries Unicon Technical Report: ",
                  escapeLatex(d.getTrNumber()), "\\par}")
        write(outFile, "\\vskip 1.0em")
        if \d & \d.getDate() then
            write(outFile, "{\\large\\bfseries ",
                  escapeLatex(d.getDate()), "\\par}")
        write(outFile, "\\vskip 5.5em")
        if \d & \d.getAbstract() then {
            write(outFile, "{\\bfseries Abstract}\\par")
            write(outFile, "\\begin{quote}")
            write(outFile, escapeLatex(d.getAbstract()))
            write(outFile, "\\end{quote}")
            }
        if \d & \d.getKeywords() then {
            write(outFile, "\\begin{quote}")
            write(outFile, "{\\bfseries Keywords:} ",
                  escapeLatex(d.getKeywords()))
            write(outFile, "\\end{quote}")
            }
        write(outFile, "\\vskip 0.8in")
        write(outFile, "{\\large\\bfseries")
        write(outFile, "Unicon Project\\\\")
        write(outFile, "\\url{http://unicon.org}\\\\")
        write(outFile, "\\ \\")
        write(outFile, "University of Idaho\\\\")
        write(outFile, "Department of Computer Science\\\\")
        write(outFile, "Moscow, ID, 83844, USA")
        write(outFile, "}")
        write(outFile, "\\end{center}")
        write(outFile, "\\vfil\\null")
        write(outFile, "\\end{titlepage}")
        write(outFile, "\\setcounter{page}{1}")
        return
    end

    #<p>
    # Shared package list for book and report preambles.
    #</p>
    method writeCommonPackages()
        write(outFile, "\\usepackage[T1]{fontenc}")
        write(outFile, "\\usepackage[utf8]{inputenc}")
        write(outFile, "\\usepackage{graphicx}")
        write(outFile, "\\usepackage{hyperref}")
        write(outFile, "\\usepackage{xcolor}")
        write(outFile, "\\usepackage{fancyvrb}")
        # fvextra wraps long Verbatim lines; without it, CLI/JSON overflows the frame.
        write(outFile, "\\IfFileExists{fvextra.sty}{%")
        write(outFile, "  \\usepackage{fvextra}%")
        write(outFile, "  \\fvset{breaklines=true,breakanywhere=true}%")
        write(outFile, "}{}")
        # Full-width shaded samples (Word CodeBlock is often left-indented).
        # framed.sty is in some extra TeX schemes; without it, keep
        # resetmargins Verbatim and skip the gray box.
        write(outFile, "\\IfFileExists{framed.sty}{%")
        write(outFile, "  \\usepackage{framed}%")
        write(outFile, "  \\definecolor{shadecolor}{RGB}{240,243,246}%")
        write(outFile, "  \\newenvironment{uscribeshaded}{\\shaded}{\\endshaded}%")
        write(outFile, "}{%")
        write(outFile, "  \\newenvironment{uscribeshaded}{}{}%")
        write(outFile, "}")
        write(outFile, "\\usepackage{booktabs}")
        write(outFile, "\\usepackage{longtable}")
        write(outFile, "\\usepackage{array}")
        write(outFile, "\\IfFileExists{multirow.sty}{\\usepackage{multirow}}{}")
        # caption* needs caption.sty; without it define a centered fallback.
        # Use ##1 inside \IfFileExists so #1 is the newcommand parameter.
        write(outFile, "\\IfFileExists{caption.sty}{%")
        write(outFile, "  \\usepackage{caption}%")
        write(outFile, "  \\newcommand{\\uscribecaptionstar}[1]{\\caption*{##1}}%")
        write(outFile, "}{%")
        write(outFile, "  \\newcommand{\\uscribecaptionstar}[1]{{\\centering\\small ##1\\par}}%")
        write(outFile, "}")
        write(outFile, "\\hypersetup{colorlinks=true,linkcolor=blue,urlcolor=blue}")
        return
    end

    #<p>
    # Write <tt>\\end{document}</tt>.
    #</p>
    method writeEpilogue()
        write(outFile, "\\end{document}")
        return
    end

    #<p>
    # Start a chapter: bump <tt>chapterIndex</tt>, set
    # <tt>chapterBase</tt> from the HTML basename (without
    # <tt>.html</tt>), insert <tt>\\clearpage</tt> after the first
    # chapter, then visit children.
    # <[param n a Document node]>
    #</p>
    method visitDocument(n)
        local base
        chapterIndex := (\chapterIndex | 0) + 1
        base := chapterOutputName(n.getSrcName())
        if *base >= 5 & base[*base-4:0] == ".html" then
            base := base[1:*base-4]
        chapterBase := base
        currentDoc := n
        wroteByline := &null
        if chapterIndex > 1 then
            write(outFile, "\\clearpage")
        every (!n.getChildren()).accept(self)
        return
    end

    #<p>
    # Emit <tt>\\chapter</tt> / <tt>\\section</tt> / … plus a
    # <tt>\\label</tt> from <tt>latexLabelId</tt>, then visit children.
    # <[param n a Section node]>
    #</p>
    method visitSection(n)
        local cmd, id, level
        level := n.getLevel()
        if isReport() then
            cmd := case level of {
                1: "section"
                2: "subsection"
                3: "subsubsection"
                default: "paragraph"
                }
        else
            cmd := case level of {
                1: "chapter"
                2: "section"
                3: "subsection"
                4: "subsubsection"
                default: "paragraph"
                }
        writes(outFile, "\\", cmd, "{")
        writeInlineTitle(n.getTitle())
        write(outFile, "}")
        id := latexLabelId(chapterBase, anchorFor(n))
        write(outFile, "\\label{", id, "}")
        if level = 1 then
            writeChapterByline()
        every (!n.getChildren()).accept(self)
        return
    end

    #<p>
    # Book-chapter byline under the first <tt>\\chapter</tt> when
    # <tt>:author:</tt> / <tt>:date:</tt> / <tt>:copyright:</tt> are
    # set. Reports already show this on the cover.
    #</p>
    method writeChapterByline()
        local bits, s, first, item
        if \wroteByline then return
        wroteByline := 1
        if /currentDoc then return
        if currentDoc.isReport() then return
        if not docHasChapterByline(currentDoc) then return
        bits := []
        s := formatDocAuthors(currentDoc)
        if *s > 0 then put(bits, s)
        if \currentDoc.getDate() then
            put(bits, currentDoc.getDate())
        if \currentDoc.getCopyright() then
            put(bits, "Copyright " || currentDoc.getCopyright())
        writes(outFile, "\\noindent\\textit{")
        first := 1
        every item := !bits do {
            if /first then writes(outFile, " / ")
            writes(outFile, escapeLatex(item))
            first := &null
            }
        write(outFile, "}\\par")
        write(outFile, "\\vspace{0.6em}")
        return
    end

    #<p>
    # Emit a paragraph as blank-line-separated prose.
    # <[param n a Paragraph node]>
    #</p>
    method visitParagraph(n)
        write(outFile)
        every (!n.getChildren()).accept(self)
        write(outFile)
        write(outFile)
        return
    end

    #<p>
    # Emit an <tt>itemize</tt> environment.
    # <[param n a BulletList node]>
    #</p>
    method visitBulletList(n)
        write(outFile, "\\begin{itemize}")
        every (!n.getChildren()).accept(self)
        write(outFile, "\\end{itemize}")
        return
    end

    #<p>
    # Emit an <tt>enumerate</tt> environment (start index ignored).
    # <[param n an EnumList node]>
    #</p>
    method visitEnumList(n)
        write(outFile, "\\begin{enumerate}")
        # startAt > 1: enumerate package would help; keep simple
        every (!n.getChildren()).accept(self)
        write(outFile, "\\end{enumerate}")
        return
    end

    #<p>
    # Emit a <tt>\\item</tt> and its children.
    # <[param n a ListItem node]>
    #</p>
    method visitListItem(n)
        write(outFile, "\\item ")
        every (!n.getChildren()).accept(self)
        write(outFile)
        return
    end

    #<p>
    # Emit a full-width shaded <tt>Verbatim</tt> sample. Word often
    # left-indents CodeBlock; <tt>resetmargins</tt> plus
    # <tt>uscribeshaded</tt> (framed <tt>shaded</tt> when present)
    # keep the box on the text block, including inside lists.
    # <[param n a CodeBlock node]>
    #</p>
    method visitCodeBlock(n)
        local ln
        write(outFile, "\\begin{uscribeshaded}")
        write(outFile, "\\begin{Verbatim}[fontsize=\\small,frame=none,",
              "resetmargins=true,commandchars=", "\\\\", "\\{", "\\}", "]")
        every ln := !n.getLines() do
            write(outFile, escapeVerbatimLine(ln))
        write(outFile, "\\end{Verbatim}")
        write(outFile, "\\end{uscribeshaded}")
        write(outFile)
        return
    end

    #<p>
    # Emit an admonition as a bold kind label inside a <tt>quote</tt>.
    # <[param n an Admonition node]>
    #</p>
    method visitAdmonition(n)
        write(outFile, "\\begin{quote}")
        write(outFile, "\\textbf{", escapeLatex(capitalize(n.getKind())), ".}")
        write(outFile)
        every (!n.getChildren()).accept(self)
        write(outFile, "\\end{quote}")
        write(outFile)
        return
    end

    #<p>
    # Emit a CLI command signature in <tt>texttt</tt>, then the body.
    # <[param n a CliCmd node]>
    #</p>
    method visitCliCmd(n)
        write(outFile, "\\par\\noindent\\texttt{",
              escapeLatexTT(n.getSignature()), "}\\par")
        write(outFile)
        if *n.getChildren() > 0 then {
            write(outFile, "\\begin{quote}")
            every (!n.getChildren()).accept(self)
            write(outFile, "\\end{quote}")
            }
        return
    end

    #<p>
    # Emit a <tt>longtable</tt> (page-breakable) for a table, using
    # wrapping <tt>p</tt> columns sized to <tt>\\textwidth</tt> so
    # long <tt>\\texttt</tt> identifiers and prose do not overflow the
    # page. Spans use <tt>\\multicolumn</tt> / <tt>\\multirow</tt>.
    # <[param n a Table node]>
    #</p>
    method visitTable(n)
        local ncols, row, i
        ncols := tableColumnCount(n)
        tableNcols := ncols
        writes(outFile, "\\begin{longtable}{")
        every i := 1 to ncols do
            writes(outFile, latexTableColSpec(1, ncols))
        write(outFile, "}")
        if \n.getCaption() then {
            if numberedCaption(n.getCaption()) then
                write(outFile, "\\uscribecaptionstar{", escapeLatex(n.getCaption()),
                      "} \\\\")
            else
                write(outFile, "\\caption{", escapeLatex(n.getCaption()),
                      "} \\\\")
            }
        write(outFile, "\\hline")
        if \n.getHeaderRow() then {
            writeLatexTableRow(n.getHeaderRow())
            write(outFile, "\\hline")
            write(outFile, "\\endfirsthead")
            write(outFile, "\\hline")
            writeLatexTableRow(n.getHeaderRow())
            write(outFile, "\\hline")
            write(outFile, "\\endhead")
            write(outFile, "\\hline")
            write(outFile, "\\endfoot")
            write(outFile, "\\hline")
            write(outFile, "\\endlastfoot")
            }
        every row := !n.getChildren() do
            writeLatexTableRow(row)
        if /n.getHeaderRow() then
            write(outFile, "\\hline")
        write(outFile, "\\end{longtable}")
        tableNcols := &null
        if \n.getLabel() then
            write(outFile, "\\label{", latexLabelId(n.getLabel()), "}")
        write(outFile)
        return
    end

    #<p>
    # One ragged-right paragraph column covering <tt>span</tt> of
    # <tt>ncols</tt> equal shares of the text width after subtracting
    # <tt>2\\tabcolsep</tt> per column (and restoring inter-column
    # padding for multi-column spans).
    # <[param span column span (&gt;= 1)]>
    # <[param ncols total logical columns (&gt;= 1)]>
    # <[returns a LaTeX column-spec fragment]>
    #</p>
    method latexTableColSpec(span, ncols)
        local n, s
        n := \ncols | 1
        if n < 1 then
            n := 1
        s := \span | 1
        if s < 1 then
            s := 1
        if s > n then
            s := n
        # (textwidth - 2*tabcolsep*n) * s/n + 2*tabcolsep*(s-1)
        return ">{\\raggedright\\sloppy\\arraybackslash}p{\\dimexpr(" ||
               "\\textwidth-2\\tabcolsep*" || n || ")*" || s || "/" || n ||
               "+2\\tabcolsep*(" || s || "-1)\\relax}"
    end

    #<p>
    # Unused for LaTeX tables (rows are written by
    # <tt>writeLatexTableRow</tt>); kept for the visitor interface.
    # <[param n a TableRow node]>
    #</p>
    method visitTableRow(n)
        return
    end

    #<p>
    # Unused for LaTeX tables; kept for the visitor interface.
    # <[param n a TableCell node]>
    #</p>
    method visitTableCell(n)
        return
    end

    #<p>
    # Emit a <tt>description</tt> environment.
    # <[param n a DefinitionList node]>
    #</p>
    method visitDefinitionList(n)
        write(outFile, "\\begin{description}")
        every (!n.getChildren()).accept(self)
        write(outFile, "\\end{description}")
        write(outFile)
        return
    end

    #<p>
    # Emit one <tt>\\item[term]</tt> plus definition body.
    # <[param n a DefinitionItem node]>
    #</p>
    method visitDefinitionItem(n)
        write(outFile, "\\item[", escapeLatex(n.getTerm()), "]")
        every (!n.getChildren()).accept(self)
        return
    end

    #<p>
    # Logical column count for a table (sum of colspans on the header
    # or first body row).
    # <[param n a Table node]>
    # <[returns an integer &gt;= 1]>
    #</p>
    method tableColumnCount(n)
        local row, cell, ncols
        ncols := 0
        row := \n.getHeaderRow() | {
            if *n.getChildren() > 0 then
                n.getChildren()[1]
            else
                &null
            }
        if /row then
            return 1
        every cell := !row.getChildren() do
            ncols +:= cell.getColSpan()
        if ncols < 1 then
            ncols := 1
        return ncols
    end

    #<p>
    # Write one table row as <tt>cell & cell \\\\</tt>, wrapping
    # spans with <tt>\\multicolumn</tt> / <tt>\\multirow</tt>.
    # Multicolumn specs use the same wrapping <tt>p</tt> widths as
    # <tt>visitTable</tt>.
    # <[param row a TableRow node]>
    #</p>
    method writeLatexTableRow(row)
        local cell, first, cs, rs, ncols, colspec
        ncols := \tableNcols | 1
        first := 1
        every cell := !row.getChildren() do {
            if \first then
                first := &null
            else
                writes(outFile, " & ")
            cs := cell.getColSpan()
            rs := cell.getRowSpan()
            colspec := latexTableColSpec(cs, ncols)
            if cs > 1 & rs > 1 then
                writes(outFile, "\\multicolumn{", cs, "}{", colspec,
                       "}{\\multirow{", rs, "}{*}{")
            else if cs > 1 then
                writes(outFile, "\\multicolumn{", cs, "}{", colspec, "}{")
            else if rs > 1 then
                writes(outFile, "\\multirow{", rs, "}{*}{")
            every (!cell.getChildren()).accept(self)
            if cs > 1 & rs > 1 then
                writes(outFile, "}}")
            else if cs > 1 | rs > 1 then
                writes(outFile, "}")
            }
        write(outFile, " \\\\")
        return
    end

    #<p>
    # Emit a <tt>figure</tt> with <tt>\\includegraphics</tt>, or a
    # placeholder box for SVG (with a warning on <tt>&errout</tt>).
    # <[param n an Image node]>
    #</p>
    method visitImage(n)
        local uri, alt, cap
        uri := n.getURI()
        alt := \n.getAlt() | ""
        cap := \n.getCaption() | ""
        # pdflatex/xelatex need PDF/PNG/JPEG; SVG is noted as a placeholder
        if *uri >= 4 & map(uri[*uri-3:0], &ucase, &lcase) == ".svg" then {
            write(outFile, "\\begin{center}\\fbox{\\parbox{0.9\\linewidth}{")
            write(outFile, "\\textit{[figure: ", escapeLatex(uri))
            if *cap > 0 then
                write(outFile, " - ", escapeLatex(cap))
            write(outFile, " (SVG: convert to PDF/PNG for TeX)]}")
            write(outFile, "}\\end{center}")
            if \n.getLabel() then
                write(outFile, "\\label{", latexLabelId(n.getLabel()), "}")
            write(&errout, "warning: SVG not embedded in LaTeX: ", uri)
            }
        else if n.isFigureNode() | *cap > 0 then {
            write(outFile, "\\begin{figure}[htbp]")
            write(outFile, "\\centering")
            write(outFile, "\\includegraphics[width=0.9\\linewidth]{",
                  escapeLatexPath(uri), "}")
            if *cap > 0 then {
                if numberedCaption(cap) then
                    write(outFile, "\\uscribecaptionstar{", escapeLatex(cap), "}")
                else
                    write(outFile, "\\caption{", escapeLatex(cap), "}")
                }
            if \n.getLabel() then
                write(outFile, "\\label{", latexLabelId(n.getLabel()), "}")
            write(outFile, "\\end{figure}")
            }
        else {
            write(outFile, "\\begin{center}")
            write(outFile, "\\includegraphics[width=0.9\\linewidth]{",
                  escapeLatexPath(uri), "}")
            write(outFile, "\\end{center}")
            if \n.getLabel() then
                write(outFile, "\\label{", latexLabelId(n.getLabel()), "}")
            }
        write(outFile)
        return
    end

    #<p>
    # Emit a LaTeX comment for an unhandled directive.
    # <[param n a RawDirective node]>
    #</p>
    method visitRawDirective(n)
        write(outFile, "% unhandled directive: ", n.getName())
        write(outFile)
        return
    end

    #<p>
    # Write escaped prose text (no trailing newline).
    # <[param n a Text node]>
    #</p>
    method visitText(n)
        writes(outFile, escapeLatex(n.getText()))
        return
    end

    #<p>
    # Emit <tt>\\emph{...}</tt> around inline children.
    # <[param n an Emphasis node]>
    #</p>
    method visitEmphasis(n)
        writes(outFile, "\\emph{")
        every (!n.getChildren()).accept(self)
        writes(outFile, "}")
        return
    end

    #<p>
    # Emit <tt>\\textbf{...}</tt> around inline children.
    # <[param n a Strong node]>
    #</p>
    method visitStrong(n)
        writes(outFile, "\\textbf{")
        every (!n.getChildren()).accept(self)
        writes(outFile, "}")
        return
    end

    #<p>
    # Emit <tt>\\texttt{...}</tt> with <tt>escapeLatexTT</tt>.
    # <[param n a Literal node]>
    #</p>
    method visitLiteral(n)
        writes(outFile, "\\texttt{", escapeLatexTT(n.getText()), "}")
        return
    end

    #<p>
    # Emit <tt>\\hyperref[id]{text}</tt> for a resolved xref.
    # <[param n a Reference node]>
    #</p>
    method visitReference(n)
        local id, fileBase
        fileBase := \n.getTargetFile() | ""
        if *fileBase >= 5 & fileBase[*fileBase-4:0] == ".html" then
            fileBase := fileBase[1:*fileBase-4]
        id := latexLabelId(fileBase, \n.getTargetAnchor() | "")
        writes(outFile, "\\hyperref[", id, "]{",
               escapeLatex(n.getText()), "}")
        return
    end

    #<p>
    # Emit a bold <tt>[?label?]</tt> marker and warn on <tt>&errout</tt>.
    # <[param n an unresolved xref node]>
    #</p>
    method visitBrokenXref(n)
        writes(outFile, "\\textbf{[?}", escapeLatex(n.getLabel()), "?]}")
        write(&errout, "warning: unresolved xref '", n.getLabel(), "'")
        return
    end

    #<p>
    # Emit <tt>\\href{uri}{text}</tt>.
    # <[param n a Hyperlink node]>
    #</p>
    method visitHyperlink(n)
        writes(outFile, "\\href{", escapeLatexPath(n.getURI()), "}{",
               escapeLatex(n.getText()), "}")
        return
    end

    #<p>
    # Emit <tt>\\textsubscript</tt> / <tt>\\textsuperscript</tt>.
    # <[param n a ScriptText node]>
    #</p>
    method visitScriptText(n)
        if n.getKind() == "sup" then
            writes(outFile, "\\textsuperscript{",
                   escapeLatex(n.getText()), "}")
        else
            writes(outFile, "\\textsubscript{",
                   escapeLatex(n.getText()), "}")
        return
    end

    #<p>
    # Emit raw LaTeX lines when format is <tt>latex</tt>; ignore otherwise.
    # <[param n a RawBlock node]>
    #</p>
    method visitRawBlock(n)
        local ln
        if map(n.getFormat(), &ucase, &lcase) ~== "latex" then
            return
        every ln := !n.getLines() do
            write(outFile, ln)
        return
    end

    #<p>
    # Emit numeric citations <tt>[1]</tt> / <tt>[1,2]</tt>.
    # <[param n a Cite node]>
    #</p>
    method visitCite(n)
        local key, num, first
        writes(outFile, "[")
        first := 1
        every key := !n.getKeys() do {
            num := &null
            if \citationTable then
                num := citationTable.getNumber(key)
            if /first then writes(outFile, ",")
            if /num then {
                writes(outFile, "?", escapeLatex(key), "?")
                write(&errout, "warning: unknown citation '", key, "'")
                }
            else
                writes(outFile, string(num))
            first := &null
            }
        writes(outFile, "]")
        return
    end

    #<p>
    # Emit a simple <tt>thebibliography</tt>-style list of cited works.
    # <[param n a Bibliography node]>
    #</p>
    method visitBibliography(n)
        local key, entry, num
        write(outFile, "\\begin{thebibliography}{99}")
        if \citationTable then
            every key := !citationTable.getOrderedKeys() do {
                num := citationTable.getNumber(key)
                entry := citationTable.getEntry(key)
                write(outFile, "\\bibitem[", string(num), "]{",
                      latexLabelId("cite", slugify(key)), "}")
                if \entry then
                    write(outFile, escapeLatex(formatBibEntry(key, entry)))
                else {
                    write(outFile, "\\textbf{[?}", escapeLatex(key), "?]}")
                    write(&errout, "warning: no bib entry for '", key, "'")
                    }
                write(outFile)
                }
        write(outFile, "\\end{thebibliography}")
        return
    end

    #<p>
    # Emit <tt>\\footnote{...}</tt>.
    # <[param n a Footnote node]>
    #</p>
    method visitFootnote(n)
        writes(outFile, "\\footnote{", escapeLatex(n.getBody()), "}")
        return
    end

    #<p>
    # Emit inline <tt>\\(...\\)</tt> or display <tt>\\[...\\]</tt> math.
    # <[param n a Math node]>
    #</p>
    method visitMath(n)
        if n.isDisplay() then {
            write(outFile)
            write(outFile, "\\[", n.getLatex(), "\\]")
            write(outFile)
            }
        else
            writes(outFile, "\\(", n.getLatex(), "\\)")
        return
    end

    #<p>
    # Write a section title that may contain inline markup via
    # <tt>parseInline()</tt>.
    # <[param titleText raw title string]>
    #</p>
    method writeInlineTitle(titleText)
        local piece
        every piece := !parseInline(titleText) do
            piece.accept(self)
        return
    end

    #<p>
    # Anchor id for a section: explicit label if set, else
    # <tt>slugify</tt> of the title.
    # <[param sectionNode a Section node]>
    # <[returns anchor string]>
    #</p>
    method anchorFor(sectionNode)
        return \sectionNode.getLabel() | slugify(sectionNode.getTitle())
    end
end

#<p>
# Escape <tt>\ { }</tt> for fancyvrb when <tt>commandchars=\\\{\}</tt>
# is set, so a source line <tt>\end{Verbatim}</tt> is typeset literally
# and does not terminate the environment.
# <[param s input line, or null treated as empty]>
# <[returns escaped line]>
#</p>
procedure escapeVerbatimLine(s)
    local out, c
    s := normalizeLatexUnicode(\s | "")
    out := ""
    every c := !s do
        out ||:= case c of {
            "\\": "\\\\"
            "{": "\\{"
            "}": "\\}"
            default: c
            }
    return out
end

#<p>
# Escape a filesystem path for <tt>\\includegraphics{...}</tt>. Unlike
# prose escaping, this keeps characters that are legal in filenames
# (e.g. <tt>_</tt>) and only neutralizes tokens that break TeX while
# reading the <tt>.tex</tt> line: <tt>%</tt> (line comment), <tt>#</tt>,
# braces, tilde, caret (blocks <tt>^^xx</tt> character-code decoding),
# and backslash (normalized to <tt>/</tt>).
# <[param s image path, or null treated as empty]>
# <[returns path safe to embed in <tt>\\includegraphics{...}</tt>]>
#</p>
procedure escapeLatexPath(s)
    local out, c
    /s := ""
    out := ""
    every c := !s do
        out ||:= case c of {
            "%": "\\%"
            "#": "\\#"
            "{": "\\{"
            "}": "\\}"
            "~": "\\string~"
            "^": "\\textasciicircum{}"
            "\\": "/"
            default: c
            }
    return out
end

#<p>
# Escape text for ordinary LaTeX prose (not verbatim, not
# <tt>\\verb</tt>). Normalizes a few Unicode punctuation marks first.
# <[param s input string, or null treated as empty]>
# <[returns escaped string]>
#</p>
#<p>
# Normalize Unicode punctuation (and a few legacy bytes) to forms
# <tt>pdflatex</tt> can typeset. Shared by prose, <tt>\\texttt</tt>, and
# Verbatim escapers.
# <[param s input string, or null treated as empty]>
# <[returns normalized string]>
#</p>
procedure normalizeLatexUnicode(s)
    local rest, pair, fromStr, toStr
    static uMap
    initial {
        # Keys are char() bytes, not UTF-8 source literals: a uniqual
        # key makes *fromStr a codepoint count, and move(*fromStr) then
        # leaves leftover UTF-8 bytes in the subject.
        uMap := [
            [char(226) || char(128) || char(148), "---"],  # U+2014 em dash
            [char(226) || char(128) || char(147), "--"],   # U+2013 en dash
            [char(226) || char(136) || char(146), "-"],    # U+2212 minus
            [char(226) || char(136) || char(151), "*"],    # U+2217 asterisk
            [char(204) || char(131), "~"],                 # U+0303 tilde
            [char(226) || char(128) || char(156), "``"],   # U+201C
            [char(226) || char(128) || char(157), "''"],   # U+201D
            [char(226) || char(128) || char(152), "`"],    # U+2018
            [char(226) || char(128) || char(153), "'"],    # U+2019
            [char(226) || char(128) || char(166), "..."],  # U+2026 ellipsis
            [char(226) || char(134) || char(146), "->"],   # U+2192 arrow
            [char(194) || char(169), "(c)"],              # U+00A9 copyright
            # C1 controls U+0091..U+0094 as UTF-8 (byte-wise Unicon
            # builds). Do not map bare char(0x9x): that splits
            # multi-byte UTF-8 sequences.
            [char(194) || char(147), "``"],
            [char(194) || char(148), "''"],
            [char(194) || char(145), "`"],
            [char(194) || char(146), "'"],
            [char(15), ""]
            ]
        }
    /s := ""
    every pair := !uMap do {
        fromStr := pair[1]
        toStr := pair[2]
        rest := ""
        s ? {
            while rest ||:= tab(find(fromStr)) do {
                rest ||:= toStr
                move(*fromStr)
                }
            rest ||:= tab(0)
            }
        s := rest
        }
    return s
end

#<p>
# Escape text for ordinary LaTeX prose (not verbatim, not
# <tt>\\verb</tt>). Normalizes a few Unicode punctuation marks first.
# <[param s input string, or null treated as empty]>
# <[returns escaped string]>
#</p>
procedure escapeLatex(s)
    local out, c
    s := normalizeLatexUnicode(\s | "")
    out := ""
    every c := !s do
        out ||:= case c of {
            "\\": "\\textbackslash{}"
            "{": "\\{"
            "}": "\\}"
            "$": "\\$"
            "&": "\\&"
            "%": "\\%"
            "#": "\\#"
            "^": "\\textasciicircum{}"
            "_": "\\_"
            "~": "\\textasciitilde{}"
            default: c
            }
    return out
end

#<p>
# Escape for <tt>\\texttt{...}</tt>: same specials as
# <tt>escapeLatex</tt>, plus spaces become <tt>~</tt>. Underscores
# and commas get <tt>\\allowbreak{}</tt> so long identifiers and
# comma-separated name lists can wrap inside table <tt>p</tt>
# columns without overflowing the page. Slashes, hyphens, dots,
# and <tt>@</tt> get the same break. The empty group stops TeX
# from gluing the next letter into the control-word name.
# <[param s input string, or null treated as empty]>
# <[returns escaped string]>
#</p>
procedure escapeLatexTT(s)
    local out, c
    s := normalizeLatexUnicode(\s | "")
    out := ""
    every c := !s do
        out ||:= case c of {
            "\\": "\\textbackslash{}"
            "{": "\\{"
            "}": "\\}"
            "$": "\\$"
            "&": "\\&"
            "%": "\\%"
            "#": "\\#"
            "^": "\\textasciicircum{}"
            "_": "\\_\\allowbreak{}"
            ",": ",\\allowbreak{}"
            "/": "/\\allowbreak{}"
            "-": "-\\allowbreak{}"
            ".": ".\\allowbreak{}"
            "@": "@\\allowbreak{}"
            "~": "\\textasciitilde{}"
            " ": "~"
            default: c
            }
    return out
end

#<p>
# Build a hyperref-safe <tt>\\label</tt> / <tt>\\hyperref</tt> id from
# chapter basename and section anchor (e.g. <tt>intro</tt> +
# <tt>networking</tt> → <tt>intro-networking</tt>). Non-alphanumeric
# characters become <tt>-</tt>.
# <[param chapBase chapter basename, or null for "chap"]>
# <[param anchor section anchor, or null for "top"]>
# <[returns sanitized id string]>
#</p>
procedure latexLabelId(chapBase, anchor)
    local s, out, c, ok
    s := (\chapBase | "chap") || "-" || (\anchor | "top")
    ok := &letters ++ &digits ++ '-.'
    out := ""
    every c := !s do {
        if any(ok, c) then
            out ||:= c
        else
            out ||:= "-"
        }
    return out
end
