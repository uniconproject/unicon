link glsnap
procedure main()
   w := open("prims","gl","size=320,240","bg=black") | stop("open: ",&errortext)
   Fg(w,"red");    DrawCube(w,-0.8,0.4,-3.0,0.5)
   Fg(w,"green");  DrawSphere(w,0.0,0.4,-3.0,0.3)
   Fg(w,"blue");   DrawCylinder(w,0.8,0.2,-3.0,0.4,0.2,0.2)
   Fg(w,"yellow"); DrawTorus(w,-0.6,-0.5,-3.0,0.1,0.3)
   Fg(w,"cyan");   DrawDisk(w,0.6,-0.5,-3.0,0.1,0.3)
   snap(w,"t01_prims")
end
