#<p>
# Reusable balanced-delimiter scanning, generalized from the pattern in
# classic UniDoc's <tt>UniHTML.icn</tt>: <tt>checkSpecial()</tt> +
# <tt>parseClause()</tt> used Icon's <tt>sbal()</tt> to find
# <tt>"&lt;[ ... ]&gt;"</tt> clauses embedded in running text while
# correctly skipping past <tt>&lt;pre&gt;</tt>/<tt>&lt;code&gt;</tt>
# blocks. That logic was hard-wired to HTML output and to UniDoc's own
# field names (<tt>throws</tt>, <tt>param</tt>, <tt>returns</tt>...).
# Here it is factored into a generic utility that both unidoc and
# uscribe can call.
#</p>
#<p>
# This file is in the <i>public domain</i>.
#</p>

package uscribe

# <p>
# Scan string <tt>s</tt> left to right. Whenever the literal
# <tt>openTok</tt> is found (outside of any span already excluded via
# <tt>skipSpans</tt>), extract the balanced substring up to the
# matching <tt>closeTok</tt> using <tt>sbal()</tt>, and call
# <tt>handler(matchedText)</tt> -- handler's return value is spliced
# into the output in place of the whole
# <tt>"openTok ... closeTok"</tt> run. If handler fails, the original
# text (<tt>openTok</tt> included) is passed through unchanged.
# <[param s the text to scan]>
# <[param openTok opening delimiter, e.g. <tt>"&lt;["</tt> or
#         <tt>"{{"</tt>]>
# <[param closeTok closing delimiter, e.g. <tt>"]&gt;"</tt> or
#         <tt>"}}"</tt>]>
# <[param handler procedure(<tt>matchedInnerText</tt>) -> replacement
#         string]>
# <[param skipSpans a table mapping <tt>"startTok"</tt> ->
#         <tt>"endTok"</tt> for regions to pass through verbatim
#         without scanning inside them, e.g.
#         <tt>table("&lt;pre&gt;","&lt;/pre&gt;","&lt;code&gt;","&lt;/code&gt;")</tt>
#         -- pass <tt>&null</tt> or an empty table to scan everything]>
# <[returns the fully scanned/replaced string]>
# </p>
procedure scanBalancedDirectives(s, openTok, closeTok, handler, skipSpans)
    local out, cMap, skipDepth, tok, matched, replacement

    cMap := table()
    cMap[openTok] := closeTok
    /skipSpans := table()
    skipDepth := table()
    every skipDepth[key(skipSpans)] := 0

    out := ""
    s ? {
        while out ||:= tab(find(openTok) | 0) do {
            if pos(0) then break

            # Check for any registered skip-span open/close tokens
            # right here before considering openTok itself.
            tok := findAnySkipToken("" || &subject[&pos:0], skipSpans)
            if \tok then {
                out ||:= move(*tok)
                if member(skipSpans, tok) then
                    skipDepth[tok] +:= 1
                else
                    every (k := key(skipSpans)) do
                        if skipSpans[k] == tok then skipDepth[k] := decrFloor(skipDepth[k])
                next
                }

            if anySkipActive(skipDepth) then {
                out ||:= move(*openTok)
                next
                }

            if matched := sbal(cMap, openTok, closeTok, 'openTok') then {
                # sbal() semantics vary by Icon/Unicon version; the
                # wrapper sbalClause() below pins down the exact call
                # uscribe relies on. See sbalClause().
                }
            if replacement := handler(matched) then
                out ||:= replacement
            else
                out ||:= openTok || matched || closeTok
            }
        out ||:= tab(0)
        }
    return out
end

# <p>
# Version of the balanced-clause extraction that matches exactly how
# classic UniDoc used <tt>sbal()</tt> in <tt>UniHTML.icn</tt>'s
# <tt>checkSpecial()</tt>: the subject is already positioned just
# after <tt>openTok</tt>, and <tt>sbal()</tt> with a one-entry map
# keyed on <tt>openTok</tt> is used to consume up through the matching
# <tt>closeTok</tt>, respecting nested opens.
# <[param cMap a table with a single key:
#         <tt>cMap[openTok] = closeTok</tt>]>
# <[returns the inner text (delimiters stripped)]>
# <[fails if the input at the current position is not a valid
#         balanced clause]>
# </p>
procedure sbalClause(cMap)
    local inner
    if inner := sbal(cMap) then
        return inner
    fail
end

# <p>
# Internal: does any string in the skip-span table (as open or close
# token) appear at the very start of the remaining subject?
# <[param rest the unscanned remainder of the subject]>
# <[param skipSpans table of open-token -> close-token pairs]>
# <[returns the matched open or close token string]>
# <[fails if no skip token is at the start of <tt>rest</tt>]>
# </p>
procedure findAnySkipToken(rest, skipSpans)
    local k
    every k := key(skipSpans) do {
        if rest[1:1+*k] == k then return k
        if rest[1:1+*skipSpans[k]] == skipSpans[k] then return skipSpans[k]
        }
    fail
end

# <p>
# Internal: succeed if we are currently inside any registered skip
# span (any entry in <tt>skipDepth</tt> is positive).
# <[param skipDepth table of open-token -> nesting depth]>
# <[fails if no skip span is active]>
# </p>
procedure anySkipActive(skipDepth)
    local k
    every k := key(skipDepth) do
        if skipDepth[k] > 0 then return
    fail
end

# <p>
# Decrement <tt>n</tt> by one, flooring at zero.
# <[param n a non-negative integer depth]>
# <[returns <tt>n - 1</tt>, or 0 if <tt>n</tt> was already 0]>
# </p>
procedure decrFloor(n)
    return (n > 0, n - 1) | 0
end
