  pkgdesc='Unicon ui and ivib'
  depends=('unicon-runtime')
  move_path "$srcdir/stage-gfx" usr/bin/ui
  move_path "$srcdir/stage-gfx" usr/bin/ivib
  install_license unicon-ui
}
