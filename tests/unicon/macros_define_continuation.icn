# Object-like $define: continue only when \ is the very last character (C splice).
# Spaces before \ and on the next line are kept in the replacement text.
$define GREETING "hello " || \
"there"
$define SUMCONT(a,b) ((a) + \
(b))
$define SPACED "hello" || \
   " world"

procedure main()
   write(GREETING)
   write(SUMCONT(2, 3))
   write(SPACED)
end
