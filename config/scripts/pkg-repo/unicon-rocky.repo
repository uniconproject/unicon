[unicon-dev]
name=Unicon dev (master snapshots)
baseurl=https://rpm.unicon.org/unicon/dev/rocky/$releasever/$basearch/
enabled=0
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://rpm.unicon.org/RPM-GPG-KEY-unicon

[unicon-rc]
name=Unicon release candidates
baseurl=https://rpm.unicon.org/unicon/rc/rocky/$releasever/$basearch/
enabled=0
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://rpm.unicon.org/RPM-GPG-KEY-unicon

[unicon-stable]
name=Unicon stable (latest release)
baseurl=https://rpm.unicon.org/unicon/stable/rocky/$releasever/$basearch/
enabled=0
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://rpm.unicon.org/RPM-GPG-KEY-unicon

[unicon-13.3]
name=Unicon 13.3
baseurl=https://rpm.unicon.org/unicon/13.3/rocky/$releasever/$basearch/
enabled=0
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://rpm.unicon.org/RPM-GPG-KEY-unicon

[unicon-nographics-dev]
