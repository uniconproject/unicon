# Neither __debug__ nor __test__: assert and assert_not expand to &null,
# so they still work as the then-part of an if.

procedure main()
   local x
   x := 1
   if x = 1 then assert(x = 2) else write("wrong branch")
   if x = 2 then write("wrong branch") else assert_not(x = 1, "ignored")
   write("release ok")
end
