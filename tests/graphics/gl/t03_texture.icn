link glsnap
procedure main()
   w := open("tex","gl","size=320,240","bg=gray") | stop("open: ",&errortext)
   Texture(w,"unicon.gif") | stop("Texture failed: ",&errortext)
   Texcoord(w, 0.0,0.0, 0.0,1.0, 1.0,1.0, 1.0,0.0)
   FillPolygon(w, -1.0,-0.7,-3.0, -1.0,0.7,-3.0, 0.2,0.7,-3.0, 0.2,-0.7,-3.0)
   WAttrib(w,"texmode=off")
   Fg(w,"red"); DrawSphere(w,0.7,0,-3,0.3)
   snap(w,"t03_texture")
end
