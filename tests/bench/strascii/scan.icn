# Scanning: move(1) across an untagged ASCII &subject.
$include "common.icn"

procedure main(argv)
   local n, s, sink, t0
   n := iters(argv, 16000)
   s := ascii(5000)
   sink := 0
   t0 := stamp()
   every 1 to n do
      s ? {
         while move(1) do
            sink +:= 1
         }
   report_elapsed("scan", n, t0)
   if sink <= 0 then
      stop("checksum failed")
end
