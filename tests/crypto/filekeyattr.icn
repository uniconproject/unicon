#
# File transform with key= path attribute (no separate key handle).
#

procedure main()
   local f, plaintext

   f := open("data/via-attr.dat", "we", "op=encrypt",
             "cipher=aes-256-gcm", "key=data/aes.key") |
      stop("open we key= failed: ", &errortext)
   writes(f, "via-attr")
   close(f) | stop("close we failed: ", &errortext)

   f := open("data/via-attr.dat", "re", "op=decrypt",
             "cipher=aes-256-gcm", "key=data/aes.key") |
      stop("open re key= failed: ", &errortext)
   # read() drains the whole file and verifies the AEAD tag.
   plaintext := read(f) | stop("decrypt failed: ", &errortext)
   if plaintext == "via-attr" then
      write("filekeyattr:ok")
   else
      write("filekeyattr:fail")
   close(f)
end
