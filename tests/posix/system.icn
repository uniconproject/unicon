#
# system.icn: test system() function.
# TODO: expand to test system() parameters and more exotic features.
#
# Note: doing a unicon compile would have a temp filename difference.
#
# The translator is icont, or unicont when configured with --enable-uniconx.
# An in-tree build is preferred. ICONT overrides both. After a package
# install the in-tree binary is gone, so fall back to PATH.


link io
procedure main()
   local icont
   icont := translator()
   remove("foo.out")
   f := open("x.icn","w")
   write(f,"procedure main()")
   write(f,"   write(\"hello world\")")
   write(f,"end")
   close(f)
   #
   # change format of command use the file redirection as given below
   # this was a cause of error difference between what is expected and
   # what was actually obtained
   #
$ifdef _MS_WINDOWS_NT
   system(icont || " x.icn > foo.out 2>&1")
$else
   system(icont || " x.icn &>foo.out")
$endif
   fin := open("foo.out") | stop("can't open foo.out for reading")
   every write(!fin)
   close(fin)

   remove("foo.out")
   remove("x.icn")
   #
   # add following remove command to remove the generated executable file,
   # this non-removal caused a problem in Makefile
   #
$ifdef _MS_WINDOWS_NT
   remove("x.exe")
$else
   remove("x")
$endif
   write("...done")
end

# icont or unicont, whichever this build installed.
procedure translator()
   local exe, name, cmd
   if cmd := getenv("ICONT") then return cmd
   exe := ""
$ifdef _MS_WINDOWS_NT
   exe := ".exe"
$endif
   every name := !["unicont", "icont"] do
      if exists("../../bin/" || name || exe) then
         return "../../bin/" || name || exe
   every name := !["unicont", "icont"] do
      if cmd := pathfind(name) then return cmd
   return "icont" || exe
end
