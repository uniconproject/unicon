  pkgdesc='Unicon dependency lister'
  depends=('unicon-vm')
  move_path "$srcdir/stage-gfx" usr/bin/unidep
  move_path "$srcdir/stage-gfx" usr/lib/unicon/uni/unidep
  install_license unicon-unidep
}

