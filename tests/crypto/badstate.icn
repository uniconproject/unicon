#
# Digest state= is unsupported with OpenSSL 3 (no MD_CTX export).
#

procedure main()
   local hasher

   hasher := open("sha256", "eh") | stop("open: ", &errortext)
   write(hasher, "abc")
   if Attrib(hasher, "state") then
      write("state-get:fail")
   else
      write("state-get:ok")
   if Attrib(hasher, "state=not-a-real-blob") then
      write("state-set:fail")
   else
      write("state-set:ok")
   close(hasher)
end
