# Native SSH client support (open() mode "h" / "hc" / "hs", libssh-backed).
#
# This test is deterministic and needs no SSH server for its default run:
# it checks the _SSH feature is present and that the error paths fail
# cleanly with &errortext set.  A full round-trip against a real server
# is exercised only when UNICON_SSH_TESTHOST is set (host or user@host);
# see the header of live_test() for the other UNICON_SSH_* variables.

procedure main()
   write("feature _SSH: ", if &features == "secure shell" then "yes" else "no")

   # A bad attribute must fail (not abort) with &errortext set.
   f := open("nobody@127.0.0.1", "h", "bogus=1")
   write("bad-attribute open fails: ", failed_with_text(f))

   # channel= must be yes/no; other values are bad attributes.
   f := open("nobody@127.0.0.1", "h", "channel=maybe")
   write("bad-channel open fails: ", failed_with_text(f))

   # verifyPeer= is the TLS spelling of mode '-'; values are yes/no.
   f := open("nobody@127.0.0.1", "h", "verifyPeer=maybe")
   write("bad-verifyPeer open fails: ", failed_with_text(f))

   # channel=no with cmd= is contradictory (mode "hc" selects a channel).
   f := open("nobody@127.0.0.1", "hc", "channel=no", "cmd=true")
   write("channel=no+cmd open fails: ", failed_with_text(f))

   # cmd= requires mode "hc", not plain "h".
   f := open("nobody@127.0.0.1", "h", "cmd=true")
   write("cmd-without-c open fails: ", failed_with_text(f))

   # env= takes NAME=VALUE: a value without a name or '=' is a bad attribute.
   f := open("nobody@127.0.0.1", "hc", "cmd=true", "env=NOVALUE")
   write("env-without-equals open fails: ", failed_bad_attribute(f))
   f := open("nobody@127.0.0.1", "hc", "cmd=true", "env==x")
   write("env-without-name open fails: ", failed_bad_attribute(f))

   # env= sets variables on a channel, so it contradicts channel=no.
   f := open("nobody@127.0.0.1", "h", "channel=no", "env=A=b")
   write("channel=no+env open fails: ", failed_bad_attribute(f))

   # A value may be empty or end in '=' (base64): the open gets as far
   # as connecting, which fails on the closed port.
   f := open("nobody@127.0.0.1:1", "hc", "cmd=true", "env=A=", "env=B=YWJjZA==")
   write("env-value-ending-in-equals accepted: ",
         if /f & not find("bad ssh attribute", &errortext) then "yes" else "no")

   # Connecting to a closed local port must fail with &errortext set.
   f := open("nobody@127.0.0.1:1", "hc", "cmd=true")
   write("connect-refused open fails: ", failed_with_text(f))

   live_test()
   write("ssh test done")
end

# Report "yes" when open() failed (produced &null) and left a &errortext.
procedure failed_with_text(f)
   if /f & (*&errortext > 0) then return "yes"
   if \f then close(f)
   return "no"
end

# Report "yes" when open() failed because of a bad attribute.
procedure failed_bad_attribute(f)
   if /f & find("bad ssh attribute", &errortext) then return "yes"
   if \f then close(f)
   return "no"
end

# Build open() argv for addr (host or user@host[:port]).
# Mode is "h-" / "hc-" when no known_hosts file is provided.
procedure ssh_opts(addr, mode, attrs[])
   local opts, key, kh, a
   opts := [addr, mode]
   every a := !attrs do put(opts, a)
   if key := getenv("UNICON_SSH_TESTKEY") then put(opts, "key=" || key)
   if kh := getenv("UNICON_SSH_KNOWNHOSTS") then put(opts, "hostkeyfile=" || kh)
   else if not find("-", mode) then opts[2] := mode || "-"
   return opts
end

# Append :port from UNICON_SSH_TESTPORT when set (host should not already
# include a port in that case).
procedure ssh_addr(host)
   local p
   p := getenv("UNICON_SSH_TESTPORT") | {
      return host
      }
   return host || ":" || p
end

# Live round-trip, only when UNICON_SSH_TESTHOST is set:
#   UNICON_SSH_TESTHOST   host or user@host (optionally with :port)
#   UNICON_SSH_TESTPORT   appended as :port when set (libssh default 22)
#   UNICON_SSH_TESTKEY    private key path (else default identities/agent)
#   UNICON_SSH_KNOWNHOSTS known_hosts path (else host-key check is skipped)
#   UNICON_SSH_SFTPPATH   remote directory for SFTP checks (optional)
#   UNICON_SSH_ENVOK      a variable name the server accepts from clients
#                         (AcceptEnv); enables the env= checks (optional)
#   UNICON_SSH_TESTPASS   the user's password; enables the password= checks
#                         (optional).  Against a server that offers only
#                         keyboard-interactive (PasswordAuthentication no
#                         with PAM), these exercise keyboard-interactive.
procedure live_test()
   local host, addr, opts, s, line, got, c, info, remote, L, chunk, stray, m,
      first, e

   host := getenv("UNICON_SSH_TESTHOST") | {
      write("live round-trip: skipped (set UNICON_SSH_TESTHOST)")
      return
      }
   addr := ssh_addr(host)

   opts := ssh_opts(addr, "hc", "cmd=echo unicon_ssh_ok")
   s := open ! opts | {
      write("live round-trip: open failed: ", &errortext)
      return
      }
   got := ""
   while line := read(s) do got ||:= line
   write("live round-trip: ", if find("unicon_ssh_ok", got) then "pass" else "fail")
   write("live exit status: ", s["exitstatus"])
   close(s)

   # Second connection: receive() ordering + stderr/exit events
   opts := ssh_opts(addr, "hc", "cmd=echo out1; echo err1 1>&2; echo out2; exit 3")
   s := open ! opts | {
      write("live receive: open failed: ", &errortext)
      return
      }
   got := ""
   stray := &null
   while m := receive(s) do {
      # SSH events carry only type and msg; every other field is &null
      if \(m.addr | m.saddr | m.daddr | m.ttl | m.proto | m.sport | m.dport)
         then stray := 1
      got ||:= m.type || "=" || trim(m.msg, '\n') || ";"
      }
   write("live receive: ", if find("stdout=", got) & find("stderr=", got) &
      find("exitstatus=3", got) & /stray then "pass" else "fail")
   close(s)

   # receive(c, timeout): nothing for a while, then output
   opts := ssh_opts(addr, "hc", "cmd=sleep 1; echo late")
   s := open ! opts | {
      write("live receive timeout: open failed: ", &errortext)
      return
      }
   first := receive(s, 200) | &null      # times out: the command sleeps
   e := &errno
   m := receive(s, 5000) | &null
   write("live receive timeout: ", if /first & e ~= 0 & \m &
      m.type == "stdout" & trim(m.msg, '\n') == "late" then "pass" else "fail")
   close(s)

   #
   # Partial line via reads(): interactive prompts have no trailing
   # newline.  reads() on an SSH channel must return those bytes without
   # blocking for '\\n' (the old sock_getstrg path hung here).
   #
   opts := ssh_opts(addr, "hc", "cmd=printf 'partial_ssh_line'")
   s := open ! opts | {
      write("live partial-reads: open failed: ", &errortext)
      return
      }
   # Drain with a short select bound so a hang fails the suite instead
   # of wedging CI.  5s is generous for a local/LAN printf.
   got := ""
   every 1 to 50 do {
      L := select(s, 100) | break
      if *L = 0 then next
      chunk := reads(s, 64) | break
      got ||:= chunk
      if find("partial_ssh_line", got) then break
      }
   write("live partial-reads: ",
      if find("partial_ssh_line", got) then "pass" else "fail")
   close(s)

   env_test(addr)
   password_test(addr)

   #
   # Close channels before the server has sent their exit status, then
   # keep using the session: the late packets must not reach the closed
   # channels' state.
   #
   opts := ssh_opts(addr, "h", "channel=no")
   s := open ! opts | {
      write("live early close: open failed: ", &errortext)
      return
      }
   every 1 to 20 do {
      c := open(s, "hc", "cmd=sleep 0.02; echo late; exit 3") | break
      close(c)
      delay(30)
      }
   got := ""
   if c := open(s, "hc", "cmd=echo after_early_close") then {
      while m := receive(c, 5000) do
         if m.type == "stdout" then got ||:= m.msg
      close(c)
      }
   write("live early close: ",
      if find("after_early_close", got) then "pass" else "fail")
   close(s)

   # Optional SFTP checks when a remote writable directory is provided
   remote := getenv("UNICON_SSH_SFTPPATH") | {
      write("live sftp: skipped (set UNICON_SSH_SFTPPATH)")
      return
      }
   opts := ssh_opts(addr, "h", "channel=no")
   s := open ! opts | {
      write("live sftp: open failed: ", &errortext)
      return
      }
   c := open(s, "hs", "path=" || remote || "/unicon_ssh_bin.bin", "w") |
        stop("live sftp write-open failed: ", &errortext)
   writes(c, "\x00\x01\x02\n\xff") | stop("live sftp writes failed: ", &errortext)
   close(c)
   c := open(s, "hs", "path=" || remote || "/unicon_ssh_bin.bin") |
        stop("live sftp read-open failed: ", &errortext)
   got := reads(c, 5) | stop("live sftp reads failed: ", &errortext)
   close(c)
   write("live sftp binary: ",
      if got == "\x00\x01\x02\n\xff" then "pass" else "fail")
   info := stat(s, remote || "/unicon_ssh_bin.bin") |
           stop("live sftp stat failed: ", &errortext)
   write("live sftp stat size: ", if info.size = 5 then "pass" else "fail")
   remove(s, remote || "/unicon_ssh_bin.bin") |
      stop("live sftp remove failed: ", &errortext)
   write("live sftp remove: pass")
   close(s)
end

# env= on channels, only when UNICON_SSH_ENVOK names a variable the
# server accepts.  A variable it refuses must be ignored, not fail.
procedure env_test(addr)
   local name, opts, s, c, got

   name := getenv("UNICON_SSH_ENVOK") | {
      write("live env: skipped (set UNICON_SSH_ENVOK)")
      return
      }

   # repeatable, and the value keeps any further '=', also at its end
   opts := ssh_opts(addr, "hc", "cmd=printf '%s' \"$" || name || "\"",
                    "env=" || name || "=a=b:c==")
   s := open ! opts | {
      write("live env: open failed: ", &errortext)
      return
      }
   got := ""
   while got ||:= reads(s, 64)
   close(s)
   write("live env: ", if got == "a=b:c==" then "pass" else "fail")

   # a refused variable is ignored
   opts := ssh_opts(addr, "hc", "cmd=echo env_refused_ok",
                    "env=UNICON_SSH_NEVER_ACCEPTED_X=1")
   s := open ! opts | {
      write("live env refused: open failed: ", &errortext)
      return
      }
   got := ""
   while got ||:= reads(s, 64)
   close(s)
   write("live env refused: ",
      if find("env_refused_ok", got) then "pass" else "fail")

   # env= on a channel opened from a session
   opts := ssh_opts(addr, "h", "channel=no")
   s := open ! opts | {
      write("live env channel: open failed: ", &errortext)
      return
      }
   c := open(s, "hc", "cmd=printf '%s' \"$" || name || "\"",
             "env=" || name || "=from_session") | {
      write("live env channel: open failed: ", &errortext)
      close(s)
      return
      }
   got := ""
   while got ||:= reads(c, 64)
   close(c)
   close(s)
   write("live env channel: ", if got == "from_session" then "pass" else "fail")
end

# password= (or keyboard-interactive), only when UNICON_SSH_TESTPASS is
# set.  No key= here, so the password is the only way in.
procedure password_test(addr)
   local pass, opts, s, got, kh

   pass := getenv("UNICON_SSH_TESTPASS") | {
      write("live password: skipped (set UNICON_SSH_TESTPASS)")
      return
      }

   opts := [addr, "hc", "cmd=echo password_ok", "password=" || pass]
   if kh := getenv("UNICON_SSH_KNOWNHOSTS") then put(opts, "hostkeyfile=" || kh)
   else opts[2] := "hc-"
   s := open ! opts | {
      write("live password: open failed: ", &errortext)
      return
      }
   got := ""
   while got ||:= reads(s, 64)
   close(s)
   write("live password: ", if find("password_ok", got) then "pass" else "fail")

   opts[4] := "password=" || pass || "-wrong"
   s := (open ! opts) | &null
   write("live wrong password fails: ", failed_with_text(s))
end
