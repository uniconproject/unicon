#
# Layout markers recognized at the end of an ivib-generated source file.
# ivib/code.icn writes v2_marker; ivib_maindialog is used by ivib/code.icn
# to keep a copy of the source it writes.
#
global v1_marker, v2_marker, ivib_maindialog

############################################################################
#
# Tool bar holding the ivib object and command buttons.  Buttons are laid
# out per_row to a row; the bar's size follows the number of buttons.
#
class IvibToolBar : ToolBar(x1, y1, img_w, img_h, bg, per_row, count)
   method add_button(t)
      if /img_w then {
         img_w := t.img_w
         img_h := t.img_h
      }
      if count > 0 & count % per_row = 0 then {
         y1 +:= img_h
         x1 := 0
      }
      t.set_pos(x1, y1)
      t.set_no_keyboard()
      bg.add(t)
      self.add(t)
      x1 +:= img_w
      count +:= 1
      set_size(per_row * img_w, y1 + img_h)
   end

   initially(n)
      self.ToolBar.initially()
      per_row := \n | 16
      x1 := y1 := count := 0
      bg := ButtonGroup()
end

############################################################################
#
# PopupMenu.popup() places the menu at the pointer using window
# coordinates, as positions relative to the menu's parent.  That works in
# standalone ivib, where the parent is the dialog; here the parent is
# the IvibTab, so convert.
#
class IvibPopupMenu : PopupMenu()
   method set_pos(x, y)
      if \parent then {
         x -:= parent.x
         y -:= parent.y
      }
      self.PopupMenu.set_pos(x, y)
   end
end

############################################################################
#
# The ivib canvas and its tool bar, embedded as a component of the IDE.
#
# Each editor tab gets its own canvas (with its own undo/redo history),
# loaded from the ivib layout found at the end of that tab's buffer.
# The canvas follows the current editor tab while the Files/IVIB view is
# shown.  "Generate UI Code" writes the generated code and layout into
# the editor buffer, not straight to disk; saving the buffer saves it.
#
$define CANVAS_SURROUND 30
#
class IvibTab : Component(
   canvas,                  # The drawing canvas
   prefs,                   # Preferences structure
   filename_label,          # Label for current filename
   info_label,              # Label for other info
   pos_label,               # Label for positional info
   undo_list,               # List of canvases for undo command
   redo_list,               # List of canvases for redo command
   extra_undo,              # Additional undo for canceling certain commands
   orig_canvas_width,       # Size of a new canvas
   orig_canvas_height,      #
   tool_area_height,        # Height of the tool bar and labels
   popup_component,         # Popup on component
   popup_dialog,            # Popup on dialog
   last_icon_dir,           # Used by the component dialogs (via canvas.parent)
   last_layout_dir,
   undo_button,             # Toolbar buttons
   redo_button,
   source,                  # Used by ivib/code.icn
   uis,                     # The CanvasComponentUIs (also used by Mainbar)
   editor_tab,              # Editor tab the canvas belongs to
   layouts                  # Saved state of other tabs: tab -> [canvas, undo, redo]
   )

########################################################
# Messages and menu shading.
#

   #
   # Show a message in the info label and the IDE's message box.
   #
   method message(s)
      (\info_label).set_label(s)
      (\(\uidlog).MsgBox).set_contents(["Ivib: " || s])
      return
   end

   #
   # Errors from the canvas and its dialogs (ivib's CommonDialog pops up a
   # dialog here).  Like that version, this always fails.
   #
   method alert_error(s)
      message(s)
      fail
   end

   method shade_selection_options()
      (\(\uidlog).menubar).set_selections_menu_shaded()
   end

   method clear_selection_options()
      (\(\uidlog).menubar).set_selections_menu_cleared()
   end

   #
   # Shade/unshade the undo and redo buttons and menu items.
   #
   method update_undo_shading()
      local mb
      mb := (\uidlog).menubar
      if *undo_list > 0 then {
         undo_button.clear_is_shaded()
         (\mb).clear_ivib_undo_shaded()
      } else {
         undo_button.set_is_shaded()
         (\mb).set_ivib_undo_shaded()
      }
      if *redo_list > 0 then {
         redo_button.clear_is_shaded()
         (\mb).clear_ivib_redo_shaded()
      } else {
         redo_button.set_is_shaded()
         (\mb).set_ivib_redo_shaded()
      }
   end

########################################################
# Undo and redo.
#

   method clear_undo()
      self.undo_list := []
      update_undo_shading()
   end

   method clear_redo()
      self.redo_list := []
      update_undo_shading()
   end

   #
   # Push an undo item
   #
   method push_undo_list(d)
      push(undo_list, d)
      #
      # Reduce to correct size.
      #
      while *undo_list > self.prefs.undo_size do
         pull(undo_list)
      update_undo_shading()
   end

   method push_redo_list(d)
      push(redo_list, d)
      update_undo_shading()
   end

   #
   # Store current canvas in extra_undo variable
   #
   method save_extra_undo()
      self.extra_undo := self.canvas.dup()
   end

   #
   # Retrieve from extra_undo
   #
   method use_extra_undo()
      self.undo_to(\self.extra_undo)
      self.extra_undo := &null
      reset_canvas_pos(self.canvas)
   end

   #
   # Push copy of current canvas onto undo list.
   #
   method push_undo()
      self.push_onto_undo(self.canvas.dup())
   end

   #
   # Push a canvas onto undo list, resetting the redo list.
   #
   method push_onto_undo(d)
      self.redo_list := []
      self.push_undo_list(d)
   end

   method op_Undo()
      local c
      c := pop(undo_list) | fail
      self.push_redo_list(self.canvas.dup())
      update_undo_shading()
      self.undo_to(c)
      reset_canvas_pos(self.canvas)
      info_label.set_label("Undone")
      self.canvas.set_modified()
   end

   method op_Redo()
      local c
      c := pop(redo_list) | fail
      push(undo_list, self.canvas.dup())
      update_undo_shading()
      self.undo_to(c)
      reset_canvas_pos(self.canvas)
      info_label.set_label("Redone")
      self.canvas.set_modified()
   end

   #
   # Replace current canvas with c.
   #
   method undo_to(c)
      local i
      #
      # Dispose of current canvas.  Its items are not children of the
      # canvas, so release their windows too.
      #
      every (!self.canvas.items).finally()
      self.canvas.finally()

      if (\self.parent_dialog).focus === self.canvas then
         self.parent_dialog.focus := &null
      every i := 1 to *self.children do
         if self.children[i] === self.canvas then {
            self.children[i] := self.canvas := c
            break
         }

      #
      # Setup rest of fields in new canvas.
      #
      self.canvas.set_parent(self)
      self.canvas.init()
      self.canvas.restore()

      if *self.canvas.selections > 0 then
         clear_selection_options()
      else
         shade_selection_options()
      return
   end

########################################################
# Following the editor tabs.
#

   #
   # Succeed if the ivib panel is currently shown.
   #
   method is_shown()
      return (\(\uidlog).menubar).ivib_shown()
   end

   #
   # The file name of editor tab t, or fail if it has none yet.
   #
   method tab_path(t)
      local f
      f := \t.filename | fail
      if f[-1] == "*" then f := f[1:-1]
      if f == ("" | "Untitled" | "scratch") then fail
      return (\t.filedirectory | "") || f
   end

   #
   # Make the canvas follow the current editor tab.  Called when the
   # current tab changes and when the ivib panel is shown.  Nothing is
   # done while the panel is hidden; the canvas catches up when shown.
   #
   method sync_with_tab()
      local t, st, gone
      is_shown() | return
      \self.cwin | return            # not displayed yet
      t := (\ide).CurrentTabItem() | return
      if t === self.editor_tab then {
         update_filename()
         return
      }

      #
      # Keep the state of the tab we are leaving, and forget closed tabs.
      #
      if \self.editor_tab then
         layouts[self.editor_tab] := [self.canvas, self.undo_list, self.redo_list]
      gone := []
      every st := key(layouts) do
         if not (st === !uidlog.FileTabSet.children) then
            put(gone, st)
      every delete(layouts, !gone)

      self.editor_tab := t
      if st := \layouts[t] then {
         delete(layouts, t)
         self.undo_list := st[2]
         self.redo_list := st[3]
         update_undo_shading()
         self.undo_to(st[1])
         reset_canvas_pos(self.canvas)
         update_filename()
      }
      else
         load_from_buffer()
   end

   #
   # Show the current tab's file name for the canvas.
   #
   method update_filename()
      self.canvas.filename := tab_path(\self.editor_tab) | &null
      set_filename_label()
   end

   #
   # Load the canvas from the layout at the end of the current buffer,
   # or start a new canvas if there is none.
   #
   method load_from_buffer()
      local lines, c, s
      lines := (\ide).CurrentEditBox().get_contents() | []
      self.clear_undo()
      self.clear_redo()
      if c := parse_layout(lines) then {
         c.set_size(c.w, c.h)
         reset_canvas_pos(c)
         self.undo_to(c)
         s := "Loaded layout"
      } else {
         new_canvas()
         s := if find_marker(lines) then "Bad layout; started a new one"
              else "No layout yet; Generate UI Code adds one"
      }
      update_filename()
      if \(\c).modified then
         self.canvas.set_modified()
      else
         self.canvas.clear_modified()
      self.canvas.erase_and_display()
      self.canvas.update_pos_label()
      info_label.set_label(s)
   end

   #
   # Replace the canvas with a new, empty one.
   #
   method new_canvas()
      local c
      c := Canvas()
      c.set_size(orig_canvas_width, orig_canvas_height)
      reset_canvas_pos(c)
      self.undo_to(c)
   end

########################################################
# Methods to set filename of canvas object.
#

   #
   # Set filename_label to reflect current status of canvas.  When the
   # layout is modified, mark the editor tab modified too, so the IDE
   # offers to save it (saving regenerates the code; see IDE.save_file).
   #
   method set_filename_label()
      local s
      s := file_name(\self.canvas.filename) | "Untitled"
      if \self.canvas.modified then {
         s ||:= " *"
         if \self.editor_tab & not (self.editor_tab.label[-1] == "*") then {
            self.editor_tab.label ||:= "*"
            uidlog.FileTabSet.resize()
         }
      }
      self.filename_label.set_label(s)
   end

