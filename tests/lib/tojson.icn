#
# tojson.icn -- tojson() (plain JSON, no Unicon metadata) for each
#  structure type, and that its output parses back; utoj() for record
#  and class names containing "_", and for a non-ASCII cset.
#

import json

record R(x, y)

class C(p, q)
end

record my_rec(a)

class My_Box(w)
end

procedure main()
   local x, j
   every x := set([1]) | 'ab' | C(1, 2) | R(1, "two") | table() |
         [set(["s"]), 'c', C([], 3.5)] do {
      j := tojson(x) | "FAILED"
      write(left(type(x), 10), j)
      write(left("", 10), vimage(jtous(j)) | "does not parse")
      }
   every x := my_rec(1) | My_Box(2) do {
      j := utoj(x)
      write(j, " -> ", type(jtous(j)))
      }

   # A non-ASCII cset is one byte per member, not the UTF-8 of that byte.
   x := cset(char(233))
   y := jtous(utoj(x))
   write(utoj(x), " -> ", *y, " ", ord(!y))
   x := cset(char(195) || char(169))
   y := jtous(utoj(x))
   j := ""
   every j ||:= " " || ord(!y)
   write(*y, j)

   # A later "__unicset__" property is a string, decoded as UTF-8.
   # U+4E2D is three bytes; U+00E9 is two, not the single byte 233.
   x := jtous("{\"__unitable__\":1,\"__unicset__\":\"\\u4e2d\"}")
   j := ""
   every j ||:= " " || ord(!x["__unicset__"])
   write("table property", j)
   x := jtous("{\"__unitable__\":1,\"__unicset__\":\"\\u00e9\"}")
   j := ""
   every j ||:= " " || ord(!x["__unicset__"])
   write("table e9", *x["__unicset__"], j)
end

#
# Print x without serial numbers, so the output does not depend on
# allocation order.  Table keys are sorted by their printed form.
#
procedure vimage(x)
   local s, L, k
   case type(x) of {
      "list": {
         s := ""
         every s ||:= ", " || vimage(!x)
         return "[" || (s[3:0] | "") || "]"
         }
      "table": {
         L := []
         every k := key(x) do put(L, vimage(k) || ": " || vimage(x[k]))
         s := ""
         every s ||:= ", " || !sort(L)
         return "{" || (s[3:0] | "") || "}"
         }
      default: return image(x)
      }
end
