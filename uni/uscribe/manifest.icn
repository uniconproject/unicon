package uscribe

import lang

#
# manifest.icn -- ordered chapter list for a book
#
# Holds source paths in reading order and the parsed Document for each
# after pass 1. Loaded from a plain file (one path per line, "#" comments
# allowed) or via addChapter().
#
# This file is in the public domain.
#

class Manifest : Object (bookTitle, entries, docs)

    method setTitle(t)
        bookTitle := t
        return
    end
    method getTitle()
        return \bookTitle
    end

    # Register a chapter by source path, in reading order.
    method addChapter(srcPath)
        put(entries, srcPath)
        return
    end

    method getChapterPaths()
        return entries
    end

    # Load chapter order from a manifest file (one path per line;
    # blank lines and "#" comments ignored).
    # <[param path filesystem path to the manifest file]>
    method loadFromFile(path)
        local f, line
        f := open(path, "r") | fail
        while line := read(f) do {
            line ? {
                tab(many(' \t'))
                if pos(0) then next
                if ="#" then next
                addChapter(tab(0))
                }
            }
        close(f)
        return
    end

    # <p>
    # Record the parsed Document for a chapter (keyed by its source
    # path) once Parser has produced it. Kept separate from
    # addChapter() so ordering can be declared before parsing runs.
    # </p>
    method setDocument(srcPath, doc)
        docs[srcPath] := doc
        return
    end

    method getDocument(srcPath)
        return \docs[srcPath]
    end

    # <p>
    # Produce the Documents in manifest order, for handing to
    # LabelTable.resolve() and then to an Outputter.
    # <[returns a list of Document instances, in chapter order]>
    # </p>
    method getOrderedDocuments()
        local out, p
        out := []
        every p := !entries do
            put(out, \docs[p]) | write(&errout, "warning: chapter '", p,
                                        "' listed but never parsed")
        return out
    end

    initially
        entries := []
        docs := table()
end
