link glsnap
procedure main()
   w := open("mat","gl","size=320,240","bg=black") | stop("open: ",&errortext)
   Fg(w,"white")
   PushMatrix(w); Translate(w,-0.7,0,-3); Rotate(w,45,1,1,0); DrawCube(w,0,0,0,0.5); PopMatrix(w)
   PushMatrix(w); Translate(w,0.7,0,-3); Scale(w,1,2,1); Fg(w,"orange"); DrawSphere(w,0,0,0,0.25); PopMatrix(w)
   IdentityMatrix(w)
   Fg(w,"purple"); DrawCube(w,0,-0.7,-3,0.3)
   snap(w,"t02_matrix")
end
