# messy.icn: a program for the formatting test
record point(x,y)

procedure main(args)
local p, i
      p:=point(1,2)
  every i := 1 to 3 do
 if i % 2 = 0 then
write("even ",i)
     else {
           write("odd ", i,
                 " of ", 3)
     }
write(p.x+p.y)   
end

class Counter(n)
method bump()
n +:= 1
return n
end
initially
n := 0
end
