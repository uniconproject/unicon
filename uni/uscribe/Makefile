# Makefile for uscribe

SHELL=/bin/sh
BASE=../..
UNICON_TOP_BUILDDIR ?= $(BASE)
include $(UNICON_TOP_BUILDDIR)/Makedefs.uni

SRCS   := $(wildcard ./*.icn)
UFILES := $(patsubst %.icn, %.u, $(SRCS))

.PHONY: all clean deps depends

default: uscribe$(EXE)
all: uscribe$(EXE)

%.u: %.icn
	$(UNICON) $(UFLAGS) -c $?

uscribe$(EXE): $(UFILES)
	$(UNICON) -o uscribe $(UFILES)
	$(CP) uscribe$(EXE) $(BIN)

deps depends:
	unidep $(SRCS)

clean:
	$(RM) uscribe$(EXE) *.u uniclass.dir uniclass.pag uniclass.db *~

### Autogenerated dependencies
directive.u : directive.icn inline.u node.u
inline.u : inline.icn node.u scan.u
labeltable.u : labeltable.icn node.u
latexout.u : latexout.icn inline.u labeltable.u node.u outputter.u
main.u : main.icn directive.u labeltable.u latexout.u manifest.u outputter.u parser.u
manifest.u : manifest.icn
node.u : node.icn
outputter.u : outputter.icn inline.u node.u
parser.u : parser.icn directive.u inline.u node.u
scan.u : scan.icn
