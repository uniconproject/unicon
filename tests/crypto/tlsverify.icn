#
# TLS verify modes: reject cleartext and missing CA; accept verifyPeer=no
# and mode "ne-" (same meaning); accept a client that trusts the server CA.
#

link tlsutil

procedure main()
   local port, key, cert, ca

   if not (&features == "secure sockets layer encryption") then
      stop("needs SSL")
   if not (&features == "concurrent threads") then
      stop("needs concurrent threads")

   key := "key=./data/unicon-server.key"
   cert := "cert=./data/unicon-server.crt"
   ca := "ca=./data/unicon-ca.crt"

   port := tls_port()
   tls_start([port, "nae", key, cert, ca], 5)

   # Cleartext client must not speak TLS.
   if tls_echo([port, "n", 5000]) then
      write("cleartext:fail")
   else
      write("cleartext:ok")
   delay(250)

   # TLS without CA or verifyPeer=no: verification fails.
   if tls_echo([port, "ne", 5000]) then
      write("noca:fail")
   else
      write("noca:ok")
   delay(250)

   if tls_echo([port, "ne", 5000, "verifyPeer=no", "keypass=unused"]) then
      write("noverify:ok")
   else
      write("noverify:fail")
   delay(250)

   if tls_echo([port, "ne-", 5000]) then
      write("dashverify:ok")
   else
      write("dashverify:fail")
   delay(250)

   if tls_echo([port, "ne", 5000, ca]) then
      write("withca:ok")
   else
      write("withca:fail")
end
