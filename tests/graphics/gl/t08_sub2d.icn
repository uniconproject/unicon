link glsnap
procedure main()
   w := open("p","gl","bg=red","size=300,300") | stop("open: ",&errortext)
   Fg(w,"white"); DrawCube(w,0,0,-2,0.6); Refresh(w)
   c := Clone(w,"g","fg=white","bg=blue","size=200,100","pos=50,180") | stop("clone2d: ",&errortext)
   FillRectangle(c,10,10,50,50)
   write(c,"2D subwindow")
   snap(c,"t08_sub2d_child")
end
