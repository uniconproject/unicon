#<p>
# Inline markup parsing: turn one line (or run of text within a
# paragraph/list-item/heading) into a list of <tt>Inline</tt> nodes.
#</p>
#<p>
# This replaces what classic UniDoc's <tt>cmts2html()</tt> did inline
# with HTML string concatenation. The difference: this produces
# <tt>Node</tt> objects (<tt>node.icn</tt>), so any <tt>Outputter</tt>
# can render <tt>*emphasis*</tt>, <tt>`literal`</tt>, and
# cross-references its own way -- HTML, groff, plain text -- without
# touching this parser.
#</p>
#<p>
# Node construction goes through <tt>node.icn</tt>'s
# <tt>mkText()</tt>/<tt>mkEmphasis()</tt>/<tt>mkStrong()</tt>/
# <tt>mkLiteral()</tt>/<tt>mkPendingXref()</tt>/<tt>mkHyperlink()</tt>/
# <tt>mkScriptText()</tt> factories rather than
# raw <tt>ClassName(...)</tt> calls, so this file never has to count
# each class's inherited (<tt>parent</tt>/<tt>srcFile</tt>/<tt>srcLine</tt>)
# field slots by hand.
#</p>
#<p>
# This file is in the <i>public domain</i>.
#</p>

package uscribe

#<p>
# Parse plain text with lightweight inline markup:
#   <tt>*emphasis*</tt>    -> <tt>Emphasis</tt>
#   <tt>**strong**</tt>    -> <tt>Strong</tt>
#   <tt>``literal``</tt>   -> <tt>Literal</tt> (RST-style; preferred)
#   <tt>`literal`</tt>     -> <tt>Literal</tt> (single-backtick convenience)
#   <tt>`text &lt;url&gt;`_</tt> / <tt>`url`_</tt> -> <tt>Hyperlink</tt>
#   <tt>:ref:`label`</tt>  -> <tt>PendingXref</tt>(kind: <tt>"ref"</tt>)
#   <tt>:ref:`Title &lt;label&gt;`</tt> -> same, with display text
#     (angle brackets via <tt>parseRolePayload()</tt> / <tt>scan.icn</tt>)
#   <tt>:doc:`file`</tt>   -> <tt>PendingXref</tt>(kind: <tt>"doc"</tt>)
#   <tt>:sub:`text`</tt> / <tt>:sup:`text`</tt> -> <tt>ScriptText</tt>
#   <tt>:cite:`key`</tt> / <tt>:cite:`k1,k2`</tt> -> <tt>Cite</tt>
#   <tt>:footnote:`body`</tt> -> <tt>Footnote</tt>
#   <tt>:math:`latex`</tt> -> <tt>Math</tt> (inline)
# Anything else is plain <tt>Text</tt>. Longer/more specific tokens
# are tried before shorter ones so e.g.
# <tt>"**bold**"</tt> is not misread as two adjacent <tt>"*emph*"</tt>
# runs, and <tt>``code``</tt> is not misread as two empty
# single-backtick spans. The interior of <tt>**strong**</tt> and
# <tt>*emphasis*</tt> is parsed again so <tt>**``code``**</tt> is
# bold code, not literal backticks. Unclosed delimiters are left as
# plain text (the opener is not eaten).
# <[param s one line/run of source text]>
# <[returns a list of <tt>Inline</tt> node instances]>
#</p>
procedure parseInline(s)
    local out, buf, tok, parts

    out := []
    buf := ""
    s ? {
        while not pos(0) do {
            if =":ref:`" then {
                if tok := tab(find("`")) then {
                    move(1)
                    flushText(out, buf); buf := ""
                    put(out, mkPendingXrefFromPayload(tok, "ref"))
                    }
                else
                    buf ||:= ":ref:`"
                }
            else if =":doc:`" then {
                if tok := tab(find("`")) then {
                    move(1)
                    flushText(out, buf); buf := ""
                    put(out, mkPendingXrefFromPayload(tok, "doc"))
                    }
                else
                    buf ||:= ":doc:`"
                }
            else if =":cite:`" then {
                if tok := tab(find("`")) then {
                    move(1)
                    flushText(out, buf); buf := ""
                    put(out, mkCite(tok))
                    }
                else
                    buf ||:= ":cite:`"
                }
            else if =":footnote:`" then {
                if tok := tab(find("`")) then {
                    move(1)
                    flushText(out, buf); buf := ""
                    put(out, mkFootnote(tok))
                    }
                else
                    buf ||:= ":footnote:`"
                }
            else if =":math:`" then {
                if tok := tab(find("`")) then {
                    move(1)
                    flushText(out, buf); buf := ""
                    put(out, mkMath(tok, &null))
                    }
                else
                    buf ||:= ":math:`"
                }
            else if =":sub:`" then {
                if tok := tab(find("`")) then {
                    move(1)
                    flushText(out, buf); buf := ""
                    put(out, mkScriptText(tok, "sub"))
                    }
                else
                    buf ||:= ":sub:`"
                }
            else if =":sup:`" then {
                if tok := tab(find("`")) then {
                    move(1)
                    flushText(out, buf); buf := ""
                    put(out, mkScriptText(tok, "sup"))
                    }
                else
                    buf ||:= ":sup:`"
                }
            else if ="**" then {
                if tok := tab(find("**")) then {
                    move(2)
                    flushText(out, buf); buf := ""
                    put(out, mkStrong(parseInline(tok)))
                    }
                else
                    buf ||:= "**"
                }
            else if ="``" then {
                if tok := tab(find("``")) then {
                    move(2)
                    flushText(out, buf); buf := ""
                    put(out, mkLiteral(tok))
                    }
                else
                    buf ||:= "``"
                }
            else if ="*" then {
                if tok := tab(find("*")) then {
                    move(1)
                    flushText(out, buf); buf := ""
                    put(out, mkEmphasis(parseInline(tok)))
                    }
                else
                    buf ||:= "*"
                }
            else if ="`" then {
                if tok := tab(find("`")) then {
                    move(1)
                    flushText(out, buf); buf := ""
                    # Trailing underscore => external hyperlink.
                    if ="_" then {
                        parts := parseRolePayload(tok)
                        put(out, mkHyperlink(parts[1], parts[2]))
                        }
                    else
                        put(out, mkLiteral(tok))
                    }
                else
                    buf ||:= "`"
                }
            else {
                buf ||:= move(1)
                }
            }
        }
    flushText(out, buf)
    return out
end

#<p>
# Internal: append a <tt>Text</tt> node for any plain-text run
# accumulated so far, unless it is empty.
# <[param out output list of inline nodes]>
# <[param buf accumulated plain-text buffer]>
#</p>
procedure flushText(out, buf)
    if *buf > 0 then put(out, mkText(buf))
end

#<p>
# Build a <tt>PendingXref</tt> from a role payload, supporting
# <tt>"label"</tt> and <tt>"Display &lt;label&gt;"</tt> via
# <tt>parseRolePayload()</tt> in <tt>scan.icn</tt>.
# <[param payload text inside the role backticks]>
# <[param kind <tt>"ref"</tt> or <tt>"doc"</tt>]>
# <[returns a <tt>PendingXref</tt>]>
#</p>
procedure mkPendingXrefFromPayload(payload, kind)
    local parts, xref
    parts := parseRolePayload(payload)
    xref := mkPendingXref(parts[1], kind)
    if \parts[2] then
        xref.setDisplayText(parts[2])
    return xref
end
