/*
 * ------------------------------------------------------------------
 * Helpers
 * ------------------------------------------------------------------
 */

/*
 * Convert a linear Unicon color (16 bits per channel) to a display RGB
 * value, applying the context's gamma correction.
 */
static unsigned long sdl_rgb(wbp w, long r, long g, long b)
{
   double gamma = w->context->gamma;
   long r0 = r, g0 = g, b0 = b;
   unsigned long px;
   wdp wd = w->context->display;

   if (gamma != 1.0 && gamma > 0.0) {
      double inv = 1.0 / gamma;
      r = (long)(65535 * pow(r / 65535.0, inv));
      g = (long)(65535 * pow(g / 65535.0, inv));
      b = (long)(65535 * pow(b / 65535.0, inv));
      }
   px = ((unsigned long)(r >> 8) << 16) | ((unsigned long)(g >> 8) << 8) |
        (unsigned long)(b >> 8);

   /*
    * Remember the color asked for, so that Pixel() reports it for this
    * display value, as the X11 color table does.
    */
   if (wd->colors == NULL)
      wd->colors = calloc(SDLCOLORS, sizeof(struct sdlcolor));
   if (wd->colors) {
      struct sdlcolor *e = &wd->colors[SDLCOLORHASH(px)];
      e->pixel = (unsigned int)px;
      e->r = (unsigned short)r0;
      e->g = (unsigned short)g0;
      e->b = (unsigned short)b0;
      e->used = 1;
      }
   return px;
}

/*
 * The inverse: display RGB to a linear 16-bit color.
 */
static void sdl_lcolor(wbp w, unsigned long c, long *r, long *g, long *b)
{
   double gamma = w->context->gamma;
   *r = ((c >> 16) & 0xFF) * 257;
   *g = ((c >> 8) & 0xFF) * 257;
   *b = (c & 0xFF) * 257;
   if (gamma != 1.0 && gamma > 0.0) {
      *r = (long)(65535 * pow(*r / 65535.0, gamma));
      *g = (long)(65535 * pow(*g / 65535.0, gamma));
      *b = (long)(65535 * pow(*b / 65535.0, gamma));
      }
}

/*
 * Bring the context's canvas drawing state up to date and return it.
 */
struct ucgc *sdl_gc(wbp w)
{
   wcp wc = w->context;
   struct ucgc *gc = &wc->gc;
   int i;

   gc->fg = (unsigned int)(ISXORREVERSE(w) ? (wc->fg ^ wc->bg) : wc->fg);
   gc->bg = (unsigned int)wc->bg;
   gc->op = ISXORREVERSE(w) ? UC_OP_XOR : wc->drawop;
   gc->linewidth = wc->linewidth;
   gc->linestyle = wc->linestyle;
   gc->fillstyle = wc->fillstyle;
   gc->patw = wc->patw;
   gc->path = wc->path;
   for (i = 0; i < wc->path && i < UC_MAXPATTERN; i++)
      gc->pat[i] = wc->pat[i];
   gc->clipon = (wc->clipw >= 0);
   gc->clipx = wc->clipx;
   gc->clipy = wc->clipy;
   gc->clipw = wc->clipw;
   gc->cliph = wc->cliph;
   return gc;
}

int sdl_displaysize(int which)
{
   int w, h;
   usdl_display_size(&w, &h);
   return which ? w : h;
}

/*
 * Subwindows have no window of their own: they are drawn over their
 * parent's canvas, later ones on top, when the top-level window is shown.
 */
#define ISSUBWIN(ws) ((ws)->parent != NULL)

static int subwin_shown(wsp ws)
{
   return ws->pix && ws->iconic != HiddenState
#ifdef Graphics3D
      && ws->type != TEXTURE_WSTATE
#endif                                  /* Graphics3D */
      ;
}

/* does ws or any subwindow need showing again? clears the flags */
static int subwin_dirty(wsp ws)
{
   struct wbind_list *c;
   int d = (ws->pix && ws->pix->dirty) || ws->recompose;
   if (ws->pix) ws->pix->dirty = 0;
   ws->recompose = 0;
   for (c = ws->children; c; c = c->next)
      if (c->child && c->child->window && subwin_shown(c->child->window))
         d |= subwin_dirty(c->child->window);
   return d;
}

/* draw the subwindows of ws, at (ox,oy) in comp, clipped to clip */
static void subwin_draw(wsp ws, struct ucanvas *comp, int ox, int oy,
                        struct ucgc *clip)
{
   struct wbind_list *c;
   wsp v[64];
   int n = 0;

   /* the list is newest first; draw oldest first */
   for (c = ws->children; c && n < 64; c = c->next)
      if (c->child && c->child->window && subwin_shown(c->child->window))
         v[n++] = c->child->window;
   while (n-- > 0) {
      wsp cw = v[n];
      struct ucgc gc = *clip;
      int b = cw->border;
      int x = ox + (cw->posx == -(MaxInt) ? 0 : cw->posx);
      int y = oy + (cw->posy == -(MaxInt) ? 0 : cw->posy);
      int x1, y1;
      if (b > 0) {                      /* the border, then inside it */
         gc.fg = (unsigned int)cw->bordercolor;
         gc.op = UC_OP_COPY;
         gc.fillstyle = UC_FILL_SOLID;
         uc_fill_rect(comp, &gc, x, y, cw->width + 2 * b, cw->height + 2 * b);
         x += b;
         y += b;
         }
      x1 = Min(gc.clipx + gc.clipw, x + (int)cw->width);
      y1 = Min(gc.clipy + gc.cliph, y + (int)cw->height);
      gc.clipx = Max(gc.clipx, x);
      gc.clipy = Max(gc.clipy, y);
      gc.clipw = x1 - gc.clipx;
      gc.cliph = y1 - gc.clipy;
      if (gc.clipw <= 0 || gc.cliph <= 0) continue;
      uc_copy_area(cw->pix, 0, 0, cw->width, cw->height, comp, &gc, x, y);
      subwin_draw(cw, comp, x, y, &gc);
      }
}

/*
 * Show the canvas of window state ws on screen; a subwindow is shown by
 * showing its top-level window.
 */
static void present(wsp ws, int force)
{
   struct ucgc gc;

   while (ws && ISSUBWIN(ws))
      ws = ws->parent->window;
   if (ws == NULL || ws->win == NULL || ws->pix == NULL)
      return;
   /*
    * Hold the same lock as the texture upload.  Another thread can
    * resize the canvas and free its pixels while this one shows them.
    */
   usdl_lock();
   if (ws->children == NULL && ws->comp == NULL) {
      usdl_present_locked(ws->win, ws->pix, force);
      usdl_unlock();
      return;
      }

   /* with subwindows, what is shown is a composite canvas */
   if (ws->comp && (ws->comp->width != ws->pix->width ||
                    ws->comp->height != ws->pix->height)) {
      uc_canvas_free(ws->comp);
      ws->comp = NULL;
      }
   if (ws->comp == NULL) {
      if ((ws->comp = uc_canvas_new(ws->pix->width, ws->pix->height, 0)) == NULL) {
         usdl_unlock();
         return;
         }
      ws->recompose = 1;
      }
   if (subwin_dirty(ws)) {
      uc_copy_area(ws->pix, 0, 0, ws->pix->width, ws->pix->height,
                   ws->comp, NULL, 0, 0);
      uc_gc_init(&gc);
      gc.clipon = 1;
      gc.clipx = gc.clipy = 0;
      gc.clipw = ws->pix->width;
      gc.cliph = ws->pix->height;
      subwin_draw(ws, ws->comp, 0, 0, &gc);
      }
   usdl_present_locked(ws->win, ws->comp, force);
   usdl_unlock();
}

/*
 * The subwindow of top-level window ws under (*x,*y), with the point
 * made relative to it; ws itself if none.
 */
static wsp subwin_at(wsp ws, int *x, int *y)
{
   struct wbind_list *c;
   for (c = ws->children; c; c = c->next) {  /* newest (topmost) first */
      wsp cw = (c->child) ? c->child->window : NULL;
      int cx, cy;
      if (cw == NULL || !subwin_shown(cw)) continue;
      cx = (cw->posx == -(MaxInt)) ? 0 : cw->posx;
      cy = (cw->posy == -(MaxInt)) ? 0 : cw->posy;
      if (*x >= cx && *y >= cy && *x < cx + (int)cw->width + 2 * cw->border &&
          *y < cy + (int)cw->height + 2 * cw->border) {
         *x -= cx + cw->border;
         *y -= cy + cw->border;
         return subwin_at(cw, x, y);
         }
      }
   return ws;
}

/* the subwindows of ws must be drawn again */
static void subwin_changed(wsp ws)
{
   while (ws && ISSUBWIN(ws)) {
      ws = ws->parent->window;
      ws->recompose = 1;
      }
}

/*
 * The binding (window value) of a window state, used to deliver events.
 */
static wbp binding_of(wsp ws)
{
   wbp wb;
   for (wb = wbndngs; wb; wb = wb->next)
      if (wb->window == ws)
         return wb;
   return NULL;
}

/*
 * ------------------------------------------------------------------
 * Text output to a window (WWrite and friends)
 * ------------------------------------------------------------------
 */

/*
 * write some text at the window's text position
 */
void xdis(wbp w, char *s, int n)
   {
   int delta_x;
   CURTSTATE();
   STDLOCALS(w);

   pollctr>>=1; pollctr++;
   delta_x = uc_text_width(wc->font->uf, s, n);
   uc_draw_text(stdpix, stdgc, wc->font->uf, ws->x, ws->y, s, n, 1);
   ws->x += delta_x;
   }

int wputc(int ci, wbp w)
   {
   int lh, width, height, over;
   char c = (char)ci;
   struct ucgc bggc;
   STDLOCALS(w);

   lh = wc->leading;
   width = ws->width;
   height = ws->height;
   bggc = *stdgc;
   bggc.op = UC_OP_COPY;
   bggc.fillstyle = UC_FILL_SOLID;
   bggc.fg = (unsigned int)wc->bg;

   switch(c) {
   case '\r': {
      ws->x = wc->dx;
      break;
      }
   case '\n': {
      if (ISCEOLON(w)) {
         /*
          * Clear the rest of the line, like a terminal would.
          */
         uc_fill_rect(stdpix, &bggc, ws->x, ws->y - ASCENT(w),
                      width - ws->x, lh);
         }
      ws->y += lh;
      ws->x = wc->dx;
      /*
       * Scroll the window if the new line is past the bottom.
       */
      over = ws->y + DESCENT(w) - height;
      if (over > 0) {
         ws->y -= over;
         uc_copy_area(stdpix, 0, over, width, height - over,
                      stdpix, stdgc, 0, 0);
         uc_fill_rect(stdpix, &bggc, 0, height - over, width, over);
         }
      break;
      }
   case '\t': {
      xdis(w, "        ", 8 - ((XTOCOL(w,ws->x))&7));
      break;
      }
   /*
    * Handle backspaces.  This implements cooked mode echo handling.
    */
   case '\177':
   case '\010': {
      int i = 0, pre_x;
      /*
       * Start with the last character queued up.
       */
      i--;
      /*
       * Trot back to the control-H itself.
       */
      while ((i>-EQUEUELEN) && (EVQUESUB(w,i) != c)) i--;
      if (i == -EQUEUELEN) break;
      /*
       * Go past the control-H.
       */
      i--;
      /*
       * Go back through any number of control-H's from prior lifetimes.
       */
      while((i > -EQUEUELEN) && !isprint(EVQUESUB(w,i))) i--;
      if (i == -EQUEUELEN) break;

      /*
       * OK, here's the character we're actually rubbing out.  Back up.
       */
      c = EVQUESUB(w,i);
      pre_x = ws->x;
      ws->x -= uc_text_width(wc->font->uf, &c, 1);
      /*
       * Physically erase the character from the queue.  This results in
       * two control-H's present in the queue.
       */
      *evquesub(w,i) = '\010';
      /*
       * Save the backed-up position, and draw spaces through the erased.
       */
      i = ws->x;
      while(ws->x < pre_x) xdis(w," ",1);
      ws->x = i;
      break;
      }
   default: {
      xdis(w,&c,1);
      }
   }
   return 1;
   }

/*
 * ------------------------------------------------------------------
 * Events
 * ------------------------------------------------------------------
 */

static int lastbutton;                  /* most recently pressed button */

/*
 * Bring a window's knowledge of its configuration up to date after the
 * user resized it; queue a resize event for the program.
 */
static void handle_config(wbp w, int width, int height)
   {
   struct descrip d;
   wsp ws = w->window;

   ws->x = Min(ws->x, width - FWIDTH(w));
   ws->y = Min(ws->y, height);

   if (width == (int)ws->width && height == (int)ws->height)
      return;
   ws->width = width;
   ws->height = height;
   resizePixmap(w, width, height);
#if defined(Graphics3D) && HAVE_LIBGL
   if (ws->is_3D)
      sdl_gl_resize(w);
#endif                                  /* Graphics3D && HAVE_LIBGL */

   if (!ISEXPOSED(w))
      return;
   MakeInt(RESIZED, &d);
   qevent(ws, &d, ws->width, ws->height, ~(uword)0, 0);
   }

static long modflags(int mods)
{
   long f = 0;
   if (mods & USDL_MOD_SHIFT) f |= ShiftMask;
   if (mods & USDL_MOD_CTRL)  f |= ControlMask;
   if (mods & USDL_MOD_META)  f |= Mod1Mask;
   return f;
}

static void handle_event(struct usdl_event *ev)
   {
   struct descrip d;
   wsp ws;
   wbp wb;
   int ecode = 0;

   if (ev->type == USDL_EV_NONE || ev->owner == NULL) return;
   /* make sure the canvas is still one of ours */
   for (ws = wstates; ws; ws = ws->next)
      if (ws == (wsp)ev->owner) break;
   if (ws == NULL || ws->win == NULL) return;

   /* input goes to the subwindow under the pointer, as under X11 */
   switch (ev->type) {
   case USDL_EV_KEYDOWN: case USDL_EV_KEYUP: case USDL_EV_BDOWN:
   case USDL_EV_BUP: case USDL_EV_MOTION: case USDL_EV_WHEEL:
      if (ws->children)
         ws = subwin_at(ws, &ev->x, &ev->y);
      break;
      }
   if ((wb = binding_of(ws)) == NULL) return;

   switch (ev->type) {
   case USDL_EV_KEYDOWN:
   case USDL_EV_KEYUP:
      if (ev->type == USDL_EV_KEYUP && !(ws->inputmask & KeyReleaseMask))
         return;
      ws->pointerx = ev->x;
      ws->pointery = ev->y;
      if (ev->ischar) {
         int c = ev->key & 0xFF;
         if (ev->type == USDL_EV_KEYUP)
            MakeInt(-c - 128, &d);
         else {
            StrLen(d) = 1;
            StrLoc(d) = (char *)&allchars[FromAscii(c) & 0xFF];
            }
         }
      else {
         if (ev->type == USDL_EV_KEYUP)
            MakeInt(-ev->key - 128, &d);
         else
            MakeInt(ev->key, &d);
         }
      qevent(ws, &d, ev->x, ev->y, (uword)ev->time, modflags(ev->mods));
      break;

   case USDL_EV_BDOWN:
   case USDL_EV_BUP:
      if (ev->type == USDL_EV_BDOWN)
         lastbutton = ev->button;
      switch (ev->button) {
         case 1: ecode = MOUSELEFT;  break;
         case 2: ecode = MOUSEMID;   break;
         case 3: ecode = MOUSERIGHT; break;
         default: return;
         }
      if (ev->type == USDL_EV_BUP)
         ecode -= (MOUSELEFT - MOUSELEFTUP);
      ws->pointerx = ev->x;
      ws->pointery = ev->y;
      MakeInt(ecode, &d);
      qevent(ws, &d, ev->x, ev->y, (uword)ev->time, modflags(ev->mods));
#if defined(Graphics3D) && HAVE_LIBGL
      if (ev->type == USDL_EV_BDOWN && wb->context->is_3D &&
          wb->context->app_use_selection3D) {
         wb->context->selectionrendermode = 1;
         redraw3D(wb);
         wb->context->selectionrendermode = 0;
         }
#endif                                  /* Graphics3D && HAVE_LIBGL */
      break;

   case USDL_EV_MOTION:
      ws->pointerx = ev->x;
      ws->pointery = ev->y;
      if (ev->buttons) {
         int b = lastbutton;
         if (b < 1 || b > 3 || !(ev->buttons & (1 << (b - 1))))
            b = (ev->buttons & 1) ? 1 : ((ev->buttons & 2) ? 2 : 3);
         ecode = (b == 1) ? MOUSELEFTDRAG :
                ((b == 2) ? MOUSEMIDDRAG : MOUSERIGHTDRAG);
         }
      else if (ws->inputmask & PointerMotionMask)
         ecode = MOUSEMOVED;
      else
         return;
      MakeInt(ecode, &d);
      qevent(ws, &d, ev->x, ev->y, (uword)ev->time, modflags(ev->mods));
      break;

   case USDL_EV_WHEEL:
      MakeInt(ev->wheel > 0 ? SCROLLUP : SCROLLDOWN, &d);
      qevent(ws, &d, ev->x, ev->y, (uword)ev->time, modflags(ev->mods));
      break;

   case USDL_EV_RESIZE:
      handle_config(wb, ev->w, ev->h);
      break;

   case USDL_EV_MOVE:
      ws->posx = ev->x;
      ws->posy = ev->y;
      break;

   case USDL_EV_EXPOSE:
      SETEXPOSED(wb);
      break;

   case USDL_EV_STATE:
      switch (usdl_state(ws->win)) {
         case USDL_STATE_ICONIC:    ws->iconic = IconicState;    break;
         case USDL_STATE_MAXIMIZED: ws->iconic = MaximizedState; break;
         case USDL_STATE_HIDDEN:    ws->iconic = HiddenState;    break;
         default:                   ws->iconic = NormalState;    break;
         }
      break;

   case USDL_EV_CLOSE:
      MakeInt(WINDOWCLOSED, &d);
      qevent(ws, &d, 0, 0, 0, 0);
      if (ws->inputmask & WindowClosureMask)
         break;
      /*
       * The window goes away now; the window value (and its canvas)
       * stays valid until the program closes it.  Event() stops I/O
       * on it when it delivers the closed event.
       */
      SETCLOSED(wb);
      usdl_close(ws->win);
      ws->win = NULL;
      break;
      }
   }

/*
 * Handle whatever the window system has sent, now (no rate limit);
 * used after the program changes a window's size or state, so that
 * WAttrib() sees the result.
 */
static void drain_events(void)
   {
   struct usdl_event ev;
   while (usdl_poll(&ev))
      handle_event(&ev);
   }

/*
 * poll for available events on all windows.
 * this is where the interpreter calls into the window system.
 */
int pollevent()
   {
   struct usdl_event ev;
   wsp ws;
   unsigned long now;
   static unsigned long lastpoll;
#ifdef Concurrent
   int isbusy;
   MUTEX_TRYLOCKID(MTX_POLLEVENT, isbusy);
   if (isbusy) return POLL_INTERVAL;
#endif                                    /* Concurrent */
   /*
    * The interpreter calls this very often; asking the window system
    * for events more than every few milliseconds only costs time.
    */
   now = usdl_ticks();
   if (wdsplys != NULL && now - lastpoll >= 4) {
      lastpoll = now;
      while (usdl_poll(&ev))
         handle_event(&ev);
      for (ws = wstates; ws; ws = ws->next)
         present(ws, 0);
      }
   MUTEX_UNLOCKID(MTX_POLLEVENT);
   return POLL_INTERVAL;
   }

/*
 * delay() while windows are open: keep handling window-system events
 * during the delay, so windows stay responsive and repaint.
 */
int sdl_delay(int n)
   {
   struct usdl_event ev;
   unsigned long deadline, now;
   wsp ws;

   if (wdsplys == NULL || n <= 0)
      return idelay(n);
   wflushall();
   deadline = usdl_ticks() + n;
   while ((now = usdl_ticks()) < deadline) {
      if (usdl_wait(&ev, (int)(deadline - now))) {
         handle_event(&ev);
         while (usdl_poll(&ev))
            handle_event(&ev);
         for (ws = wstates; ws; ws = ws->next)
            present(ws, 0);
         }
      }
   return Succeeded;
   }

/*
 * Draw/erase the text cursor.  The cursor is xor-ed onto the canvas while
 * the program waits for input and removed before anything else happens.
 */
static void togglecursor(wbp w)
   {
   struct ucgc gc;
   wcp wc = w->context;
   wsp ws = w->window;
   if (!ws->pix) return;
   uc_gc_init(&gc);
   gc.op = UC_OP_XOR;
   gc.fg = (unsigned int)(wc->fg ^ wc->bg);
   uc_fill_rect(ws->pix, &gc, ws->x, ws->y, FWIDTH(w), DESCENT(w));
   }

/*
 * get a single item from w's pending queue; wait at most t milliseconds
 * if t > 0.  Returns 1, or -1 if the window died, -2 if time ran out.
 */
int wgetq(wbp w, dptr res, int t)
   {
   struct usdl_event ev;
   unsigned long deadline = 0;
   int cursor = 0, r;
   wsp ws;

   if (t > 0)
      deadline = usdl_ticks() + t;
   while (1) {
      if (!EVQUEEMPTY(w)) {
         if (cursor) togglecursor(w);
         EVQUEGET(w,*res);
         if (cursor) present(w->window, 1);
         return 1;
         }
      if (ISCLOSED(w)) {
         if (cursor) togglecursor(w);
         return -1;
         }
      if (ISCURSORON(w) && !cursor && w->window->win) {
         togglecursor(w);
         cursor = 1;
         }
      for (ws = wstates; ws; ws = ws->next)
         present(ws, 1);
      if (t > 0) {
         unsigned long now = usdl_ticks();
         if (now >= deadline) {
            if (cursor) togglecursor(w);
            return -2;
            }
         r = usdl_wait(&ev, (int)(deadline - now));
         }
      else
         r = usdl_wait(&ev, 100);
      if (r) {
         handle_event(&ev);
         while (usdl_poll(&ev))
            handle_event(&ev);
         }
      else if (wdsplys == NULL)
         idelay(10);
      }
   }

/*
 * wclose - close a window.  Its canvas lives on while the program still
 * has references to it.
 */
int wclose(wbp w)
   {
   wbp tmp_wb;
   wbp p;
   struct wbind_list *wbl, *t, *b;
   wsp ws = w->window;

   while (ws->children) {
      tmp_wb = ws->children->child;
      wbl = ws->children;
      ws->children = ws->children->next;
#ifdef Graphics3D
      if (tmp_wb->window->is_3D)
         release_3d_resources(tmp_wb);
#endif                                  /* Graphics3D */
      tmp_wb->refcount--;
      tmp_wb->window->parent = NULL;
      w->refcount--;
      SETCLOSED(tmp_wb);
      wbl->next = NULL;
      free(wbl);
      }
   p = ws->parent;
   if (p) {
      t = p->window->children;
      b = NULL;
      while (t) {
         if (t->child->window == w->window) {
            if (b == NULL)
               p->window->children = t->next;
            else b->next = t->next;
            t->next = NULL;
            t->child = NULL;
            free(t);
            w->refcount--;
            break;
            }
         b = t;
         t = t->next;
         }
      ws->parent = NULL;
      p->refcount--;
      p->window->recompose = 1;
      present(p->window, 1);
      }

#ifdef Graphics3D
   if (ws->is_3D)
      release_3d_resources(w);
#endif                                  /* Graphics3D */

   if (ws->win && ws->refcount > 1) {
      usdl_close(ws->win);
      ws->win = NULL;
      ws->refcount--;
      }
   else {
      free_binding(w);
      }
   return 0;
   }

/*
 * flush a window: put its canvas on screen now
 */
void wflush(wbp w)
   {
   present(w->window, 1);
   }

/*
 * flush all windows
 */
void wflushall()
   {
   wsp ws;
   for (ws = wstates; ws; ws = ws->next)
      present(ws, 1);
   }

/*
 * sync: flush and let the window system catch up
 */
void wsync(wbp w)
   {
   if (w == NULL)
      wflushall();
   else {
      wflush(w);
      usdl_sync(w->window->win);
      }
   }

/*
 * ------------------------------------------------------------------
 * Opening windows
 * ------------------------------------------------------------------
 */

/*
 * open a window
 * This routine really just allocates a window data structure.
 * The interesting part is done in wmap, after the user preferences
 * passed to Icon have been parsed.  Returns NULL on error/failure;
 * err_index is set to one of:
 *  >= 0: the index of an offending attribute value
 *  -1  : ordinary failure
 *  -2  : out of memory
 */
FILE *wopen(char *name, struct b_list *lp, dptr attr, int n, int *err_index, int is_3d)
   {
   wbp w;
   wsp ws;
   wcp wc;
   char dispchrs[256];
   char answer[128];
   char *display = NULL;
   int i;
   tended struct b_list *tlp;
   tended struct descrip attrrslt;

   tlp = lp;
   for(i=0;i<n;i++) {
      if (is:string(attr[i]) &&
          (StrLen(attr[i])>8) &&
          !strncmp("display=",StrLoc(attr[i]),8)) {
         word dlen = StrLen(attr[i]) - 8;
         /*
          * The value is not terminated, and the NUL is written at
          * dlen.  Reject a value that does not fit, including that NUL.
          */
         if (dlen >= (word)sizeof(dispchrs)) {
            *err_index = i;
            return NULL;
            }
         memcpy(dispchrs, StrLoc(attr[i]) + 8, dlen);
         dispchrs[dlen] = '\0';
         display = dispchrs;
         }
      }

   if (!usdl_init()) {
      *err_index = -1;
      set_errortext(145);
      return NULL;
      }

   if ((w = alc_wbinding()) == NULL) {
      *err_index = -2;
      return NULL;
      }
   if ((w->window = alc_winstate()) == NULL) {
      *err_index = -2;
      free_binding(w);
      return NULL;
      }

   if ((w->window->display = alc_display(display)) == NULL) {
      *err_index = -1;
      free_binding(w);
      set_errortext(145);
      return NULL;
      }
   ws = w->window;
   ws->children = NULL;
   ws->parent = NULL;

   ws->listp.dword = D_List;
   BlkLoc(ws->listp) = (union block *)tlp;

   /*
    * some attributes of the display and window are used in the context
    */
   if ((wc = w->context = alc_context(w)) == NULL) {
      *err_index = -2;
      free_binding(w);
      return NULL;
      }

   /*
    * some attributes of the context determine window defaults
    */
   ws->height = wc->font->height * 12;
   ws->width  = wc->font->maxwidth * 80;
   ws->y = wc->font->ascent;
   ws->x = 0;
   ws->y += wc->dy;
   ws->x += wc->dx;
#ifdef Graphics3D
   wc->is_3D = ws->is_3D = is_3d;
   if (is_3d) {
      /* create an empty list for list of function calls */
      if (create_display_list(w, 40000) == Failed) {
         *err_index = -2;
         return NULL;
         }
      }
#endif                                  /* Graphics3D */

   /*
    * Loop through any remaining arguments.
    */
   for (i = 0; i < n; i++){
      /*
       * write the attribute,
       *  except "display=" attribute, which is done earlier
       */
      if((StrLen(attr[i])<9)||strncmp(StrLoc(attr[i]),"display=",8)) {
         switch (wattrib((wbp) w, StrLoc(attr[i]), StrLen(attr[i]), &attrrslt,
                         answer)) {
         case RunError:
            *err_index = i;
            return NULL;
         case Failed:
            free_binding((wbp)w);
            *err_index = -1;
            set_errortext(145);
            return NULL;
            }
         }
      }
   if (ws->windowlabel == NULL) {
      ws->windowlabel = salloc(name);
      if (ws->windowlabel == NULL) { /* out of memory */
         *err_index = -2;
         return NULL;
         }
      }
   if ((i = wmap(w)) != Succeeded) {
      if (i == Failed) {
         *err_index = -1;
         }
      else *err_index = 0;
      return NULL;
      }
   return (FILE *)w;
   }

/*
 * Create the on-screen window for a canvas.
 */
static int sdl_mapwindow(wbp w)
   {
   wsp ws = w->window;
   int flags = 0, x, y;

   if (ws->win) return Succeeded;
   if (ISRESIZABLE(w)) flags |= USDL_RESIZABLE;
   if (!ISTITLEBAR(ws)) flags |= USDL_BORDERLESS;
   if (ws->iconic == IconicState) flags |= USDL_MINIMIZED;
   if (ws->iconic == MaximizedState) flags |= USDL_MAXIMIZED;
   x = (ws->posx == -(MaxInt)) ? USDL_POS_UNDEFINED : ws->posx;
   y = (ws->posy == -(MaxInt)) ? USDL_POS_UNDEFINED : ws->posy;

   ws->win = usdl_open(ws->windowlabel ? ws->windowlabel : "", x, y,
                       ws->width, ws->height, flags, (void *)ws);
   if (ws->win == NULL) {
      set_errortext(144);
      return Failed;
      }
   if (ws->windowlabel)
      usdl_set_title(ws->win, ws->windowlabel);
   if (ws->iconpix)
      usdl_set_icon(ws->win, ws->iconpix);
   if (ws->minwidth || ws->minheight)
      usdl_set_min_size(ws->win, ws->minwidth, ws->minheight);
   usdl_set_cursor(ws->win, ws->cursor);
   usdl_sync(ws->win);
   if (ws->posx == -(MaxInt) || ws->posy == -(MaxInt))
      usdl_get_position(ws->win, &ws->posx, &ws->posy);
   if (ws->iconic != IconicState && ws->iconic != MaximizedState)
      ws->iconic = NormalState;
   SETEXPOSED(w);
   present(ws, 1);
   return Succeeded;
   }

/*
 * Create the canvas for a window state, and its window unless the
 * canvas starts out hidden.
 */
int wmap(wbp w)
   {
   struct imgdata *imd;
   int r;
   wcp wc = w->context;
   wsp ws = w->window;

   /*
    *  Create a canvas for this window if there isn't one already.
    */
   if (ws->pix == NULL) {
      if (ws->initialPix) {
         ws->pix = ws->initialPix;
         ws->initialPix = NULL;
         }
      else {
         ws->pix = uc_canvas_new(ws->width, ws->height,
                                 (unsigned int)wc->bg);
         if (ws->pix == NULL) {
            set_errortext(305);
            return Failed;
            }
         }
      ws->pixwidth = ws->pix->width;
      ws->pixheight = ws->pix->height;
      }

   imd = &ws->initimage;
   if (imd->width) {
      r = strimage(w, 0, 0, imd->width, imd->height, imd->paltbl,
         imd->data, (word)imd->width * (word)imd->height, 0);
      if (imd->paltbl)
         free((pointer)imd->paltbl);
      free((pointer)imd->data);
      imd->width = 0;
      if (r < 0) {
         set_errortext(145);
         return Failed;
         }
      }

   imd = &ws->initicon;                 /* no icon windows; just free it */
   if (imd->width) {
      if (imd->paltbl)
         free((pointer)imd->paltbl);
      free((pointer)imd->data);
      imd->width = 0;
      }

   if (wc->patternname != NULL) {
      if (SetPattern(w, wc->patternname, strlen(wc->patternname)) != Succeeded) {
         set_errortext(145);
         return Failed;
         }
      }

#if defined(Graphics3D) && HAVE_LIBGL
   if (ws->is_3D && ws->gl == NULL && create3Dcontext(w) == Failed) {
      set_errortext(144);
      return Failed;
      }
#endif                                  /* Graphics3D && HAVE_LIBGL */

   if (ISSUBWIN(ws)) {
      if (ws->posx == -(MaxInt)) ws->posx = 0;
      if (ws->posy == -(MaxInt)) ws->posy = 0;
      /* as X11 makes them: 2D subwindows have a border in the fg color */
      ws->border = 1;
#ifdef Graphics3D
      if (ws->is_3D) ws->border = 0;
#endif                                  /* Graphics3D */
      ws->bordercolor = wc->fg;
#if defined(Graphics3D) && HAVE_LIBGL
      /* set up the OpenGL state of a 3D subwindow, as X11 does */
      if (ws->is_3D && init_3dcanvas(w) == Failed) {
         set_errortext(144);
         return Failed;
         }
#endif                                  /* Graphics3D && HAVE_LIBGL */
      subwin_changed(ws);
      SETEXPOSED(w);
      present(ws, 1);
      return Succeeded;
      }
   if (ws->iconic == HiddenState || ws->iconic == RootState)
      return Succeeded;
   return sdl_mapwindow(w);
   }

int do_config(wbp w, int status)
   {
   wsp ws = w->window;

   if (!resizePixmap(w, ws->width, ws->height))
      return Failed;
#if defined(Graphics3D) && HAVE_LIBGL
   if (ws->is_3D)
      sdl_gl_resize(w);
#endif                                  /* Graphics3D && HAVE_LIBGL */
   if (ws->win) {
      if (status == 1)
         usdl_set_position(ws->win, ws->posx, ws->posy);
      else {
         usdl_set_size(ws->win, ws->width, ws->height);
         if (status == 3 && ws->posx != -(MaxInt) && ws->posy != -(MaxInt))
            usdl_set_position(ws->win, ws->posx, ws->posy);
         }
      usdl_sync(ws->win);
      drain_events();
      present(ws, 1);
      }
   else if (ISSUBWIN(ws)) {
      subwin_changed(ws);
      present(ws, 1);
      }
   return Succeeded;
   }

int moveResizeWindow(wbp w, int x, int y, int width, int height)
   {
   wsp ws = w->window;
   ws->width = width;
   ws->height = height;
   if (x != -(MaxInt)) ws->posx = x;
   if (y != -(MaxInt)) ws->posy = y;
   return do_config(w, (x == -(MaxInt) || y == -(MaxInt)) ? 2 : 3);
   }

/*
 * resizePixmap(w,width,height) -- ensure w's canvas is at least
 * width x height pixels.  Returns 0 on failure.
 */
int resizePixmap(wbp w, int width, int height)
   {
   wsp ws = w->window;
   if (ws->pix == NULL) return 1;
   if (width > ws->pixwidth || height > ws->pixheight) {
      int nw = Max(ws->pixwidth, width), nh = Max(ws->pixheight, height);
      int ok;
      /* do not free the pixels while another thread is uploading them */
      usdl_lock();
      ok = uc_canvas_resize(ws->pix, nw, nh, (unsigned int)w->context->bg);
      usdl_unlock();
      if (!ok)
         return 0;
      ws->pixwidth = nw;
      ws->pixheight = nh;
      }
   return 1;
   }

/*
 * ------------------------------------------------------------------
 * Window attributes
 * ------------------------------------------------------------------
 */

int setheight(wbp w, SHORT new_height)
   {
   if (new_height < 0) return Failed;
   w->window->height = new_height;
   return Succeeded;
   }

int setwidth(wbp w, SHORT new_width)
   {
   if (new_width < 0) return Failed;
   w->window->width = new_width;
   return Succeeded;
   }

int setgeometry(wbp w, char *geo)
   {
   int width = 0, height = 0;
   int x = 0, y = 0, status;
   wsp ws = w->window;

   if ((status = parsegeometry(geo, &x, &y, &width, &height)) == 0)
      return RunError;
   if (status & 1) {
      ws->width = width;
      ws->height = height;
      }
   /*
    * can't set position on hidden windows (but can on opening ones);
    * a subwindow is placed in its parent, shown or not
    */
   if ((ws->win || !ws->pix || ISSUBWIN(ws)) && (status & 2)) {
      ws->posx = x;
      ws->posy = y;
      }
   return Succeeded;
   }

int allowresize(wbp w, int on)
   {
   if (on)
      SETRESIZABLE(w);
   else
      CLRRESIZABLE(w);
   if (w->window->win)
      usdl_set_resizable(w->window->win, on);
   return Succeeded;
   }

void warpPointer(wbp w, int x, int y)
   {
   if (w->window->win)
      usdl_warp_pointer(w->window->win, x, y);
   }

int seticonlabel(wbp w, char *val)
   {
   wsp ws = w->window;
   CURTSTATE();
   if (ws->iconlabel != NULL) free(ws->iconlabel);
   if ((ws->iconlabel = salloc(val)) == NULL)
      ReturnErrNum(305, RunError);
   return Succeeded;
   }

int setwindowlabel(wbp w, char *s)
   {
   wsp ws = w->window;
   CURTSTATE();
   if (ws->windowlabel != NULL) free(ws->windowlabel);
   if ((ws->windowlabel = salloc(s)) == NULL)
      ReturnErrNum(305, RunError);
   if (ws->win)
      usdl_set_title(ws->win, ws->windowlabel);
   return Succeeded;
   }

/*
 * setcursor() - turn the text cursor on or off
 */
int setcursor(wbp w, int on)
   {
   if (on)
      SETCURSORON(w);
   else
      CLRCURSORON(w);
   return Succeeded;
   }

/*
 * setpointer() - define a mouse pointer shape
 */
int setpointer(wbp w, char *val)
   {
   int i = si_s2i(cursorsyms, val);
   wsp ws = w->window;

   if (i < 0) return Failed;
   if (ws->cursorname) free(ws->cursorname);
   ws->cursorname = salloc(val);
   ws->cursor = i;
   if (ws->win)
      usdl_set_cursor(ws->win, i);
   return Succeeded;
   }

/*
 * setdrawop() - set the drawing operation
 */
int setdrawop(wbp w, char *val)
   {
   wcp wc = w->context;

   if (!strcmp(val,"reverse")) {
      if (!ISXORREVERSE(w)) {
         SETXORREVERSE(w);
         wc->drawop = DRAWOP_XOR;
         }
      }
   else {
      if (ISXORREVERSE(w))
         CLRXORREVERSE(w);
      wc->drawop = si_s2i(drawops,val);
      if (wc->drawop == -1) { wc->drawop = DRAWOP_COPY; return RunError; }
      }
   return Succeeded;
   }

/*
 * rebind() - bind w's context to that of w2.
 */
int rebind(wbp w, wbp w2)
   {
   if (w->window->display != w2->context->display) return Failed;
   w->context = w2->context;
   return Succeeded;
   }

/*
 * Clipping is read from the context whenever something is drawn.
 */
void setclip(wbp w)
   {
   }

void unsetclip(wbp w)
   {
   }

void getcanvas(wbp w, char *s)
   {
   if (w->window->win == NULL) sprintf(s, "hidden");
   else
      switch (w->window->iconic) {
      case NormalState:
         sprintf(s, "normal");
         break;
      case IconicState:
         sprintf(s, "iconic");
         break;
      case MaximizedState:
         sprintf(s, "maximal");
         break;
      case HiddenState:
         sprintf(s, "hidden");
         break;
      default:
         sprintf(s, "???");
      }
   }

/*
 * The selection is the system clipboard.  WAttrib() copies the result
 * and frees it.
 */
char *getselection(wbp w, char *buf)
   {
   return usdl_get_clipboard();
   }

int setselection(wbp w, dptr val)
   {
   if (!usdl_set_clipboard(StrLoc(*val), StrLen(*val)))
      return Failed;
   return Succeeded;
   }

int setinputmask(wbp w, char *val)
   {
   wsp ws = w->window;
   if (strchr(val,'k'))
      ws->inputmask |= KeyReleaseMask;
   else
      ws->inputmask &= ~KeyReleaseMask;
   if (strchr(val,'m'))
      ws->inputmask |= PointerMotionMask;
   else
      ws->inputmask &= ~PointerMotionMask;
   if (strchr(val,'c'))
      ws->inputmask |= WindowClosureMask;
   else
      ws->inputmask &= ~WindowClosureMask;
   return Succeeded;
   }

/*
 *  Set the canvas type, either during open (canvas is null, set a flag)
 *   or change an existing canvas to a different type.
 */
int setcanvas(wbp w, char *s)
   {
   wsp ws = w->window;

   if (ISSUBWIN(ws)) {                  /* shown or not, over the parent */
      if (!strcmp(s, "hidden"))
         ws->iconic = HiddenState;
      else if (!strcmp(s, "normal") || !strcmp(s, "iconic") ||
               !strcmp(s, "maximal"))
         ws->iconic = NormalState;
      else
         return RunError;
      if (ws->pix) {
         subwin_changed(ws);
         present(ws, 1);
         }
      return Succeeded;
      }

   if (!strcmp(s, "iconic")) {
      if (ws->pix == NULL)
         ws->iconic = IconicState;
      else {
         if (ws->win == NULL) {
            ws->iconic = IconicState;
            if (sdl_mapwindow(w) != Succeeded) return Failed;
            }
         else if (ws->iconic != IconicState)
            usdl_minimize(ws->win);
         ws->iconic = IconicState;
         }
      }
   else if (!strcmp(s, "normal")) {
      if (ws->pix == NULL)
         ws->iconic = NormalState;
      else {
         if (ws->win == NULL) {
            ws->iconic = NormalState;
            if (sdl_mapwindow(w) != Succeeded) return Failed;
            }
         else {
            if (ws->iconic == IconicState || ws->iconic == MaximizedState)
               usdl_restore(ws->win);
            usdl_show(ws->win);
            ws->iconic = NormalState;
            }
         }
      }
   else if (!strcmp(s, "maximal")) {
      if (ws->pix == NULL)
         ws->iconic = MaximizedState;
      else {
         if (ws->win == NULL) {
            ws->iconic = MaximizedState;
            if (sdl_mapwindow(w) != Succeeded) return Failed;
            }
         else {
            usdl_show(ws->win);
            usdl_maximize(ws->win);
            }
         ws->iconic = MaximizedState;
         }
      }
   else if (!strcmp(s, "hidden")) {
      if (ws->pix == NULL)
         ws->iconic = HiddenState;
      else if (ws->win) {
         usdl_hide(ws->win);
         ws->iconic = HiddenState;
         }
      }
   else return RunError;
   if (ws->win) {
      usdl_sync(ws->win);
      drain_events();
      present(ws, 1);
      }
   return Succeeded;
   }

int seticonicstate(wbp w, char *s)
   {
   wsp ws = w->window;

   if (!strcmp(s, "icon")) {
      if (ws->pix == NULL)
         ws->iconic = IconicState;
      else if (ws->win) {
         usdl_minimize(ws->win);
         ws->iconic = IconicState;
         }
      }
   else if (!strcmp(s, "window")) {
      if (ws->win && ws->iconic == IconicState) {
         usdl_restore(ws->win);
         ws->iconic = NormalState;
         }
      }
   else if (!strcmp(s, "root"))
      return Failed;
   else return RunError;
   return Succeeded;
   }

int seticonpos(wbp w, char *s)
   {
   char *s2;
   wsp ws = w->window;

   s2 = s;
   ws->iconx = atol(s2);
   while (isspace(*s2)) s2++;
   while (isdigit(*s2)) s2++;
   if (*s2++ != ',') return Failed;
   ws->icony = atol(s2);
   return Succeeded;
   }

int geticonpos(wbp w, char *s)
   {
   wsp ws = w->window;
   sprintf(s, "%d,%d", ws->iconx, ws->icony);
   return Succeeded;
   }

#define XIMG_CLEAR 0x01000000U         /* a transparent (None) XPM pixel */
static unsigned int *ximg_load(char *filename, unsigned int fg,
                               unsigned int bg, int *width, int *height);

/*
 * The window's icon: an image file (any format ReadImage() reads) or
 * the contents of another window.
 */
static struct ucanvas *iconcanvas(wbp w, char *filename)
   {
   struct imgdata imd;
   struct ucanvas *c;
   struct ucgc gc;
   unsigned int *px;
   int i, j, width, height;

   uc_gc_init(&gc);
   imd.format = UCOLOR_RGB;
   imd.is_bottom_up = 0;
   imd.paltbl = NULL;
   imd.data = NULL;
   if (readImage(filename, 0, &imd) == Succeeded) {
      unsigned char *d = imd.data;
      c = uc_canvas_new(imd.width, imd.height, (unsigned int)w->context->bg);
      if (c) {
         for (j = 0; j < imd.height; j++)
            for (i = 0; i < imd.width; i++) {
               unsigned int rgb;
               if (imd.paltbl) {
                  struct palentry *e = &imd.paltbl[*d++];
                  if (!e->valid) continue;  /* transparent */
                  /* file colors are already the ones to show */
                  rgb = ((unsigned int)(e->clr.red >> 8) << 16) |
                        ((unsigned int)(e->clr.green >> 8) << 8) |
                        (unsigned int)(e->clr.blue >> 8);
                  }
               else {
                  rgb = (d[0] << 16) | (d[1] << 8) | d[2];
                  d += 3;
                  }
               uc_put_pixel(c, &gc, i, j, rgb);
               }
         }
      free(imd.paltbl);
      free(imd.data);
      return c;
      }

   px = ximg_load(filename, (unsigned int)w->context->fg,
                  (unsigned int)w->context->bg, &width, &height);
   if (px == NULL) return NULL;
   c = uc_canvas_new(width, height, (unsigned int)w->context->bg);
   if (c)
      for (j = 0; j < height; j++)
         for (i = 0; i < width; i++)
            if (px[(long)j * width + i] != XIMG_CLEAR)
               uc_put_pixel(c, &gc, i, j, px[(long)j * width + i]);
   free(px);
   return c;
   }

int seticonimage(wbp w, dptr dp)
   {
   tended char *tmp;
   {
   wsp ws = w->window;
   struct ucanvas *c = NULL;
   char *name;
   struct ucgc gc;

   if (is:file(*dp) && (BlkD(*dp,File)->status & Fs_Window)) {
      wbp x = BlkLoc(*dp)->File.fd.wb;
      struct ucanvas *src = x->window->pix;
      if (src == NULL) return Failed;
      uc_gc_init(&gc);
      c = uc_canvas_new(src->width, src->height, 0xFFFFFF);
      if (c == NULL) ReturnErrNum(305, RunError);
      uc_copy_area(src, 0, 0, src->width, src->height, c, &gc, 0, 0);
      name = x->window->windowlabel ? x->window->windowlabel : "";
      }
   else if (is:string(*dp)) {
      if (!cnv:C_string(*dp, tmp))
         ReturnErrVal(103, *dp, RunError);
      if ((c = iconcanvas(w, tmp)) == NULL)
         return Failed;
      name = tmp;
      }
   else
      return Failed;

   if (ws->iconimage) free(ws->iconimage);
   if ((ws->iconimage = salloc(name)) == NULL) {
      uc_canvas_free(c);
      ReturnErrNum(305, RunError);
      }
   if (ws->iconpix) uc_canvas_free(ws->iconpix);
   ws->iconpix = c;
   if (ws->win) usdl_set_icon(ws->win, c);
   return Succeeded;
   }
   }

/*
 * Set the context's fill style by name.
 */
int setfillstyle(wbp w, char *s)
   {
   wcp wc = w->context;

   if (!strcmp(s, "solid")) {
      wc->fillstyle = FS_SOLID;
      }
   else if (!strcmp(s, "masked")
            || !strcmp(s, "stippled") || !strcmp(s, "patterned")) {
      wc->fillstyle = FS_STIPPLE;
      }
   else if (!strcmp(s, "textured")
      || !strcmp(s, "opaquestippled") || !strcmp(s, "opaquepatterned")) {
      wc->fillstyle = FS_OPAQUESTIPPLE;
      }
   else return RunError;
   return Succeeded;
   }

/*
 * Set the context's line style by name.
 */
int setlinestyle(wbp w, char *s)
   {
   wcp wc = w->context;

   if (!strcmp(s, "solid")) {
      wc->linestyle = UC_LINE_SOLID;
      }
   else if (!strcmp(s, "onoff") || !strcmp(s, "dashed")) {
      wc->linestyle = UC_LINE_DASHED;
      }
   else if (!strcmp(s, "doubledash") || !strcmp(s, "striped")) {
      wc->linestyle = UC_LINE_STRIPED;
      }
   else return RunError;
   return Succeeded;
   }

/*
 * Set the context's line width
 */
int setlinewidth(wbp w, LONG linewid)
   {
   if (linewid < 0) return RunError;
   w->context->linewidth = linewid;
   return Succeeded;
   }

/*
 * Set the context's foreground color by name.
 */
int setfg(wbp w, char *s)
   {
   long r, g, b, a;
   wcp wc = w->context;
   if (parsecolor(w, s, &r, &g, &b, &a) != Succeeded)
      return Failed;
   wc->fg = sdl_rgb(w, r, g, b);
   if (wc->fgname == NULL || strcmp(wc->fgname, s)) {
      if (wc->fgname) free(wc->fgname);
      wc->fgname = salloc(s);
      }
   return Succeeded;
   }

/*
 * Set the context's foreground color by a 24-bit value; negative
 * values name mutable colors, which this backend does not have.
 */
int isetfg(wbp w, int fg)
   {
   char tmp[32];
   if (fg < 0) return Failed;
   sprintf(tmp, "%d,%d,%d", ((fg >> 16) & 255) * 257, ((fg >> 8) & 255) * 257,
           (fg & 255) * 257);
   return setfg(w, tmp);
   }

/*
 * Set the window context's background color by name.
 */
int setbg(wbp w, char *s)
   {
   long r, g, b, a;
   wcp wc = w->context;
   if (parsecolor(w, s, &r, &g, &b, &a) != Succeeded)
      return Failed;
   wc->bg = sdl_rgb(w, r, g, b);
   if (wc->bgname == NULL || strcmp(wc->bgname, s)) {
      if (wc->bgname) free(wc->bgname);
      wc->bgname = salloc(s);
      }
   return Succeeded;
   }

int isetbg(wbp w, int bg)
   {
   char tmp[32];
   if (bg < 0) return Failed;
   sprintf(tmp, "%d,%d,%d", ((bg >> 16) & 255) * 257, ((bg >> 8) & 255) * 257,
           (bg & 255) * 257);
   return setbg(w, tmp);
   }

/*
 * Set the gamma correction value.
 */
int setgamma(wbp w, double gamma)
   {
   wcp wc = w->context;
   char *fg = wc->fgname ? salloc(wc->fgname) : NULL;
   char *bg = wc->bgname ? salloc(wc->bgname) : NULL;
   wc->gamma = gamma;
   if (fg) { setfg(w, fg); free(fg); }         /* reinterpret current Fg/Bg */
   if (bg) { setbg(w, bg); free(bg); }
   return Succeeded;
   }

/*
 * Set the display by name; only possible before the window is mapped.
 */
int setdisplay(wbp w, char *s)
   {
   wdp d;
   if (w->window->pix != NULL)
      return Failed;
   Protect(d = alc_display(s), return 0);
   w->window->display = d;
   return Succeeded;
   }

int setleading(wbp w, int i)
   {
   w->context->leading = i;
   return Succeeded;
   }


void toggle_fgbg(wbp w)
   {
   wcp wc = w->context;
   unsigned long tmp;
   char *stmp;
   tmp = wc->fg; wc->fg = wc->bg; wc->bg = tmp;
   stmp = wc->fgname; wc->fgname = wc->bgname; wc->bgname = stmp;
   }

void getdisplay(wbp w, char *answer)
   {
   wdp wd = w->window->display;
   if (!strcmp(wd->name, "")) {
      if (getenv_r("DISPLAY", answer, 256) == -1)
         *answer = '\0';
      }
   else sprintf(answer, "%s", wd->name);
   }

int getvisual(wbp w, char *answer)
   {
   sprintf(answer, "%d,%d,%d", 4, 8, 256);      /* TrueColor, 8 bits */
   return Succeeded;
   }

/*
 * getpos() - update the window state's notion of its current position
 */
int getpos(wbp w)
   {
   wsp ws = w->window;
   if (ISSUBWIN(ws)) return Succeeded;  /* posx, posy are in the parent */
   if (!ws->win) return Failed;
   usdl_get_position(ws->win, &ws->posx, &ws->posy);
   return Succeeded;
   }

void getfg(wbp w, char *answer)
   {
   sprintf(answer, "%s", w->context->fgname ? w->context->fgname : "black");
   }

void getbg(wbp w, char *answer)
   {
   sprintf(answer, "%s", w->context->bgname ? w->context->bgname : "white");
   }

void getlinestyle(wbp w, char *answer)
   {
   wcp wc = w->context;
   sprintf(answer,"%s",
           (wc->linestyle==UC_LINE_SOLID)?"solid":
           ((wc->linestyle==UC_LINE_DASHED)?"dashed":"striped"));
   }

void getfntnam(wbp w, char *answer)
   {
   sprintf(answer,"%s", w->context->font->name);
   }

void getpointername(wbp w, char *answer)
   {
   strcpy(answer, w->window->cursorname ? w->window->cursorname : "left ptr");
   }

void getdrawop(wbp w, char *answer)
   {
   char *s;
   if (ISXORREVERSE(w)) s = "reverse";
   else s = si_i2s(drawops, w->context->drawop);
   if (s) sprintf(answer, "%s", s);
   else strcpy(answer, "copy");
   }

void geticonic(wbp w, char *answer)
   {
   switch (w->window->iconic) {
   case NormalState:
   case MaximizedState:
     sprintf(answer, "window");
     break;
   case IconicState:
     sprintf(answer, "icon");
     break;
   default:
     sprintf(answer, "???");
   }
   }

/*
 * ------------------------------------------------------------------
 * Fonts
 * ------------------------------------------------------------------
 */

/*
 * Open the font described by an Icon font spec ("family,styles,size").
 * The family may also be the path of a TrueType or OpenType file.
 */
static wfp sdl_mkfont(char *s)
   {
   char family[MAXFONTWORD+1], name[256], rest[256], *p;
   int style, size, tp, flags = 0, n;
   struct ucfont *uf;
   wfp f;

   /*
    * The first word is the family, or a font file.  parsefont()
    * lowercases the family and limits its length, so a file name is
    * taken as written and only the rest of the spec is parsed.
    */
   for (p = s; isspace(*p); p++)
      ;
   for (n = 0; *p && *p != ',' && n < (int)sizeof(name) - 1; p++)
      name[n++] = *p;
   while (n > 0 && isspace(name[n-1])) n--;
   name[n] = '\0';
   if (strchr(name, '/') || strchr(name, '.')) {
      snprintf(rest, sizeof(rest), "file%s", p);
      if (!parsefont(rest, family, &style, &size, &tp))
         return NULL;
      }
   else {
      if (!parsefont(s, family, &style, &size, &tp))
         return NULL;
      strcpy(name, family);
      }

   if (style & (FONTFLAG_BOLD | FONTFLAG_DEMI)) flags |= UC_FONT_BOLD;
   if (style & (FONTFLAG_ITALIC | FONTFLAG_OBLIQUE)) flags |= UC_FONT_ITALIC;
   if (style & FONTFLAG_MONO) flags |= UC_FONT_MONO;
   if (size <= 0)
      size = strcmp(family, "fixed") ? DEFAULTFONTSIZE : 13;

   uf = uc_font_open(name, flags, size);
   if (uf == NULL)
      return NULL;
   f = calloc(1, sizeof(struct _wfont));
   if (f == NULL) {
      uc_font_close(uf);
      return NULL;
      }
   f->refcount = 1;
   f->name = salloc(s);
   f->size = size;
   f->uf = uf;
   f->ascent = uc_font_ascent(uf);
   f->descent = uc_font_descent(uf);
   f->height = f->ascent + f->descent;
   f->maxwidth = uc_font_maxwidth(uf);
   return f;
   }

static void sdl_freefont(wfp f)
   {
   if (f == NULL || --f->refcount > 0) return;
   uc_font_close(f->uf);
   if (f->name) free(f->name);
   free(f);
   }

/*
 * Set the window's font by name.
 */
int setfont(wbp w, char **s)
   {
   wfp tmp;
   wcp wc = w->context;
   wsp ws = w->window;

#if defined(Graphics3D) && HAVE_LIBGL
   if (wc->is_3D) {
      mkfont3d(*s);
      return Succeeded;
      }
#endif                                  /* Graphics3D && HAVE_LIBGL */

   Protect(tmp = sdl_mkfont(*s), return Failed);
   sdl_freefont(wc->font);
   wc->font = tmp;
   wc->leading = tmp->height;

   if (ws->pix == NULL) {
      ws->y = wc->font->ascent;
      ws->x = 0;
      }
   return Succeeded;
   }

/*
 * ------------------------------------------------------------------
 * Drawing
 * ------------------------------------------------------------------
 */

void drawarcs(wbp w, XArc *arcs, int narcs)
   {
   int i;
   STDLOCALS(w);
   for (i = 0; i < narcs; i++)
      uc_draw_arc(stdpix, stdgc, arcs[i].x, arcs[i].y, arcs[i].width,
                  arcs[i].height, arcs[i].angle1, arcs[i].angle2);
   }

void fillarcs(wbp w, XArc *arcs, int narcs)
   {
   int i;
   STDLOCALS(w);
   for (i = 0; i < narcs; i++)
      uc_fill_arc(stdpix, stdgc, arcs[i].x, arcs[i].y, arcs[i].width,
                  arcs[i].height, arcs[i].angle1, arcs[i].angle2);
   }

void drawlines(wbp w, XPoint *points, int npoints)
   {
   STDLOCALS(w);
   uc_draw_lines(stdpix, stdgc, (struct ucpoint *)points, npoints);
   }

void drawpoints(wbp w, XPoint *points, int npoints)
   {
   STDLOCALS(w);
   uc_draw_points(stdpix, stdgc, (struct ucpoint *)points, npoints);
   }

void drawsegments(wbp w, XSegment *segs, int nsegs)
   {
   STDLOCALS(w);
   uc_draw_segments(stdpix, stdgc, (struct ucpoint *)segs, nsegs);
   }

void drawrectangles(wbp w, XRectangle *recs, int nrecs)
   {
   int i;
   STDLOCALS(w);
   for (i = 0; i < nrecs; i++)
      uc_draw_rect(stdpix, stdgc, recs[i].x, recs[i].y, recs[i].width,
                   recs[i].height);
   }

void fillrectangles(wbp w, XRectangle *recs, int nrecs)
   {
   int i;
   STDLOCALS(w);
   for (i = 0; i < nrecs; i++)
      uc_fill_rect(stdpix, stdgc, recs[i].x, recs[i].y, recs[i].width,
                   recs[i].height);
   }

void fillpolygon(wbp w, XPoint *pts, int npts)
   {
   STDLOCALS(w);
   uc_fill_polygon(stdpix, stdgc, (struct ucpoint *)pts, npts);
   }

void drawstrng(wbp w, int x, int y, char *s, int slen)
   {
   STDLOCALS(w);
   uc_draw_text(stdpix, stdgc, wc->font->uf, x, y, s, slen, 0);
   }

/*
 * erase an area
 */
void eraseArea(wbp w, int x, int y, int width, int height)
   {
   struct ucgc gc;
   STDLOCALS(w);

   /*
    * if width >= window width or height >= window height, clear any
    * offscreen portion of the canvas as well.
    */
   if (x + width  >= (int)ws->width)  width  = ws->pixwidth - x;
   if (y + height >= (int)ws->height) height = ws->pixheight - y;

   gc = *stdgc;
   gc.op = UC_OP_COPY;
   gc.fillstyle = UC_FILL_SOLID;
   gc.fg = (unsigned int)wc->bg;
   uc_fill_rect(stdpix, &gc, x, y, width, height);
   }

/*
 * copy an area; parts of the source outside its canvas come out in
 * the destination's background color
 */
int copyArea(wbp w, wbp w2, int x, int y, int width, int height, int x2, int y2)
   {
   int lpad, rpad, tpad, bpad;
   struct ucanvas *src = w->window->pix;
   struct ucgc gc;
   wsp ws1 = w->window;
   STDLOCALS(w2);

   if (src == NULL || stdpix == NULL) return Failed;
   gc = *stdgc;
   gc.op = UC_OP_COPY;
   gc.fillstyle = UC_FILL_SOLID;
   gc.fg = (unsigned int)wc->bg;

   if (x+width<0 || y+height<0 || x>=ws1->pixwidth || y>=ws1->pixheight) {
      /* source is entirely offscreen */
      uc_fill_rect(stdpix, &gc, x2, y2, width, height);
      return Succeeded;
      }

   lpad = rpad = tpad = bpad = 0;
   if (x < 0) {                   /* source extends past left edge */
      lpad = -x;
      width -= lpad;
      x2 += lpad;
      x = 0;
      }
   if (x + width > ws1->pixwidth) {  /* source extends past right edge */
      rpad = x + width - ws1->pixwidth;
      width -= rpad;
      }
   if (y < 0) {                   /* source extends above top edge */
      tpad = -y;
      height -= tpad;
      y2 += tpad;
      y = 0;
      }
   if (y + height > ws1->pixheight) {  /* source extends below bottom */
      bpad = y + height - ws1->pixheight;
      height -= bpad;
      }

   uc_copy_area(src, x, y, width, height, stdpix, &gc, x2, y2);

   if (lpad > 0)
      uc_fill_rect(stdpix, &gc, x2-lpad, y2-tpad, lpad, tpad+height+bpad);
   if (rpad > 0)
      uc_fill_rect(stdpix, &gc, x2+width, y2-tpad, rpad, tpad+height+bpad);
   if (tpad > 0)
      uc_fill_rect(stdpix, &gc, x2, y2-tpad, width, tpad);
   if (bpad > 0)
      uc_fill_rect(stdpix, &gc, x2, y2+height, width, bpad);
   return Succeeded;
   }

