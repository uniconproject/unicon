link glsnap
procedure main()
   w := open("dl","gl","size=320,240","bg=black") | stop("open: ",&errortext)
   Fg(w,"red");  DrawCube(w,-0.6,0,-3,0.5)
   Fg(w,"blue"); DrawCube(w,0.6,0,-3,0.5)
   L := WindowContents(w)
   write(*L)
   pull(L)
   Refresh(w)
   write(*WindowContents(w))
   snap(w,"t06_dlist")
end
