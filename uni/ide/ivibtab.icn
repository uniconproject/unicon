   end

########################################################
# Methods to create components and add them to the canvas.
#

   #
   # Add a new CanvasComponent using the given CanvasComponentUI to
   # create it.
   #
   method create_in_canvas(object_ui)
      local t
      self.push_undo()
      t := object_ui.create_canvas_component(self.canvas)
      add_new_object(t)
   end

   method op_CheckBoxGroup()
      canvas.selections_to_cbg()
   end

   method op_ButtonGroup()
      canvas.selections_to_bg()
   end

   #
   # Add a new object to the canvas.
   #
   method add_new_object(c)
      static add_count
      initial
         add_count := 0
      c.set_name(self.canvas.get_new_name(c.name))
      #
      # Default x, y.  Try to avoid successive adds covering each other.
      #
      /c.x_spec := 10 + 7 * (add_count % 4)
      /c.y_spec := 10 + 7 * (add_count % 4)
      add_count +:= 1
      c.set_align("l", "t")
      c.set_parent_Canvas(self.canvas)
      c.set_parent(self.canvas)
      c.init()
      c.resize()
      c.firstly()
      self.canvas.add(c)
      self.canvas.set_modified()
      self.canvas.invalidate()
   end

########################################################
# Copy, deletion, fixing and unfixing of components.
#

   method op_Copy()
      canvas.copy_selections()
   end

   method op_Delete()
      canvas.delete_selections()
   end

   method op_fix()
      canvas.fix()
   end

   method op_unfix()
      canvas.unfix()
   end

########################################################
# Dialogs.
#

   #
   # Canvas dialog preferences.
   #
   method op_preferences()
      local t, d
      t := self.canvas.dup()
      d := canvas.dialog()
      d.show_modal(self.parent_dialog)
      if \d.get_okay_result() then {
         self.push_onto_undo(t)
         self.canvas.set_modified()
         self.canvas.erase_and_display()
         self.canvas.update_pos_label()
      }
   end

   #
   # Dialog for the selected component, or the canvas if none.
   #
   method op_dialog()
      local d, t
      if /self.canvas.selected then
         op_preferences()
      else {
         t := canvas.dup()
         d := canvas.selected.dialog()
         d.show_modal(self.parent_dialog)
         if \d.get_okay_result() then {
            self.push_onto_undo(t)
            canvas.set_modified()
            canvas.invalidate()
            canvas.update_pos_label()
         }
      }
   end

   method op_check_boxes()
      local t, d
      t := self.canvas.dup()
      d := GroupSetDialog(canvas.checkbox_groups)
      d.show_modal(self.parent_dialog)
      if \d.get_okay_result() then {
         self.push_onto_undo(t)
         self.canvas.set_modified()
      }
   end

   method op_button_groups()
      local t, d
      t := self.canvas.dup()
      d := GroupSetDialog(canvas.button_groups)
      d.show_modal(self.parent_dialog)
      if \d.get_okay_result() then {
         self.push_onto_undo(t)
         self.canvas.set_modified()
      }
   end

########################################################
# Layout parsing.
#

   #
   # Return the index of the layout marker line in lines, if any.
   #
   method find_marker(lines)
      local i
      every i := *lines to 1 by -1 do
         if trim(lines[i], ' \t\r') == (v1_marker | v2_marker) then
            return i
   end

   #
   # Return the Canvas encoded at the end of lines.  Fails, with a
   # message for a damaged layout, if there is none.
   #
   method parse_layout(lines)
      local i, marker, s, t, c, d
      i := find_marker(lines) | fail
      marker := trim(lines[i], ' \t\r')
      t := ""
      every s := lines[i + 1 to *lines] do {
         s := trim(s, ' \t\r')
         if s[1] == "#" then
            t ||:= s[2:0]
         else
            break
      }
      if *t = 0 then
         return alert_error("Malformed ivib layout")

      if marker == v1_marker then {
         t := migrate(t) | return alert_error("Unable to migrate ivib v1 layout")
         c := lang::decode(t) | return alert_error("Invalid ivib layout")
         d := InfoDialog(["Ivib v1 layout successfully loaded.",
                          "",
                          "NB - some manual editing may be needed after",
                          "the code is next generated."],
                         "Ivib v1 import",
                         310,
                         "Close",
                         "l")
         d.show_modal(self.parent_dialog)
         #
         # Mark as modified so the v2 changes can simply be generated.
         #
         c.modified := 1
      }
      else
         c := lang::decode(t) | return alert_error("Invalid ivib layout")

      instanceof(c, "Canvas") | return alert_error("Invalid ivib layout")
      return c
   end

########################################################
# Code generation.
#

   #
   # The source of a minimal dialog class, used when the buffer does not
   # have an ivib dialog yet.
   #
   method skeleton()
      return ["import gui",
              "$include \"guih.icn\"",
              "",
              "class Untitled : Dialog()",
              "   method component_setup()",
              "      self.setup()",
              "   end",
              "",
              "   method end_dialog()",
              "      #To close overall program use: exit(0)",
              "      #To close a single dialog window use: dispose()",
              "   end",
              "",
              "   method init_dialog()",
              "   end",
              "",
              "   method setup()",
              "   end",
              "",
              "   initially",
              "      self.Dialog.initially()",
              "      self.connect(self, \"dispose\", CLOSE_BUTTON_EVENT)",
              "end",
              "",
              "#You can invoke your ivib layout with something like this:",
              "#procedure main()",
              "#   local d",
              "#   d := Untitled()",
              "#   d.show_modal()",
              "#end",
              ""]
   end

   #
   # Succeed if lines contain a setup method for ivib to replace.
   #
   method has_setup(lines)
      local s
      every s := !lines do
         s ? {
            tab(many(' \t'))
            if ="method" & tab(many(' \t')) & ="setup" &
               not any(&letters ++ &digits ++ '_') then
               return
         }
   end

   #
   # A name for a scratch file that does not exist yet.
   #
   method temp_name()
      local dir, s
      dir := ("" ~== getenv("TMPDIR" | "TEMP" | "TMP")) |
             (if &features == "MS Windows" then "." else "/tmp")
      repeat {
         s := dir || "/uivib" || ?999999 || ".icn"
         if not close(open(s)) then
            return s
      }
   end

   #
   # Return lines with the code and layout for the current canvas put
   # in place.  Code generation (ivib/code.icn) works on files, so this
   # goes through scratch files.
   #
   method gen_into_lines(lines)
      local src, prefix, in_name, out_name, f, res, ok
      if has_setup(lines) then
         src := lines
      else {
         # No ivib dialog yet: generate one and append it.
         src := skeleton()
         prefix := lines
      }

      in_name := temp_name()
      out_name := in_name[1:-4] || "-out.icn"
      if f := open(in_name, "w") then {
         every write(f, trim(!src, '\r'))
         close(f)
         if self.canvas.gen_code().interpose_code(in_name, out_name) &
            (f := open(out_name)) then {
            res := []
            while put(res, read(f))
            close(f)
            ok := 1
         }
      }
      else
         alert_error("Couldn't open " || in_name)
      every remove(in_name | out_name | (out_name || ".temp"))
      \ok | fail

      if \prefix then {
         prefix := copy(prefix)
         while *prefix > 0 & trim(prefix[-1], ' \t\r') == "" do
            pull(prefix)
         if *prefix > 0 then
            put(prefix, "")
         res := prefix ||| res
      }
      return res
   end

   #
   # The "Generate UI Code" command: generate the code for the canvas
   # into the current editor buffer.  The buffer is marked modified;
   # saving it writes the file.
   #
   method op_push_code_to_ui()
      sync_with_tab()
      return generate_code()
   end

   #
   # Generate the code into the current buffer, which must be the one
   # the canvas belongs to.  Unless saving (the buffer is about to be
   # written), mark the buffer modified.
   #
   method generate_code(saving)
      local t, eb, res
      t := (\ide).CurrentTabItem() | fail
      t === \self.editor_tab | return alert_error("Show the Files/IVIB view first")
      eb := ide.CurrentEditBox() | fail
      res := gen_into_lines(eb.get_contents() | []) | fail
      eb.set_contents(res)
      self.canvas.clear_modified()
      if /saving & not (t.label[-1] == "*") then {
         t.label ||:= "*"
         uidlog.FileTabSet.resize()
      }
      uidlog.FileBrowser.addreplace(res, t.filename, 0)
      message("Generated UI code into " || (tab_path(t) | t.filename))
      return
   end

   #
   # If the canvas belongs to editor tab t and has changes that are not
   # in the buffer yet, generate them into the buffer.  Used before t is
   # saved.
   #
   method generate_if_modified(t)
      if t === \self.editor_tab === (\ide).CurrentTabItem() &
         \self.canvas.modified then
         return generate_code(1)
   end

########################################################
# Components.
#

   #
   # Load component operation.
   #
   method op_component_load(x, y)
      local fd, s, f, c, d
      fd := FileDialog()
      fd.set_directory(\last_layout_dir)
      fd.show_modal(self.parent_dialog)
      s := fd.get_result() | fail
      last_layout_dir := fd.get_directory()
      f := ::open(s) | return alert_error("Couldn't open " || s)
      c := lang::decode(read(f))
      close(f)
      instanceof(c, "CanvasComponent") | return alert_error("Invalid file format")

      self.push_undo()

      c.set_pos(x, y)

      #
      # Set up the fields recursively by duplicating the uninitialized object.
      #
      d := c.dup(self.canvas, self.canvas)
      d.set_parent(self.canvas)
      d.init()
      d.resize()
      d.firstly()

      #
      # Now add it to the canvas.
      #
      self.canvas.add(d)
      self.canvas.set_modified()
      self.invalidate()
   end

   #
   # Popup Dialog to set component load position.
   #
   method op_popup_dialog_component_load()
      op_component_load(popup_dialog.x - canvas.x, popup_dialog.y - canvas.y)
   end

   #
   # Load component at position (10, 10)
   #
   method op_component_load_10()
      op_component_load(10, 10)
   end

   method op_component_save()
      canvas.component_save()
   end

   #
   # Put the canvas at its place below the tool bar.
   #
   method reset_canvas_pos(c)
      c.set_pos(CANVAS_SURROUND, self.tool_area_height + CANVAS_SURROUND)
      if c === self.canvas then {
         self.resize()
         c.erase_and_display()
         c.update_pos_label()
      }
   end

   #
   # The canvas items are not children of the canvas; reposition them
   # whenever the component is resized or moved, so they follow the
   # canvas when the ivib panel is shown, hidden or resized.
   #
   method resize()
      self.Component.resize()
      every (!(\self.canvas).items).resize()
   end

########################################################
# Configuration file, shared with standalone ivib.
#

   method get_config_file_name()
      local s
      s := ("" ~== getenv("HOME")) | "."
      return s || "/.ivibrc"
   end

   method read_config_file()
      local f
      self.prefs := Prefs()
      if f := ::open(get_config_file_name()) then {
         self.prefs := lang::decode(read(f))
         close(f)
         if not instanceof(self.prefs, "Prefs") then {
            self.prefs := Prefs()
            return alert_error("Invalid config file format")
         }
      }
   end

########################################################

   initially
      local c, tb, ui, listener, ui_button, m, y, push_code_button,
         checkboxgroup_button, buttongroup_button, delete_button,
         centre_horiz_button, centre_vert_button, align_horiz_button,
         align_vert_button, grid_button, copy_button, popup_dialog_dialog,
         popup_dialog_generate,
         popup_dialog_component_load, popup_component_dialog,
         popup_component_delete, popup_component_fix, popup_component_unfix,
         popup_component_save

      self.Component.initially()

      /v1_marker := "### Ivib layout ###"
      /v2_marker := "### Ivib-v2 layout ##"
      ivib_maindialog := self
      layouts := table()
      undo_list := []
      redo_list := []

      c := Clear(self)
      self.add(c)

      read_config_file()

      uis := [CanvasTextButtonUI(),
              CanvasLabelUI(),
              CanvasTextFieldUI(),
              CanvasBorderUI(),
              CanvasIconButtonUI(),
              CanvasIconUI(),
              CanvasImageUI(),
              CanvasCheckBoxUI(),
              CanvasMenuBarUI(),
              CanvasVScrollBarUI(),
              CanvasHScrollBarUI(),
              CanvasPanelUI(),
              CanvasTabSetUI(),
              CanvasMenuButtonUI(),
              CanvasOverlaySetUI(),
              CanvasTextListUI(),
              CanvasEditableTextListUI(),
              CanvasListUI(),
              CanvasEditListUI(),
              CanvasToolBarUI(),
              CanvasListSpinUI(),
              CanvasRangeSpinUI(),
              CanvasHSliderUI(),
              CanvasVSliderUI(),
              CanvasHLineUI(),
              CanvasVLineUI(),
              CanvasHSizerUI(),
              CanvasVSizerUI(),
              CanvasTableUI(),
              CanvasCustomUI(),
              CanvasTreeUI()
              ]

      tb := IvibToolBar()
      tb.set_pos(0, 0)

      every ui := !uis do {
         listener := ObjectActionListener(self, ui)
         if ui_button := ui.get_button() then {
            tb.add_button(ui_button)
            ui_button.connect(listener, "on_event", ACTION_EVENT)
         }
      }

      checkboxgroup_button := IconButton()
      checkboxgroup_button.set_img(
                                   $include "ivib/icon/icn22.icon"
                                   )
      checkboxgroup_button.set_tooltip("CheckBoxGroup")
      tb.add_button(checkboxgroup_button)

      buttongroup_button := IconButton()
      buttongroup_button.set_img(
                                 $include "ivib/icon/icn23.icon"
                                 )
      buttongroup_button.set_tooltip("ButtonGroup")
      tb.add_button(buttongroup_button)

      delete_button := IconButton()
      delete_button.set_img(
                            $include "ivib/icon/icn24.icon"
                            )
      delete_button.set_tooltip("Delete")
      tb.add_button(delete_button)

      undo_button := IconButton()
      undo_button.set_img(
                          $include "ivib/icon/icn25.icon"
                          )
      undo_button.set_tooltip("Undo")
      tb.add_button(undo_button)

      redo_button := IconButton()
      redo_button.set_img(
                          $include "ivib/icon/icn26.icon"
                          )
      redo_button.set_tooltip("Redo")
      tb.add_button(redo_button)

      centre_horiz_button := IconButton()
      centre_horiz_button.set_img(
                                  $include "ivib/icon/icn27.icon"
                                  )
      centre_horiz_button.set_tooltip("Centre Horizontally")
      tb.add_button(centre_horiz_button)

      centre_vert_button := IconButton()
      centre_vert_button.set_img(
                                 $include "ivib/icon/icn28.icon"
                                 )
      centre_vert_button.set_tooltip("Centre Vertically")
      tb.add_button(centre_vert_button)

      align_horiz_button := IconButton()
      align_horiz_button.set_img(
                                 $include "ivib/icon/icn29.icon"
                                 )
      align_horiz_button.set_tooltip("Align Horizontally")
      tb.add_button(align_horiz_button)

      align_vert_button := IconButton()
      align_vert_button.set_img(
                                $include "ivib/icon/icn30.icon"
                                )
      align_vert_button.set_tooltip("Align Vertically")
      tb.add_button(align_vert_button)

      grid_button := IconButton()
      grid_button.set_img(
                          $include "ivib/icon/icn31.icon"
                          )
      grid_button.set_tooltip("Grid")
      tb.add_button(grid_button)

      copy_button := IconButton()
      copy_button.set_img(
                          $include "ivib/icon/icn32.icon"
                          )
      copy_button.set_tooltip("Copy")
      tb.add_button(copy_button)

      push_code_button := IconButton()
      push_code_button.set_img(
                               $include "ivib/icon/save.icon"
                               )
      push_code_button.set_tooltip("Generate UI Code into the editor")
      tb.add_button(push_code_button)

      self.add(tb)
      y := tb.h_spec + 3

      #
      # Create the three text labels below the tool bar.
      #
      filename_label := Label()
      filename_label.set_size(150, 25)
      filename_label.set_draw_border()
      filename_label.set_pos(0, y)
      filename_label.set_label("")
      self.add(filename_label)

      info_label := Label()
      info_label.set_size("100%-275", 25)
      info_label.set_draw_border()
      info_label.set_pos(150, y)
      info_label.set_label("")
      self.add(info_label)

      pos_label := Label()
      pos_label.set_attribs("font=" || (GuiThemePickFont() | "serif,10"))
      pos_label.set_size(125, 25)
      pos_label.set_draw_border()
      pos_label.set_pos("100%-125", y)
      pos_label.set_label("")
      self.add(pos_label)

      popup_dialog := IvibPopupMenu()
      m := Menu()
      popup_dialog.set_menu(m)
      popup_dialog_dialog := TextMenuItem()
      popup_dialog_dialog.set_label("Dialog")
      m.add(popup_dialog_dialog)
      popup_dialog_generate := TextMenuItem()
      popup_dialog_generate.set_label("Generate UI Code")
      m.add(popup_dialog_generate)
      popup_dialog_component_load := TextMenuItem()
      popup_dialog_component_load.set_label("Load Component")
      m.add(popup_dialog_component_load)
      self.add(popup_dialog)

      popup_component := IvibPopupMenu()
      m := Menu()
      popup_component.set_menu(m)
      popup_component_dialog := TextMenuItem()
      popup_component_dialog.set_label("Dialog")
      m.add(popup_component_dialog)

      popup_component_fix := TextMenuItem()
      popup_component_fix.set_label("Fix")
      m.add(popup_component_fix)

      popup_component_unfix := TextMenuItem()
      popup_component_unfix.set_label("Unfix")
      m.add(popup_component_unfix)

      popup_component_delete := TextMenuItem()
      popup_component_delete.set_label("Delete")
      m.add(popup_component_delete)

      popup_component_save := TextMenuItem()
      popup_component_save.set_label("Save Component")
      m.add(popup_component_save)
      self.add(popup_component)

      popup_dialog_component_load.connect(self, "op_popup_dialog_component_load", ACTION_EVENT)
      popup_dialog_generate.connect(self, "op_push_code_to_ui", ACTION_EVENT)
      checkboxgroup_button.connect(self, "op_CheckBoxGroup", ACTION_EVENT)
      buttongroup_button.connect(self, "op_ButtonGroup", ACTION_EVENT)
      delete_button.connect(self, "op_Delete", ACTION_EVENT)
      undo_button.connect(self, "op_Undo", ACTION_EVENT)
      redo_button.connect(self, "op_Redo", ACTION_EVENT)
      centre_horiz_button.connect(self, "op_Centre_horiz", ACTION_EVENT)
      centre_vert_button.connect(self, "op_Centre_vert", ACTION_EVENT)
      align_horiz_button.connect(self, "op_Align_horiz", ACTION_EVENT)
      align_vert_button.connect(self, "op_Align_vert", ACTION_EVENT)
      grid_button.connect(self, "op_Grid", ACTION_EVENT)
      copy_button.connect(self, "op_Copy", ACTION_EVENT)
      push_code_button.connect(self, "op_push_code_to_ui", ACTION_EVENT)
      popup_component_fix.connect(self, "op_fix", ACTION_EVENT)
      popup_component_unfix.connect(self, "op_unfix", ACTION_EVENT)
      popup_dialog_dialog.connect(self, "op_preferences", ACTION_EVENT)
      popup_component_dialog.connect(self, "op_dialog", ACTION_EVENT)
      popup_component_save.connect(self, "op_component_save", ACTION_EVENT)
      popup_component_delete.connect(self, "op_Delete", ACTION_EVENT)

      self.tool_area_height := y + 25

      #
      # Set up the Canvas object.
      #
      orig_canvas_height := 360
      orig_canvas_width := 600
      canvas := Canvas()
      canvas.set_size(orig_canvas_width, orig_canvas_height)
      canvas.set_pos(CANVAS_SURROUND, self.tool_area_height + CANVAS_SURROUND)
      self.add(canvas)

      update_undo_shading()
end
