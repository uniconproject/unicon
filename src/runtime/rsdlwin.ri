/*
 * X11 color names, so programs written for X keep their colors.
 * Spaces and case are ignored; grayN and greyN are computed.
 */
static struct { char *name; unsigned long rgb; } xcolors[] = {
   {"aliceblue", 0xF0F8FF},
   {"antiquewhite", 0xFAEBD7},
   {"aquamarine", 0x7FFFD4},
   {"azure", 0xF0FFFF},
   {"beige", 0xF5F5DC},
   {"bisque", 0xFFE4C4},
