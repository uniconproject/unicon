# Makefile for uscribe

SHELL=/bin/sh
BASE=../..
UNICON_TOP_BUILDDIR ?= $(BASE)
include $(UNICON_TOP_BUILDDIR)/Makedefs.uni

SRCS   := $(wildcard ./*.icn)
UFILES := $(patsubst %.icn, %.u, $(SRCS))

.PHONY: all clean deps depends install

default: uscribe$(EXE)
all: uscribe$(EXE)

# import json — rebuild if uni/lib/json.icn changed
../lib/json.u: ../lib/json.icn
	$(MAKE) -C ../lib json.u

uscribe$(EXE): $(UFILES) ../lib/json.u
	$(UNICON) -o uscribe $(UFILES)
	$(CP) uscribe$(EXE) $(BIN)

install: uscribe$(EXE)

deps depends:
	unidep $(SRCS)

clean:
	$(RM) uscribe$(EXE) *.u uniclass.dir uniclass.pag uniclass.db *~

### Autogenerated dependencies
bib.u : bib.icn labeltable.u node.u
config.u : config.icn
directive.u : directive.icn inline.u node.u
inline.u : inline.icn node.u scan.u
labeltable.u : labeltable.icn node.u
latexout.u : latexout.icn bib.u inline.u labeltable.u node.u outputter.u
main.u : main.icn bib.u config.u directive.u labeltable.u latexout.u manifest.u outputter.u parser.u
manifest.u : manifest.icn
node.u : node.icn
outputter.u : outputter.icn bib.u inline.u node.u
parser.u : parser.icn directive.u inline.u node.u
scan.u : scan.icn
