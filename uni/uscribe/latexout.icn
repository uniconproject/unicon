#<p>
# LaTeX doctree outputter: <tt>LatexOutputter</tt> renders a resolved
# <tt>Document</tt> tree as LaTeX, plus helpers <tt>escapeLatex</tt>,
# <tt>escapeLatexTT</tt>, <tt>escapeLatexPath</tt>,
# <tt>escapeVerbatimLine</tt>, and <tt>latexLabelId</tt>. The driver writes
# one <tt>book.tex</tt> (preamble + every chapter +
# <tt>\\end{document}</tt>); <tt>--format=pdf</tt> then runs a TeX engine.
#</p>
#<p>
# <b>Author:</b> Jafar Al-Gharaibeh
#</p>
#<p>
# This file is in the <i>public domain</i>.
#</p>

package uscribe

import lang

#<p>
# Concrete <tt>Outputter</tt> for LaTeX / PDF. Unlike
# <tt>HtmlOutputter</tt> (one file per chapter), the driver opens a
# single <tt>.tex</tt> stream and calls <tt>visitDocument</tt> once per
# chapter after <tt>writePreamble</tt> / before <tt>writeEpilogue</tt>.
#</p>
class LatexOutputter : Outputter (outFile, labelTable, bookTitle,
                                  chapterBase, chapterIndex, figureNo)

    #<p>
    # Set the open file to which LaTeX is written.
    # <[param f an open file]>
    #</p>
    method setOutFile(f)
        outFile := f
        return
    end

    #<p>
    # Attach the shared label table.
    # <[param lt a LabelTable]>
    #</p>
    method setLabelTable(lt)
        labelTable := lt
        return
    end

    #<p>
    # Set the book title used in the LaTeX <tt>\\title{...}</tt>.
    # <[param t title string]>
    #</p>
    method setBookTitle(t)
        bookTitle := t
        return
    end

    #<p>
    # Write the documentclass, packages, title, and
    # <tt>\\begin{document}</tt> / <tt>\\maketitle</tt> /
    # <tt>\\tableofcontents</tt>.
    #</p>
    method writePreamble()
        write(outFile, "% Generated by uscribe -- do not edit by hand")
        write(outFile, "\\documentclass[11pt,openany]{book}")
        write(outFile, "\\usepackage[T1]{fontenc}")
        write(outFile, "\\usepackage[utf8]{inputenc}")
        write(outFile, "\\usepackage{graphicx}")
        write(outFile, "\\usepackage{hyperref}")
        write(outFile, "\\usepackage{xcolor}")
        write(outFile, "\\usepackage{fancyvrb}")
        write(outFile, "\\usepackage{booktabs}")
        write(outFile, "\\hypersetup{colorlinks=true,linkcolor=blue,urlcolor=blue}")
        write(outFile, "\\title{", escapeLatex(\bookTitle) | "Untitled", "}")
        write(outFile, "\\author{}")
        write(outFile, "\\date{}")
        write(outFile, "\\begin{document}")
        write(outFile, "\\maketitle")
        write(outFile, "\\tableofcontents")
        write(outFile, "\\clearpage")
        return
    end

    #<p>
    # Write <tt>\\end{document}</tt>.
    #</p>
    method writeEpilogue()
        write(outFile, "\\end{document}")
        return
    end

    #<p>
    # Start a chapter: bump <tt>chapterIndex</tt>, set
    # <tt>chapterBase</tt> from the HTML basename (without
    # <tt>.html</tt>), insert <tt>\\clearpage</tt> after the first
    # chapter, then visit children.
    # <[param n a Document node]>
    #</p>
    method visitDocument(n)
        local base
        chapterIndex := (\chapterIndex | 0) + 1
        base := chapterOutputName(n.getSrcName())
        if *base >= 5 & base[*base-4:0] == ".html" then
            base := base[1:*base-4]
        chapterBase := base
        if chapterIndex > 1 then
            write(outFile, "\\clearpage")
        every (!n.getChildren()).accept(self)
        return
    end

    #<p>
    # Emit <tt>\\chapter</tt> / <tt>\\section</tt> / … plus a
    # <tt>\\label</tt> from <tt>latexLabelId</tt>, then visit children.
    # <[param n a Section node]>
    #</p>
    method visitSection(n)
        local cmd, id
        cmd := case n.getLevel() of {
            1: "chapter"
            2: "section"
            3: "subsection"
            default: "subsubsection"
            }
        writes(outFile, "\\", cmd, "{")
        writeInlineTitle(n.getTitle())
        write(outFile, "}")
        id := latexLabelId(chapterBase, anchorFor(n))
        write(outFile, "\\label{", id, "}")
        every (!n.getChildren()).accept(self)
        return
    end

    #<p>
    # Emit a paragraph as blank-line-separated prose.
    # <[param n a Paragraph node]>
    #</p>
    method visitParagraph(n)
        write(outFile)
        every (!n.getChildren()).accept(self)
        write(outFile)
        write(outFile)
        return
    end

    #<p>
    # Emit an <tt>itemize</tt> environment.
    # <[param n a BulletList node]>
    #</p>
    method visitBulletList(n)
        write(outFile, "\\begin{itemize}")
        every (!n.getChildren()).accept(self)
        write(outFile, "\\end{itemize}")
        return
    end

    #<p>
    # Emit an <tt>enumerate</tt> environment (start index ignored).
    # <[param n an EnumList node]>
    #</p>
    method visitEnumList(n)
        write(outFile, "\\begin{enumerate}")
        # startAt > 1: enumerate package would help; keep simple
        every (!n.getChildren()).accept(self)
        write(outFile, "\\end{enumerate}")
        return
    end

    #<p>
    # Emit a <tt>\\item</tt> and its children.
    # <[param n a ListItem node]>
    #</p>
    method visitListItem(n)
        write(outFile, "\\item ")
        every (!n.getChildren()).accept(self)
        write(outFile)
        return
    end

    #<p>
    # Emit a <tt>Verbatim</tt> block. Lines are escaped for fancyvrb
    # <tt>commandchars</tt> so a document line equal to
    # <tt>\end{Verbatim}</tt> cannot close the environment early.
    # <[param n a CodeBlock node]>
    #</p>
    method visitCodeBlock(n)
        local ln
        # commandchars=\\\{\} so \, {, } are fancyvrb escapes inside the block
        write(outFile, "\\begin{Verbatim}[fontsize=\\small,frame=single,",
              "commandchars=", "\\\\", "\\{", "\\}", "]")
        every ln := !n.getLines() do
            write(outFile, escapeVerbatimLine(ln))
        write(outFile, "\\end{Verbatim}")
        write(outFile)
        return
    end

    #<p>
    # Emit an admonition as a bold kind label inside a <tt>quote</tt>.
    # <[param n an Admonition node]>
    #</p>
    method visitAdmonition(n)
        write(outFile, "\\begin{quote}")
        write(outFile, "\\textbf{", escapeLatex(capitalize(n.getKind())), ".}")
        write(outFile)
        every (!n.getChildren()).accept(self)
        write(outFile, "\\end{quote}")
        write(outFile)
        return
    end

    #<p>
    # Emit a <tt>tabular</tt> environment for a simple table.
    # <[param n a Table node]>
    #</p>
    method visitTable(n)
        local ncols, row, i
        ncols := 1
        if \n.getHeaderRow() then
            ncols := *n.getHeaderRow().getChildren() | 1
        else if *n.getChildren() > 0 then
            ncols := *n.getChildren()[1].getChildren() | 1
        writes(outFile, "\\begin{center}\\begin{tabular}{")
        every i := 1 to ncols do
            writes(outFile, "l")
        write(outFile, "}")
        write(outFile, "\\hline")
        if \n.getHeaderRow() then {
            writeLatexTableRow(n.getHeaderRow())
            write(outFile, "\\hline")
            }
        every row := !n.getChildren() do
            writeLatexTableRow(row)
        write(outFile, "\\hline")
        write(outFile, "\\end{tabular}\\end{center}")
        if \n.getLabel() then
            write(outFile, "\\label{", latexLabelId(n.getLabel()), "}")
        write(outFile)
        return
    end

    #<p>
    # Unused for LaTeX tables (rows are written by
    # <tt>writeLatexTableRow</tt>); kept for the visitor interface.
    # <[param n a TableRow node]>
    #</p>
    method visitTableRow(n)
        return
    end

    #<p>
    # Unused for LaTeX tables; kept for the visitor interface.
    # <[param n a TableCell node]>
    #</p>
    method visitTableCell(n)
        return
    end

    #<p>
    # Emit a <tt>description</tt> environment.
    # <[param n a DefinitionList node]>
    #</p>
    method visitDefinitionList(n)
        write(outFile, "\\begin{description}")
        every (!n.getChildren()).accept(self)
        write(outFile, "\\end{description}")
        write(outFile)
        return
    end

    #<p>
    # Emit one <tt>\\item[term]</tt> plus definition body.
    # <[param n a DefinitionItem node]>
    #</p>
    method visitDefinitionItem(n)
        write(outFile, "\\item[", escapeLatex(n.getTerm()), "]")
        every (!n.getChildren()).accept(self)
        return
    end

    #<p>
    # Write one table row as <tt>cell & cell \\\\</tt>.
    # <[param row a TableRow node]>
    #</p>
    method writeLatexTableRow(row)
        local cell, first
        first := 1
        every cell := !row.getChildren() do {
            if \first then
                first := &null
            else
                writes(outFile, " & ")
            every (!cell.getChildren()).accept(self)
            }
        write(outFile, " \\\\")
        return
    end

    #<p>
    # Emit a <tt>figure</tt> with <tt>\\includegraphics</tt>, or a
    # placeholder box for SVG (with a warning on <tt>&errout</tt>).
    # <[param n an Image node]>
    #</p>
    method visitImage(n)
        local uri, alt, cap
        uri := n.getURI()
        alt := \n.getAlt() | ""
        cap := \n.getCaption() | alt
        # pdflatex/xelatex need PDF/PNG/JPEG; SVG is noted as a placeholder
        if *uri >= 4 & map(uri[*uri-3:0], &ucase, &lcase) == ".svg" then {
            write(outFile, "\\begin{center}\\fbox{\\parbox{0.9\\linewidth}{")
            write(outFile, "\\textit{[figure: ", escapeLatex(uri))
            if *cap > 0 then
                write(outFile, " — ", escapeLatex(cap))
            write(outFile, " (SVG: convert to PDF/PNG for TeX)]}")
            write(outFile, "}\\end{center}")
            if \n.getLabel() then
                write(outFile, "\\label{", latexLabelId(n.getLabel()), "}")
            write(&errout, "warning: SVG not embedded in LaTeX: ", uri)
            }
        else {
            write(outFile, "\\begin{figure}[htbp]")
            write(outFile, "\\centering")
            # escapeLatexPath (not raw \\detokenize): '%' would comment out
            # the rest of the .tex line before detokenize runs, and raw
            # braces can unbalance the \\includegraphics argument.
            write(outFile, "\\includegraphics[width=0.9\\linewidth]{",
                  escapeLatexPath(uri), "}")
            if *cap > 0 then
                write(outFile, "\\caption{", escapeLatex(cap), "}")
            if \n.getLabel() then
                write(outFile, "\\label{", latexLabelId(n.getLabel()), "}")
            write(outFile, "\\end{figure}")
            }
        write(outFile)
        return
    end

    #<p>
    # Emit a LaTeX comment for an unhandled directive.
    # <[param n a RawDirective node]>
    #</p>
    method visitRawDirective(n)
        write(outFile, "% unhandled directive: ", n.getName())
        write(outFile)
        return
    end

    #<p>
    # Write escaped prose text (no trailing newline).
    # <[param n a Text node]>
    #</p>
    method visitText(n)
        writes(outFile, escapeLatex(n.getText()))
        return
    end

    #<p>
    # Emit <tt>\\emph{...}</tt> around inline children.
    # <[param n an Emphasis node]>
    #</p>
    method visitEmphasis(n)
        writes(outFile, "\\emph{")
        every (!n.getChildren()).accept(self)
        writes(outFile, "}")
        return
    end

    #<p>
    # Emit <tt>\\textbf{...}</tt> around inline children.
    # <[param n a Strong node]>
    #</p>
    method visitStrong(n)
        writes(outFile, "\\textbf{")
        every (!n.getChildren()).accept(self)
        writes(outFile, "}")
        return
    end

    #<p>
    # Emit <tt>\\texttt{...}</tt> with <tt>escapeLatexTT</tt>.
    # <[param n a Literal node]>
    #</p>
    method visitLiteral(n)
        writes(outFile, "\\texttt{", escapeLatexTT(n.getText()), "}")
        return
    end

    #<p>
    # Emit <tt>\\hyperref[id]{text}</tt> for a resolved xref.
    # <[param n a Reference node]>
    #</p>
    method visitReference(n)
        local id, fileBase
        fileBase := \n.getTargetFile() | ""
        if *fileBase >= 5 & fileBase[*fileBase-4:0] == ".html" then
            fileBase := fileBase[1:*fileBase-4]
        id := latexLabelId(fileBase, \n.getTargetAnchor() | "")
        writes(outFile, "\\hyperref[", id, "]{",
               escapeLatex(n.getText()), "}")
        return
    end

    #<p>
    # Emit a bold <tt>[?label?]</tt> marker and warn on <tt>&errout</tt>.
    # <[param n an unresolved xref node]>
    #</p>
    method visitBrokenXref(n)
        writes(outFile, "\\textbf{[?}", escapeLatex(n.getLabel()), "?]}")
        write(&errout, "warning: unresolved xref '", n.getLabel(), "'")
        return
    end

    #<p>
    # Write a section title that may contain inline markup via
    # <tt>parseInline()</tt>.
    # <[param titleText raw title string]>
    #</p>
    method writeInlineTitle(titleText)
        local piece
        every piece := !parseInline(titleText) do
            piece.accept(self)
        return
    end

    #<p>
    # Anchor id for a section: explicit label if set, else
    # <tt>slugify</tt> of the title.
    # <[param sectionNode a Section node]>
    # <[returns anchor string]>
    #</p>
    method anchorFor(sectionNode)
        return \sectionNode.getLabel() | slugify(sectionNode.getTitle())
    end
end

#<p>
# Escape <tt>\ { }</tt> for fancyvrb when <tt>commandchars=\\\{\}</tt>
# is set, so a source line <tt>\end{Verbatim}</tt> is typeset literally
# and does not terminate the environment.
# <[param s input line, or null treated as empty]>
# <[returns escaped line]>
#</p>
procedure escapeVerbatimLine(s)
    local out, c
    /s := ""
    out := ""
    every c := !s do
        out ||:= case c of {
            "\\": "\\\\"
            "{": "\\{"
            "}": "\\}"
            default: c
            }
    return out
end

#<p>
# Escape a filesystem path for <tt>\\includegraphics{...}</tt>. Unlike
# prose escaping, this keeps characters that are legal in filenames
# (e.g. <tt>_</tt>) and only neutralizes tokens that break TeX while
# reading the <tt>.tex</tt> line: <tt>%</tt> (line comment), <tt>#</tt>,
# braces, tilde, caret (blocks <tt>^^xx</tt> character-code decoding),
# and backslash (normalized to <tt>/</tt>).
# <[param s image path, or null treated as empty]>
# <[returns path safe to embed in <tt>\\includegraphics{...}</tt>]>
#</p>
procedure escapeLatexPath(s)
    local out, c
    /s := ""
    out := ""
    every c := !s do
        out ||:= case c of {
            "%": "\\%"
            "#": "\\#"
            "{": "\\{"
            "}": "\\}"
            "~": "\\string~"
            "^": "\\textasciicircum{}"
            "\\": "/"
            default: c
            }
    return out
end

#<p>
# Escape text for ordinary LaTeX prose (not verbatim, not
# <tt>\\verb</tt>). Normalizes a few Unicode punctuation marks first.
# <[param s input string, or null treated as empty]>
# <[returns escaped string]>
#</p>
procedure escapeLatex(s)
    local out, c, rest, pair, fromStr, toStr
    static uMap
    initial {
        uMap := [
            ["—", "---"], ["–", "--"],
            ["“", "``"], ["”", "''"],
            ["‘", "`"], ["’", "'"]
            ]
        }
    /s := ""
    # Normalize a few Unicode punctuation marks TeX-friendly first
    every pair := !uMap do {
        fromStr := pair[1]
        toStr := pair[2]
        rest := ""
        s ? {
            while rest ||:= tab(find(fromStr)) do {
                rest ||:= toStr
                move(*fromStr)
                }
            rest ||:= tab(0)
            }
        s := rest
        }
    out := ""
    every c := !s do
        out ||:= case c of {
            "\\": "\\textbackslash{}"
            "{": "\\{"
            "}": "\\}"
            "$": "\\$"
            "&": "\\&"
            "%": "\\%"
            "#": "\\#"
            "^": "\\textasciicircum{}"
            "_": "\\_"
            "~": "\\textasciitilde{}"
            default: c
            }
    return out
end

#<p>
# Escape for <tt>\\texttt{...}</tt>: same specials as
# <tt>escapeLatex</tt>, plus spaces become <tt>~</tt>.
# <[param s input string, or null treated as empty]>
# <[returns escaped string]>
#</p>
procedure escapeLatexTT(s)
    local out, c
    /s := ""
    out := ""
    every c := !s do
        out ||:= case c of {
            "\\": "\\textbackslash{}"
            "{": "\\{"
            "}": "\\}"
            "$": "\\$"
            "&": "\\&"
            "%": "\\%"
            "#": "\\#"
            "^": "\\textasciicircum{}"
            "_": "\\_"
            "~": "\\textasciitilde{}"
            " ": "~"
            default: c
            }
    return out
end

#<p>
# Build a hyperref-safe <tt>\\label</tt> / <tt>\\hyperref</tt> id from
# chapter basename and section anchor (e.g. <tt>intro</tt> +
# <tt>networking</tt> → <tt>intro-networking</tt>). Non-alphanumeric
# characters become <tt>-</tt>.
# <[param chapBase chapter basename, or null for "chap"]>
# <[param anchor section anchor, or null for "top"]>
# <[returns sanitized id string]>
#</p>
procedure latexLabelId(chapBase, anchor)
    local s, out, c, ok
    s := (\chapBase | "chap") || "-" || (\anchor | "top")
    ok := &letters ++ &digits ++ '-.'
    out := ""
    every c := !s do {
        if any(ok, c) then
            out ||:= c
        else
            out ||:= "-"
        }
    return out
end
