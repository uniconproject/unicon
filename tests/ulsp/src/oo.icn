# oo.icn: Unicon classes and packages
import gui

class Account(owner, balance)
   # Deposit an amount.
   method deposit(amt)
      balance +:= amt
      return balance
   end
   method show()
      write(owner, ": ", balance)
   end
initially
   /balance := 0
end

procedure main()
   local a, L
   a := Account("jafar")
   a.deposit(10)
   a.show()
   L := []
   put(L, 1)
   thread write("hi")
   L.put(2)
end
