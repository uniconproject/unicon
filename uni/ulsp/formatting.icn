#
# formatting.icn: answer textDocument/formatting
#
# The document is re-indented by unifmt() (unifmt.icn), which keeps every
# line break and token. As a formatter must never change what a program
# means, the result is used only if it compiles to the same ucode as the
# original, line and column numbers aside; "unicon -c" compiles both. A
# document that does not compile is not formatted.
#

package ulsp

import logger

class FormattingHandler(filehandler, params, unicon, tmpdir)

   #
   # Sets the class variables for the FormattingHandler.
   #
   method setVariables(new_filehandler, new_params)
      filehandler := new_filehandler
      params := new_params
   end

   #
   # A list of TextEdits that format the document, one for each line
   # that changes; [] if nothing changes or the document cannot be
   # formatted safely.
   #
   method getResult()
      local text, opts, unit, newtext, old, new, edits, i, why
      text := (\filehandler).getContents() | return []
      opts := \params["options"] | table()
      if opts["insertSpaces"] === "__false__" then
         unit := "\t"
      else
         unit := repl(" ", integer(opts["tabSize"]) | 3)

      newtext := unifmt(text, unit) | {
         why := \fmt_error | "cannot follow the structure"
         Logger.info("formatting: ", filehandler.uri, ": ", why)
         return []
      }
      if newtext == text then return []
      if not same_program(filehandler.uri, text, newtext) then return []

      edits := []
      old := fmt_split(text)
      new := fmt_split(newtext)
      every i := 1 to *old do
         if old[i] ~== new[i] then
            put(edits, table("range", table("start", table("line", i - 1, "character", 0),
                                            "end", table("line", i - 1, "character", utf16_len(old[i]))),
                             "newText", new[i]))
      return edits
   end

   #
   # Do text and newtext, two versions of the file fname, compile to the
   # same ucode, line and column numbers aside?
   #
   method same_program(fname, text, newtext)
      local dir, w, a, b, oldlpath, oldipath, ok
      w := make_work_dir() | {
         Logger.error("formatting: cannot make a directory in ", tmpdir)
         fail
      }
      a := w || "/a"
      b := w || "/b"
      dir := directory_of(fname)
      oldlpath := getenv("LPATH") | ""
      oldipath := getenv("IPATH") | ""
      setenv("LPATH", path_with(dir, oldlpath))
      setenv("IPATH", path_with(dir, oldipath))

      if not compile(a, text) then
         Logger.info("formatting: ", fname, " does not compile, so it is not formatted")
      else if not compile(b, newtext) then
         Logger.error("formatting: ", fname, ": the formatted text does not compile")
      else if not (ucode(a) === ucode(b)) then
         Logger.error("formatting: ", fname, ": the formatted text compiles differently")
      else
         ok := 1

      setenv("LPATH", oldlpath)
      setenv("IPATH", oldipath)
      remove_work_dir(w)
      return \ok
   end

   #
   # Make the directory dir, write text to ulspdoc.icn in it (see
   # diagnostics.icn) and compile it there with "unicon -c".
   #
   method compile(dir, text)
      local f
      mkdir(dir, 8r700) | fail
      f := open(dir || "/ulspdoc.icn", "w") | fail
      writes(f, text)
      close(f)
      # unicon -c writes the ucode where it runs; its messages go to a
      # file, as ulsp's own output may be the client's stdio
      if run_unicon(unicon, dir, ["-s", "-c", "ulspdoc.icn"], "ulspfmt.log") === 0 then return
   end

   #
   # The ucode in dir, as one string, without the lines that only record
   # where things are or when they were compiled.
   #
   method ucode(dir)
      local d, names, s, f, n, line, w
      d := open(dir) | fail
      names := []
      while put(names, read(d))
      close(d)
      s := ""
      every n := !sort(names) do {
         n[-2:0] == ".u" | next
         f := open(dir || "/" || n) | fail
         while line := read(f) do {
            line ? {
               tab(many(' \t'))
               w := tab(upto(' \t') | 0)
            }
            if not (w == ("line" | "colm" | "uid" | "filen" | "version")) then
               s ||:= line || "\n"
         }
         close(f)
      }
      return s
   end

   initially
      unicon := unicon_command()
      tmpdir := temp_dir()
end
