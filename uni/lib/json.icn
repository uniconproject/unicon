#
# json.icn - JSON support library
#
# Authors: Gigi Young, Clinton Jeffery
#
# This library is intended to support conversion of Unicon values
# to and from JSON format, suitable for storage or transmission.
#

#
# Error handling object
#

package json

class ErrorHandler(filename,
                   lineno,
                   error,
                   errout,
                   tag,
                   strict       # Flag to enforce strict JSON if not null
                  )
   method init(filename)
      self.filename := filename
      self.lineno := 1
      self.error := &null
      return
   end

   method incr_line()
      lineno +:= 1
      return
   end

   method constr_msg(s)
      if \filename then
         return tag || " " || filename || ":" || lineno || ": " || s
      else
         return tag || " " ||  s
   end

   #
   # Sets (error) using constr_msg()
   #
   method set_err(s)
      if /(error) then {
         error := constr_msg(s)
         }
   end

   #
   # Writes error (s) to file descriptor specified by errout.
   #
   method write_err(s)
      write(errout,tag||" "||s)
   end

   #
   # Write out (error), if it exists, to (errout)
   #
   method get_err()
       if \error then {
          write(errout, error)
          }
   end
initially(errout,strict)
   self.errout := \errout | &errout
   self.strict := strict | &null
   self.lineno := 1
   self.tag := "[json]"
end



#
# For standalone testing
#
$ifdef MAIN
procedure main(argv)
   local input
   if *argv=0 then {
      write("Enter the name of a JSON file:")
      x := jtou(input := read())
      write(utoj(x))
      }
   else every i := 1 to *argv do {
      write(argv[i])
      x := jtou(argv[i])
      write(utoj(x))
      }
end
$endif

#<p>
# Takes a string s that will be interpreted as JSON data.
# If the conversion fails, jtou() attempts to use s as a
# filename. If it fails, then the function fails.
#
# This procedure is a generator. It will return the
# corresponding unicon objects, one-by-one, until the
# conversion is complete.
#
# <[param s - JSON-encoded string or JSON filename]>
# <[param strict - Flag for specifing strict JSON syntax (non-null)]>
# <[param mode - Specifies explicit string, "s", or file, "f", handling]>
# <[param error - file for error messages (defaults to <tt>&errout</tt>)]>
#</p>
procedure jtou(s,strict,mode,error)
   local j, u, jerror, ok
   jerror := ErrorHandler(error,strict)

   # default semantics
   if /mode then {
      # run as string
      every u := _jparse(s, jerror) do {
         ok := 1
         suspend u
         }
      if \ok then
         return jerror.get_err()
      # string conversion failed, run as file
      if not (j := _jreadfile(s)) then {
         return jerror.write_err("Unable to open file "||image(s))
         }
      jerror.init(s)
      }
   # mode specified
   else {
      case mode of {
         # file mode
         "f" : {
            if not (j := _jreadfile(s)) then {
               return jerror.write_err("Unable to open file "||image(s))
               }
            jerror.init(s)
            }
         # string mode
         "s" : j := s
         default: return jerror.write_err("Invalid mode "||image(mode))
         }
      }
   # parse
   suspend _jparse(j, jerror)
   jerror.get_err()
end

#<p>
# Simple interface to convert a JSON string into a unicon entity.
# <i>Note: Unlike jtou(), this assumes the JSON string contains a single
# unicon entity.</i>
# <[param s - JSON-encoded string]>
# <[param strict - Flag for specifing strict JSON syntax (non-null)]>
# <[param error - file for error messages (defaults to <tt>&errout</tt>)]>
# <[return unicon entity encoded in JSON string]>
#</p>
procedure jtous(s,strict,error)
   local jerror

   #jerror := ErrorHandler(error,strict) # defaults error to &errout
   jerror := ErrorHandler(error) # defaults error to &errout
   suspend _jparse(s, jerror)
   jerror.get_err()
end

#<p>
# Simple interface to convert a JSON file into a unicon entity.
# <[param s - JSON filename]>
# <[param strict - Flag for specifing strict JSON syntax (non-null)]>
# <[param error - file for error messages (defaults to <tt>&errout</tt>)]>
# <[return unicon entity encoded in JSON string]>
#</p>
procedure jtouf(s,strict,error)
   local j, jerror

   jerror := ErrorHandler(error,strict) # defaults error to &errout
   if not (j := _jreadfile(s)) then {
      return jerror.write_err("Unable to open file "||image(s))
      }
   jerror.init(s)
   suspend _jparse(j, jerror)
   jerror.get_err()
end

#
# Return the contents of file fname, or fail if it cannot be opened.
#
procedure _jreadfile(fname)
   local f, j
   f := open(fname) | fail
   j := ""
   while j ||:= reads(f, 65536)
   close(f)
   return j
end

#<p>
#
# Given a Unicon structure, produce a JSON equivalent if possible.
# This function add meta data to the output to aid in reconstructing
# the original Unicon structure.
# <[param x - a Unicon structure]>
# <[param strict - Flag for specifing strict JSON syntax (non-null)]>
# <[param error - file for error messages (defaults to <tt>&errout</tt>)]>
# <[return a string; a JSON encoding of the structure including Unicon meta data>
#</p>
procedure utoj(x,strict,error)
   local j;
   jerror := ErrorHandler(error,strict)

   if j := _utoj(x,jerror) then
      return j

   jerror.get_err()
end

#<p>
# Same as utoj(), except that this function only produces standard JSON data
# without adding Unicon data structure meta data
#
# <[param x - a Unicon structure]>
# <[param strict - Flag for specifing strict JSON syntax (non-null)]>
# <[param error - file for error messages (defaults to <tt>&errout</tt>)]>
# <[return a string in JSON format>
#</p>

procedure tojson(x,strict,error)
   local j;
   jerror := ErrorHandler(error,strict)

   if j := _utoj(x,jerror,"r") then
      return j

   jerror.get_err()
end


#
# Given a Unicon structure, produce a JSON equivalent if possible.
#
# If raw is not &null, then a standard JSON data is produced without
# adding Unicon data structure meta data
#
# TODO: Check for fails that need error messages
#
procedure _utoj(u,jerror, raw)
   local s, tmp, first
   case type(u) of {
      "null": return type(u)
      "string": {
         return      if u == "__true__" then "true"
                else if u == "__false__" then "false"
                else jsonify_string(u,jerror)
         }
      "integer" | "real": return image(u)
      "list": {
         s := "["
         if *u > 0 then s ||:= _utoj(u[1],jerror, raw)
         every i := 2 to *u do {
            s ||:= ("," || _utoj(u[i],jerror, raw)) | fail
            }
         s ||:= "]"
         return s
         }
      "set": { # {"__uniset__":[...]}
         if \raw then
            s := "["
         else
            s := "{\"__uniset__\":["
         i := 1
         every x := !u do {
            if i>1 then s ||:= ","
            s ||:= _utoj(x,jerror, raw) | fail
            i +:= 1
            }
         if \raw then
            s ||:= "]"
         else
            s ||:= "]}"
         return s
         }
      "cset": { # {"__unicset__":"..."}
         if \raw then
            return jsonify_string(string(u),jerror)
         else
            return "{\"__unicset__\":"||jsonify_string(string(u),jerror)||"}"
         }
      "table": { # {"__unitable__":1, ...}
         if \raw then
            s := "{"
         else
            s := "{\"__unitable__\":1"
         every k := key(u) do {
            if s[-1] ~== "{" then s ||:= ","
            if type(k) == "string" then
               s ||:= jsonify_string(k,jerror, raw)||":"|| _utoj(u[k],jerror, raw) | fail
            else {
               if \(jerror.strict) then
                  s ||:= "\""||image(k)||"\":"||_utoj(u[k],jerror, raw) | fail
               else
                  s ||:= _utoj(k,jerror)||":"||_utoj(u[k],jerror, raw) | fail
               }
            }
         s ||:= "}"
         return s
         }
      default: {
         # Class - {"__uniclass__":"ClassName", ...}
         if match("object ", tmp := image(u)) then {
            if \raw then
               s := "{"
            else
               s := "{\"__uniclass__\":\""||tmp[8:upto("_",tmp)\1|0]||"\""
            first := &null
            every k := key(u) do {
               if k == ("__s" | "__m") then next
               if type(k) ~== "string" then fail
               if \raw & /first then
                  s ||:= jsonify_string(k,jerror)||":"||_utoj(u[k],jerror, raw)|fail
               else
                  s ||:= ","||jsonify_string(k,jerror)||":"||_utoj(u[k],jerror, raw)|fail
               first := 1
               }
            s ||:= "}"
            return s
            }
         # Record - {"__unirecord__":"RecordName", ...}
         else if match("record ", tmp := image(u)) then {
            if \raw then
               s := "{"
            else
               s := "{\"__unirecord__\":\""||tmp[8:upto("_",tmp)\1|0]||"\""
            first := &null
            every k := key(u) do {
               if type(k) ~== "string" then fail
               if \raw & /first then
                  s ||:= jsonify_string(k,jerror)||":"||_utoj(u[k],jerror, raw)|fail
               else
                  s ||:= ","||jsonify_string(k,jerror)||":"||_utoj(u[k],jerror, raw)|fail
               first := 1
               }
            s ||:= "}"
            return s
            }
         else {
            return jerror.set_err(type(u) || " has no JSON equivalent")
            }
         }
      }
end

#
# Procedure for converting a Unicon string value to a JSON string
# literal (including surrounding quotes). Control characters and
# Unicon-style backslash escapes in the value are mapped to JSON
# escapes; a literal double-quote becomes \".
#
procedure jsonify_string(s,jerror)
   static hex, oct, T_Esc
   local ns := "", tmp, i

   initial {
      hex := '0123456789abcdefABCDEF'
      oct := '01234567'
      T_Esc := table()

      every i := 0 to 31 do
         T_Esc[char(i)] := "\\u"||right(_dectohex(i),4,"0")
      T_Esc[char(8)] := "\\b"
      T_Esc[char(9)] := "\\t"
      T_Esc[char(10)] := "\\n"
      T_Esc[char(12)] := "\\f"
      T_Esc[char(13)] := "\\r"
      T_Esc[char(127)] := "\\u007F" # \d
      }

   s ? {
      while c := move(1) do {
         # Literal double quote in the Unicon string value → JSON \"
         if c == "\"" then {
            ns ||:= "\\\""
            next
            }
         # Handle escape sequences
         if c == "\\" then {
            case (c := move(1)) |
                  return jerror.set_err("Incomplete escape sequence") of {
               # JSON escapes
               "\\": ns ||:= "\\\\"
               "/": ns ||:= "\\/"
               "\"": ns ||:= "\\\""
               "u": { # restrict to 16-bit unicode
                  tmp := tab(many(hex)) | ""
                  if (i := *tmp) > 4 then {
                     tmp := tmp[1:5]
                     move(*tmp - i)
                     }
                  ns ||:= "\\u"||right(tmp,4,"0")
                  }
               # Unicon escapes
               "b": ns ||:= "\\b"
               "d": ns ||:= "\\u007F"
               "e": ns ||:= "\\u001B"
               "f": ns ||:= "\\f"
               "l"|"n": ns ||:= "\\n"
               "r": ns ||:= "\\r"
               "t": ns ||:= "\\t"
               "v": ns ||:= "\\u000B"
               "x": { # hexadecimal, \xXX
                  # Taken from hexcode() in escape.icn
                  tmp := tab(many(hex)) | ""
                  if (i := *tmp) > 2 then {
                     tmp := tmp[1:3]
                     move(*tmp - i)
                     }
                  ns ||:= "\\u00"||tmp
                  }
               !oct: { # octal
                  # Taken from octcode() in escape.icn
                  tmp := c || tab(many(oct)) | ""
                  if (i := *tmp) > 3 then { # back off if too large
                     tmp := tmp[1:4]
                     move(*tmp - i)
                     }
                  ns ||:= "\\u"||right(_octtohex(tmp),4,"0")
                  }
               "^": { # control sequence
                  c := move(1)
                  if c == "?" then ns ||:= T_Esc["\d"]
                  else ns ||:= \(T_Esc[tmp := char(ord(c)%32)]) | tmp
                  }
               default: { # Use unicon conventions for escape sequences
                  ns ||:= c
                  }
               } # end case
            } # end if
         # Handle escaped characters
         else ns ||:= \(T_Esc[c]) | c
         } # end while
      }
   return "\""||ns||"\""
end

#
# Given an octal string, returns a hexadecimal string. Uses Unicon octal
# specifications
#
procedure _octtohex(s)
   local val := 0, len := *s, i := len
   while i > 0 do {
      val +:= integer(s[i]) * 8^(len-i)
      i -:= 1
      }
   return _dectohex(val % 256)
end

#
# Given an integer value, return a hexidecimal string
#
procedure _dectohex(val)
   local ns := "", rem

   while val > 0 do {
      rem := val % 16
      val := integer(val/16)

      if rem < 10 then ns := string(rem) || ns
      else case rem of {
         10: ns := "A" || ns
         11: ns := "B" || ns
         12: ns := "C" || ns
         13: ns := "D" || ns
         14: ns := "E" || ns
         15: ns := "F" || ns
         }
      }
   return ns
end

##################
# PARSER         #
##################

#
# The parser is recursive descent over a single string-scanning
# environment: each _jp_*() procedure is called with &pos at the start
# of what it parses and leaves &pos just past it.  No co-expressions or
# intermediate token strings are used; string contents are taken in runs
# with tab(upto()).
#
# On a syntax error the first message is recorded in jerror and the parse
# fails as a whole; no partially-built value is returned.
#

#
# Generate each top-level JSON value in s, using jerror for errors.
#
procedure _jparse(s, jerror)
   local u
   s ? repeat {
      tab(many(' \t\r\n'))
      if pos(0) then fail
      u := _jp_value(jerror) | fail
      suspend u
      }
end

#
# Record error s in jerror, with the line number of the current position,
# and fail.
#
procedure _jp_err(jerror, s)
   local n
   if /jerror.error then {
      n := 1
      every upto('\n', &subject, 1, &pos) do n +:= 1
      jerror.lineno := n
      jerror.set_err(s)
      }
end

#
# For error messages: the text of the next token, which is at least one
# character, and the rest of the current token, which may be empty.
#
procedure _jp_next()
   tab(many(' \t\r\n'))
   return &subject[&pos:upto(' \t\r\n{}[]:,', &subject, &pos + 1) | 0]
end

procedure _jp_rest(delims)
   /delims := ' \t\r\n{}[]:,'
   return &subject[&pos:upto(delims, &subject, &pos) | 0]
end

procedure _jp_value(jerror)
   local c
   tab(many(' \t\r\n'))
   case c := move(1) of {
      "\"": return _jp_string(jerror)
      "{":  return _jp_object(jerror)
      "[":  return _jp_array(jerror)
      "t":  return (="rue" & "__true__") |
               _jp_err(jerror, "Expected JSON true: " || c || _jp_rest())
      "f":  return (="alse" & "__false__") |
               _jp_err(jerror, "Expected JSON false: " || c || _jp_rest())
      "n":  {
         if ="ull" then return &null
         return _jp_err(jerror, "Expected JSON null: " || c || _jp_rest())
         }
      default:
         if any('-0123456789', c) then return _jp_number(c, jerror)
         else return _jp_err(jerror, "Unrecognized JSON token: " ||
                             c || _jp_rest())
      }
   return _jp_err(jerror, "Expected JSON value, got end of input")
end

#
# Called just after the opening double-quote.  Returns a Unicon string,
# or a cset if the contents are delimited by single-quotes.  If raw is
# not null the result is always a string (strict-mode object keys).
#
procedure _jp_string(jerror, raw)
   local str
   str := tab(upto('"\\')) |
      return _jp_err(jerror,
                "JSON string missing terminating double-quotes: " || tab(0))
   while ="\\" do {
      str ||:= _jp_escape(jerror) | fail
      str ||:= tab(upto('"\\')) |
         return _jp_err(jerror,
                   "JSON string missing terminating double-quotes: " ||
                   str || tab(0))
      }
   move(1)                                   # closing double-quote
   if /raw & str[1] == "'" & str[-1] == "'" then
      return cset(str[2:-1])
   return str
end

#
# Called just after a backslash in a string; returns the Unicon string for
# the JSON escape sequence.
#
procedure _jp_escape(jerror)
   static hex
   local c, ns, i
   initial hex := '0123456789abcdefABCDEF'

   case c := move(1) of {
      "n":  return "\n"
      "\"": return "\""
      "\\": return "\\"
      "t":  return "\t"
      "/":  return "/"
      "r":  return "\r"
      "b":  return "\b"
      "f":  return "\f"
      "u":  {
         #
         # JSON supports unicode from 0020-10FFFF, but this code restricts
         # unicode to 16-bits to remove ambiguity from Unicon and JSON
         # escape conversion.  If the code is extended ASCII, return the
         # character; otherwise return a Unicon unicode escape.
         #
         ns := tab(many(hex)) | ""
         if (i := *ns) > 4 then {
            ns := ns[1:5]
            move(*ns - i)
            }
         ns := ns[many('0', ns):0]
         if *ns > 2 then return "\\u" || right(ns, 4, "0")
         return char(integer("16r" || ns) | 0)
         }
      }
   if /c then return _jp_err(jerror, "Incomplete JSON escape sequence")
   return _jp_err(jerror, "JSON string has invalid escape sequence: " ||
                  c || _jp_rest(' \t\r\n"{}[]:,'))
end

#
# Called just after the first character c of a number.
#
procedure _jp_number(c, jerror)
   local p0
   p0 := &pos - 1
   if c == "-" then
      c := move(1) | ""
   if c == "0" then {
      if any(&digits) then
         return _jp_err(jerror, "JSON int cannot have leading zero: " ||
                        &subject[p0:&pos])
      }
   else if any(&digits, c) then
      tab(many(&digits))
   else
      return _jp_err(jerror, "Unrecognized JSON token: " ||
                     &subject[p0:&pos] || _jp_rest())
   if ="." then
      tab(many(&digits)) |
         return _jp_err(jerror, "Expected digits after '.' in JSON frac: " ||
                        &subject[p0:&pos])
   if tab(any('eE')) then {
      tab(any('+-'))
      tab(many(&digits)) |
         return _jp_err(jerror, "Expected digits after 'e' in JSON exp: " ||
                        &subject[p0:&pos])
      }
   return numeric(&subject[p0:&pos])
end

#
# Called just after "[".  Returns a Unicon list.  A trailing comma is
# allowed, e.g. [... ,]
#
procedure _jp_array(jerror)
   local a
   a := []
   tab(many(' \t\r\n'))
   if ="]" then return a
   if any(',') then
      return _jp_err(jerror, "Unexpected comma in JSON array")
   repeat {
      if any('}]:') then
         return _jp_err(jerror, "Expected JSON value, got: " || _jp_next())
      put(a, _jp_value(jerror)) | fail
      tab(many(' \t\r\n'))
      if ="," then {
         tab(many(' \t\r\n'))
         if ="]" then return a
         if any(',') then
            return _jp_err(jerror, "Unexpected comma in JSON array")
         }
      else if ="]" then return a
      else if pos(0) then
         return _jp_err(jerror, "Expected terminating ] for JSON array")
      else
         return _jp_err(jerror, "Expected comma in JSON array before: " ||
                        _jp_next())
      }
end

#
# Called just after "{".  Returns a Unicon table, or the Unicon value
# encoded by utoj() (set, cset, table, class, record) if the first pair
# uses the Unicon JSON object encoding: "__uniset__", "__unicset__",
# "__unitable__", "__uniclass__", "__unirecord__".  A trailing comma is
# allowed, e.g. {... ,}
#
# In strict mode keys must be JSON strings; otherwise a key can be any
# JSON value, for Unicon tables.
#
procedure _jp_object(jerror)
   local t, k, v, first, skip, constr, attribs, fields, uni, i, f

   tab(many(' \t\r\n'))
   if ="}" then return table()
   first := 1
   repeat {
      # key
      tab(many(' \t\r\n'))
      if any(',') then
         return _jp_err(jerror, "Unexpected comma in JSON object after: " ||
                        (if \first then "{" else ","))
      if ="\"" then
         k := _jp_string(jerror, jerror.strict) | fail
      else if \jerror.strict then
         return _jp_err(jerror, "Expecting JSON string for object key, got " ||
                        _jp_next())
      else
         k := _jp_value(jerror) | fail

      # colon
      tab(many(' \t\r\n'))
      if not =":" then {
         if pos(0) then return _jp_err(jerror, "JSON pair missing JSON value")
         return _jp_err(jerror, "Expected colon in JSON pair before: " ||
                        _jp_next())
         }

      # value
      tab(many(' \t\r\n'))
      if pos(0) then return _jp_err(jerror, "JSON pair missing JSON value")
      if any('}]:,') then
         return _jp_err(jerror, "Expected JSON value in JSON pair, got: " ||
                        _jp_next())
      v := _jp_value(jerror) | fail

      # Unicon type encodings are recognized only in the first pair.
      skip := &null
      if \first then {
         first := &null
         if not (type(k) == "string" & match("__uni", k)) then
            t := table()
         else case k of {
            # {"__unicset__":"..."}
            "__unicset__": {
               if type(v) == "string" then uni := cset(v)
               t := table()
               t[k] := v
               skip := 1
               }
            # {"__uniset__":[...]}
            "__uniset__": {
               if type(v) == "list" then uni := set(v)
               t := table()
               t[k] := v
               skip := 1
               }
            # {"__unirecord__":"RecordName", ...}
            # If the constructor doesn't exist, return a table instead.
            "__unirecord__": {
               if constr := proc(v) then {
                  fields := [: fieldnames(constr()) :] | []
                  attribs := list(*fields)
                  skip := 1
                  }
               else t := table()
               }
            # {"__uniclass__":"ClassName", ...}
            # If the constructor doesn't exist, return a table instead.
            "__uniclass__": {
               if constr := proc(v) then {
                  fields := membernames(v)
                  attribs := list(*fields)
                  skip := 1
                  }
               else t := table()
               }
            # {"__unitable__":1, ...}
            # Don't put "__unitable__":1 into the table.
            "__unitable__": {
               t := table()
               if v === 1 then skip := 1
               }
            default: t := table()
            }
         }

      if /skip then {
         if \t then {
            # a set/cset encoding must be the only pair
            if type(\uni) ~== "table" then uni := &null
            t[k] := v
            }
         else {
            # Class/record attribute.  Check field names in case the JSON
            # was user-constructed instead of from utoj().
            i := 1
            every f := !fields do {
               if f == k then {
                  attribs[i] := v
                  break
                  }
               i +:= 1
               }
            }
         }

      tab(many(' \t\r\n'))
      if ="," then {
         tab(many(' \t\r\n'))
         if ="}" then break
         }
      else if ="}" then break
      else if pos(0) then
         return _jp_err(jerror, "Expected terminating } for JSON object")
      else
         return _jp_err(jerror, "Token violated JSON object syntax: " ||
                        _jp_next())
      }

   if \constr then return constr ! attribs     # class/record
   if \uni then return uni                     # set/cset
   return t                                    # dictionary/table
end

######################
# END PARSER         #
######################

procedure json_value_true(x)
   string(x) & (x == "__true__") & return
end

procedure json_value_false(x)
   string(x) & (x == "__false__") & return
end

########################
#
#
# Schema validation
# Implemets a subset of the rfc at:
#   https://datatracker.ietf.org/doc/html/draft-bhutton-json-schema-validation-01
#
# The current implentation covers structural validation as follows:
#
# - Validation Keywords for Any Instance Type
#   * type
#   * enum
#   * const
#
# - Validation Keywords for Numeric Instances (number and integer)
#   * multipleOf
#   * maximum
#   * exclusiveMaximum
#   * minimum
#   * exclusiveMinimum
#
# - Validation Keywords for Strings
#   * maxLength
#   * minLength
#   * pattern
#
# - Validation Keywords for Arrays
#   * maxItems
#   * minItems
#   * uniqueItems
#   * maxContains
#   * minContains
#
# - Validation Keywords for Objects
#   * maxProperties
#   * minProperties
#   * required
#   * dependentRequired
#

link fullimag


#<p>
# validate a json file using a json schema
# <[param jfname - the name of the json File]>
# <[param sfname - the name of the json Schema File]>
#</p>
#
procedure jsf_validate(jfname, sfname, strict, error)
   local json_date, json_schema

   #jerror := ErrorHandler(error,strict)

   json_data   := jtou(jfname , "f", strict, error)
   json_schema := jtou(sfname , "f", strict, error)

   return _jsvalidation(json_data, json_schema, json_schema)
end

procedure jss_validate(data, schema, strict, error)
   local json_date, json_schema

   #jerror := ErrorHandler(error,strict)

   json_data   := jtou(data , "s", strict, error)
   json_schema := jtou(schema , "s", strict, error)

   return _jsvalidation(json_data, json_schema, json_schema)
end

#<p>
#
# Validate a specific value only at the current level given a schema of that value.
#
# <[param x is the table]>
# <[param val is the name of the value of a property]>
#
# <[returns "" if the valid otherwise returns the error string]>
#
#</p>

procedure validate_property(x, val)
   local z, c, cr, i, const, enum, minimum, maxLength, minLength,
      req, prop, exclusiveMaximum, multipleOf, maxProperties,
      minProperties, dependentRequired
   z := ""
   case x["type"] of {

      # - Validation Keywords for Any Instance Type
      #   * type
      #   * enum
      #   * const
      #

      "object" :{
         # - Validation Keywords for Objects
         #   * maxProperties
         #   * minProperties
         #   * required
         #   * dependentRequired
         #
         if type(val) ~== "table" then {
            return "expected object type, got: " || val
            }
         if type(req := x["required"]) == "list" then {
            i := 1
            cr := 0
            while i <= *req do {
               c := 0
               every prop := key(val) do{
                  if prop ~== req[i] then c := c + 1
                  if prop == req[i] then cr := cr + 1
                  }
               if cr = *req then break
                  if c =  *val then  z := "required properies missing"
               i := i + 1
               }
            return z
            }

         if integer(minProperties := x["minProperties"]) then
            if *val < minProperties then
               return fullimage(val) || " is too small. Must be greater than or equal to " || minProperties || " properties."

         if integer(maxProperties := x["maxProperties"]) then
            if *val > maxProperties then
               return fullimage(val) || " is too big. Must be less than or equal to " || maxProperties || " properties."

         # TODO
         enum := x["enum"]
         const := x["const"]
         dependentRequired := x["dependentRequired"]

         return z
         }

      "array": {
         # - Validation Keywords for Arrays
         #   * maxItems
         #   * minItems
         #   * uniqueItems
         #   * maxContains
         #   * minContains
         #
         if type(val) ~== "list" then
            return "expected array type, got: " || image(val)

         if integer(minItems := x["minItems"]) then
            if *val < minItems then
               return fullimage(val) || " is too small. Must have at least " || minItems || " items."

         if integer(maxItems := x["maxItems"]) then
            if *val > maxItems then
               return fullimage(val) || " is too big. Must have at most " || maxItems || " items."

         if json_value_true(x["uniqueItems"]) & *val ~= *set(val) then {
            return fullimage(val) || " must have unique items"
            }

         # TODO
         enum := x["enum"]
         const := x["const"]
         maxContains := x["maxContains"]
         minContains := x["minContains"]

         }

      "string": {
         # - Validation Keywords for Strings
         #   * maxLength
         #   * minLength
         #   * pattern
         #
         if type(val) ~== "string" then {
            return "expected string type, got: " || val
            }
         else{

            if type(enum := x["enum"]) == "list" then
               if not member(set(enum), val) then
                  return val || " is out of range, allowed values are: " || fullimage(enum)

            if string(const := x["const"]) then
               if const ~== val then
                  return val || " is not equal to the constant: " || const

            if integer(maxLength := x["maxLength"]) then
               if *val > maxLength then
                  return val || " is too big. Must be less than or equal to " || maxLength || " characters."

            if integer(minLength := x["minLength"]) then
               if *val < minLength then
                  return val || " is too small. Must be greater than or equal to " || minLength || " characters."

            # TODO
            pattern := x["pattern"]
            return z
            }
         }

      "integer" | "number" :{
         # - Validation Keywords for Numeric Instances (number and integer)
         #   * multipleOf
         #   * maximum
         #   * exclusiveMaximum
         #   * minimum
         #   * exclusiveMinimum
         #

         if type(val) ~== "integer" & x["type"] == "integer" then {
            return "expected integer type, got: " || val
            }
         else if type(val) ~== "real" & x["type"] == "number" then{
            return "expected a number, got " || val
            }
         else {

            if type(enum := x["enum"]) == "list" then
               if not member(set(enum), val) then
                  return val || " is out of range, allowed values are: " || fullimage(enum)

            if string(const := x["const"]) then
               if const ~= val then
                  return val || " is not equal to the constant: " || const

            if integer(multipleOf := x["multipleOf"]) then
               if val % mulitpleOf ~= 0 then
                  return val || " must be a multiple of: " || multipleOf

            if integer(maximum := x["maximum"]) then
               if val > maximum then
                  return val || " is greater than the maximum: " || maximum

            if integer(exclusiveMaximum := x["exclusiveMaximum"]) then
               if val >= exlusiveMaximum then
                  return val || " is greater than or equal to the exclusiveMaximum: " || exclusiveMaximum

            if integer(minimum := x["minimum"]) then
               if val < minimum then
                 return val || " is less than the minimum: " || minimum

            if integer(exclusiveMinimum := x["exclusiveMinimum"]) then
               if val <= exclusiveMinimum then
                  return val || " is less than the exclusiveMinimum: " || exclusiveMinimum
            }
         return z
         }

      "&null" :{
         return "additional properties? " || x["type"]
         }

      default: return z
      }
end

#<p>
# helper function
# <[param obj name of the object]>
# <[param sch name of  the schema file]>
# <[param schRoot name of the schema file once more]>
# The procedure _jsvalidation recusively goes into the object file and the corresponding level of the Schema file.
# In each level the procedure  gets the value of each propertiy in the object file and calls the  validate_property() procedure.
# with the value and the corresponding schema property.
#
# <[returns "" when valid, or the error string]>
#
#</p>

procedure _jsvalidation(obj, sch, schRoot)
   if type(obj) == "table" then {
      pf := validate_property(sch, obj)
      if pf ~== "" then return pf
      every k := key(obj) do {
         if type(obj[k]) == "table" then{
            pf := validate_property(sch["properties"][k], obj[k])
            if pf ~== "" then return pf
            _jsvalidation(obj[k], sch["properties"][k], schRoot)
            }

         else if type(obj[k]) == "list" then{
            pf := validate_property(sch["properties"][k], obj[k])
            if pf ~== "" then return pf
            inc := 1
            every key(obj[k]) do {
               if type(obj[k][inc]) == "table" then {
                  if key(sch["properties"][k]["items"]) == "$ref" then {
                     refitem  := sch["properties"][k]["items"]["$ref"]
                     refitem ? {
                        if ="#/$defs/" | ="#/definitions/" then
                           {
                              refitem := tab(0)
                              check := _jsvalidation(obj[k][inc], schRoot["$defs"][refitem], schRoot)
                              if check ~== "" then return check
                              inc := inc + 1
                              }
                        }
                     }
                  }
               }
            }
         else{
            pf := validate_property(sch["properties"][k], obj[k])
            if pf ~== "" then return pf
            }
         }
      }
   return ""
end

