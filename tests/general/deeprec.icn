#
# deeprec.icn -- deep recursion and evaluation stack overflow.
#
# The program runs itself with explicit stack sizes, so the results do not
# depend on how much memory the machine has.  First, with ample stacks, it
# recurses to fixed depths: on the evaluation stack alone, through
# suspended builtin generators (each also keeps a C frame live), through
# suspended procedures, and inside a co-expression.
#
# Then, with small stacks, it recurses without bound in each of the ways
# the evaluation stack can grow.  Every one must end in run-time error 301
# rather than a crash.
#
# Last, with large evaluation stacks, it recurses without bound through
# suspended builtin generators, so the C stack can run out first: in &main
# (guarded by the system's guard page) and in a co-expression (whose C
# stack shares its block with its evaluation stack).  This must end in
# run-time error 301 or 308; which one depends on the platform's C stack
# size.
#

procedure plain(n)
   if n = 0 then return 0
   return 1 + plain(n-1)
end

procedure viagen(n)
   local x
   if n = 0 then return 0
   every x := !"a" do return 1 + viagen(n-1)
end

procedure susp(n)
   if n = 0 then suspend 0 else suspend 1 + susp(n-1)
end

procedure expr(n)
   if n = 0 then return 0
   return (1 to 2) + expr(n-1)
end

procedure sink(a[])
   return *a
end

procedure overflow(how)
   case how of {
      "plain":             plain(-1)
      "generator":         viagen(-1)
      "suspend":           every susp(100000)
      "expression":        expr(-1)
      "apply":             sink ! list(1000000)
      "co-expression":     @create plain(-1)
      "co-expr suspend":   @create (every susp(100000))
      "C stack":           viagen(-1)
      "co-expr C stack":   @create viagen(-1)
      }
   write("no overflow")
end

procedure deep()
   write("plain: ", plain(50000))
   write("generator: ", viagen(4000))
   write("suspend: ", susp(20000))
   write("co-expression: ", @create plain(2000))
   write("co-expression, generator: ", @create viagen(300))
end

procedure run(how)
   return open(&progname || " \"" || how || "\" 2>&1", "p") |
      stop("cannot run ", &progname)
end

procedure report(how)
   local p, line, r
   p := run(how)
   while line := read(p) do
      if /r & find("Run-time error" | "no overflow", line) then r := line
   close(p)
   return \r | "no run-time error reported"
end

#
# For runs where either stack may run out first.
#
procedure either(r)
   if r == ("Run-time error 301" | "Run-time error 308") then
      return "Run-time error 301 or 308"
   return r
end

procedure main(args)
   local how
   if *args > 0 then
      return if args[1] == "deep" then deep() else overflow(args[1])

   # sizes are in words.  The co-expression block is shared with its C
   # stack, and interp() keeps a margin free at the boundary.  300
   # suspended-builtin frames have to fit above that margin on a 32-bit
   # machine, where a word is 4 bytes.
   setenv("MSTKSIZE", "2000000")
   setenv("COEXPSIZE", "800000")
   every write(!run("deep"))

   setenv("MSTKSIZE", "40000")
   setenv("COEXPSIZE", "40000")
   every how := "plain" | "generator" | "suspend" | "expression" | "apply" |
                "co-expression" | "co-expr suspend" do
      write(left(how || ":", 17), report(how))

   setenv("MSTKSIZE", "2000000")
   setenv("COEXPSIZE", "2000000")
   every how := "C stack" | "co-expr C stack" do
      write(left(how || ":", 17), either(report(how)))
end
