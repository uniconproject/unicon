#
# runperf.icn -- run the perfbench benchmarks and report medians.
#
#    runperf [-r reps] [-s scale] [-x iconx [-x iconx]] [-o file] [-c file]
#            [name ...]
#
#    -r reps    run each benchmark reps times (default 5) and report the
#               median of each measurement
#    -s scale   multiply the work in every benchmark (default 1.0)
#    -x iconx   run perfbench with this interpreter instead of the one it
#               was built for.  Given twice, both interpreters run in turn
#               on every repetition, which keeps a busy machine from
#               favoring one of them, and the two are compared.
#    -o file    also save the results to file (of the last interpreter)
#    -c file    compare with results saved earlier by -o
#
# Changes are percentages of the first result.  For times, negative is
# faster; for speedups (unit x), positive is better.
#
# With no names, every benchmark runs.  perfbench must be in the current
# directory.
#

procedure main(args)
   local reps, scale, outfile, basefile, names, results, order, f, a,
      interps, nm

   reps := 5
   scale := "1.0"
   names := []
   interps := []
   while a := get(args) do
      case a of {
         "-r": reps := integer(get(args)) | stop("runperf: -r needs a number")
         "-s": scale := get(args) | stop("runperf: -s needs a number")
         "-x": put(interps, get(args)) | stop("runperf: -x needs a file")
         "-o": outfile := get(args) | stop("runperf: -o needs a file")
         "-c": basefile := get(args) | stop("runperf: -c needs a file")
         default: put(names, a)
         }
   if *interps = 0 then put(interps, "")
   if *interps > 2 then stop("runperf: at most two -x")
   if *names = 0 then names := benchmark_names(interps[1])

   # results[i] holds the medians for interpreter i
   results := []
   every 1 to *interps do put(results, table())
   order := []
   every runone(!names, reps, scale, interps, results, order)

   if \outfile then {
      f := open(outfile, "w") | stop("runperf: cannot write ", outfile)
      every nm := !order do
         write(f, nm, " ", results[-1][nm][1], " ", results[-1][nm][2])
      close(f)
      }

   if \basefile then show(order, load_results(basefile), results[-1])
   else if *results = 2 then show(order, results[1], results[2])
   else show(order, &null, results[1])
end

procedure command(interp, args)
   return (if *interp > 0 then interp || " " else "") || "./perfbench " || args
end

procedure benchmark_names(interp)
   local p, L
   L := []
   p := open(command(interp, "list"), "p") |
      stop("runperf: cannot run ./perfbench")
   while put(L, read(p))
   close(p)
   return L
end

# Run one benchmark reps times with each interpreter in turn; record the
# median of every measurement it reports.
procedure runone(name, reps, scale, interps, results, order)
   local samples, units, p, line, nm, val, unit, i, k
   samples := []
   every 1 to *interps do put(samples, table())
   units := table()
   every 1 to reps do
      every i := 1 to *interps do {
         p := open(command(interps[i], name || " " || scale), "p") |
            stop("runperf: cannot run ./perfbench")
         while line := read(p) do
            line ? {
               nm := tab(upto(' ')) & move(1) &
               val := numeric(tab(upto(' '))) & move(1) &
               unit := tab(0)
               } & {
               /samples[i][nm] := []
               put(samples[i][nm], val)
               units[nm] := unit
               if not (nm == !order) then put(order, nm)
               }
         close(p)
         }
   every i := 1 to *interps do
      every k := key(samples[i]) do
         results[i][k] := [median(samples[i][k]), units[k]]
end

procedure median(L)
   L := sort(L)
   return L[(*L + 1) / 2]
end

procedure load_results(fname)
   local f, t, line, nm, val, unit
   t := table()
   f := open(fname) | stop("runperf: cannot read ", fname)
   while line := read(f) do
      line ? {
         nm := tab(upto(' ')) & move(1) &
         val := numeric(tab(upto(' '))) & move(1) &
         unit := tab(0)
         } & t[nm] := [val, unit]
   close(f)
   return t
end

procedure show(order, base, results)
   local nm, r, b
   if /base then {
      write(left("benchmark", 24), right("result", 10))
      every nm := !order do {
         r := \results[nm] | next
         write(left(nm, 24), right(fmt(r[1]), 10), " ", r[2])
         }
      }
   else {
      write(left("benchmark", 24), right("before", 10), right("after", 10),
            right("change", 10))
      every nm := !order do {
         r := \results[nm] | next
         b := base[nm]
         writes(left(nm, 24), right(fmt((\b)[1]) | "-", 10),
                right(fmt(r[1]), 10))
         if \b & b[1] ~= 0 then
            write(right(change(b[1], r[1]), 10), " ", r[2])
         else
            write("           ", r[2])
         }
      }
end

procedure change(before, after)
   local pct
   pct := (after - before) * 100.0 / before
   return (if pct >= 0 then "+" else "") || fmt(pct) || "%"
end

procedure fmt(x)
   local n
   if integer(x) = x then return string(integer(x))
   n := integer(abs(x) * 100 + 0.5)
   return (if x < 0 then "-" else "") || n / 100 || "." || right(n % 100, 2, "0")
end
