# prog.icn: plain procedural code
link strings

record point(x, y)

global counter

# Add two points together.
procedure addp(a, b)
   return point(a.x + b.x, a.y + b.y)
end

procedure main(args)
   local p, q, s
   p := point(1, 2)
   q := addp(p, point(3, 4))
   s := repl("ab", 3)
   counter +:= 1
   write(q.x, " ", q.y, " ", s)
   every i := 1 to *args do
      write(args[i])
   undeclared := 5
end
